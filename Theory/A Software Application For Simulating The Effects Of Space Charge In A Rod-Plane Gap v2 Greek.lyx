),
 η γεωμετρία μπορεί εναλλακτικά να περιγραφεί με τις πολικές γωνίες μετασχηματισμού 
\begin_inset Formula $\theta_{3}$
\end_inset

 και 
\begin_inset Formula $\theta_{4}$
\end_inset

:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{cases}
r_{4}=\sqrt{\left[z+R-r_{3}cos(\theta_{3})\right]^{2}+\left[r_{3}sin(\theta_{3})\right]^{2}}\\
\vec{E}_{I_{rod}}=-\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{Rr^{2}\rho(r)sin(\theta)cos(\theta_{4})}{r^{2}_{4}r_{2}}drd\theta\hat{z}
\end{cases}
\end{equation}

\end_inset


\end_layout

