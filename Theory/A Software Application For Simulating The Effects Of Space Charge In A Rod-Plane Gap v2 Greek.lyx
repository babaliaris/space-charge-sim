	filename assets/v2/greek/cms_tip_construction.pdf
	width 95col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Μέθοδος Προσομοίωσης Φορτίων κοντά στην απόληξη της ακίδας (σχεδιασμένη για 
\begin_inset Formula $N_{t}=6$
\end_inset

):
 σημειακά φορτία 
\begin_inset Formula $q_{i}$
\end_inset

 της απόληξης και γραμμικά φορτία 
\begin_inset Formula $\lambda_{j}$
\end_inset

 του κορμού πάνω στον άξονα,
 σημεία ελέγχου στην επιφάνεια της ακίδας και η κατασκευή ενός φορτίου της απόληξης από τη γωνία του 
\begin_inset Formula $\theta_{i}$
\end_inset

.
\begin_inset CommandInset label
LatexCommand label
name "fig:csm_tip"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Subsubsection
Βήμα 1:
 Τα Φορτία Προσομοίωσης (Άγνωστοι)
\end_layout

\begin_layout Standard
Όλα τα φορτία προσομοίωσης βρίσκονται πάνω στον άξονα συμμετρίας,
 μέσα στην ακίδα:
\end_layout

\begin_layout Itemize

\series bold
Σημειακά φορτία της απόληξης.

\series default
 
\begin_inset Formula $N_{t}$
\end_inset

 σημειακά φορτία 
\begin_inset Formula $q_{i}$
\end_inset

,
 
\begin_inset Formula $i=1,\dots,N_{t}$
\end_inset

,
 μέσα στο ημισφαίριο,
 στις θέσεις
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
z_{i}=-R+\frac{R}{2}\cos(\theta_{i})\;\left[\mathrm{m}\right],\qquad\theta_{i}=\left(i-\frac{1}{2}\right)\frac{\pi}{2N_{t}}\;\left[\mathrm{rad}\right],\label{eq:csm_tip_charges}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
όπου η γωνία 
\begin_inset Formula $\theta_{i}$
\end_inset

 μετριέται από τον άξονα,
 στο κέντρο του ημισφαιρίου (
\begin_inset Formula $\theta=0$
\end_inset

 στην κορυφή,
 
\begin_inset Formula $\theta=\pi/2$
\end_inset

 εκεί όπου το ημισφαίριο συναντά τον κυλινδρικό κορμό).
 Κάθε φορτίο βρίσκεται στη μέση της απόστασης μεταξύ του κέντρου του ημισφαιρίου και του ύψους του αντίστοιχου σημείου ελέγχου (Βήμα 3).
\end_layout

\begin_layout Itemize

\series bold
Γραμμικά φορτία του κορμού.

\series default
 
\begin_inset Formula $N_{s}$
\end_inset

 ομοιόμορφα φορτισμένα ευθύγραμμα τμήματα με γραμμικές πυκνότητες 
\begin_inset Formula $\lambda_{j}$
\end_inset

,
 
\begin_inset Formula $j=1,\dots,N_{s}$
\end_inset

,
 κατά μήκος του άξονα του κορμού,
 που ξεκινούν από το κέντρο του ημισφαιρίου και εκτείνονται μακριά από την πλάκα.
 Το τμήμα 
\begin_inset Formula $j$
\end_inset

 καλύπτει το διάστημα 
\begin_inset Formula $a_{j}\le z\le b_{j}$
\end_inset

 και έχει μήκος 
\begin_inset Formula $\ell_{j}=b_{j}-a_{j}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
b_{1}=-R,\qquad b_{j+1}=a_{j}=b_{j}-\ell_{j},\qquad\ell_{1}=\frac{\pi R}{N_{t}},\qquad\ell_{j+1}=g\,\ell_{j}\;\left[\mathrm{m}\right].\label{eq:csm_segments}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τα τμήματα μεγαλώνουν κατά τον παράγοντα 
\begin_inset Formula $g>1$
\end_inset

,
 ώστε να είναι μικρά κοντά στην απόληξη,
 όπου το πεδίο μεταβάλλεται γρήγορα,
 και μεγάλα μακριά από αυτήν.
 Προστίθενται τμήματα έως ότου το συνολικό τους μήκος φτάσει το μήκος της ακίδας του μοντέλου 
\begin_inset Formula $L_{rod}\gg d$
\end_inset

,
 ώστε το μακρινό άκρο της ακίδας να μην επηρεάζει το πεδίο κοντά στην απόληξη.
\end_layout

\begin_layout Standard
Οι άγνωστοι συγκεντρώνονται σε ένα διάνυσμα 
\begin_inset Formula $N=N_{t}+N_{s}$
\end_inset

 στοιχείων:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathbf{x}=\left[q_{1},\;\dots,\;q_{N_{t}},\;\lambda_{1},\;\dots,\;\lambda_{N_{s}}\right]^{T}\;\left[q_{i}:\mathrm{C},\;\lambda_{j}:\mathrm{C/m}\right].\label{eq:csm_unknowns}
\end{equation}

\end_inset


\end_layout

