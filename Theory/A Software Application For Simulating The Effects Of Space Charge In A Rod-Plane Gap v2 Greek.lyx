Χωρικό Φορτίο και Κέντρο του Αγωγού της Ακίδας (
\begin_inset Formula $\vec{r}_{2}$
\end_inset

)
\end_layout

\begin_layout Standard
Για να κατασκευάσουμε το διάνυσμα θέσης του φορτίου-ειδώλου στη σφαίρα,
 χρειαζόμαστε την απόσταση και τη διεύθυνση της ευθείας που ενώνει τη θέση του απειροστού χωρικού φορτίου 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_pos"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 με το κέντρο της απόληξης της ακίδας (
\begin_inset Formula $\vec{C}=-R\hat{z}$
\end_inset

).
 Σημειώνεται ότι το 
\begin_inset Formula $\vec{C}$
\end_inset

 δηλώνει τη θέση του κέντρου και δεν είναι η σταθερά 
\begin_inset Formula $C$
\end_inset

 της συνάρτησης πυκνότητας 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_density"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
 Αυτό επιτυγχάνεται ως εξής:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r}_{2}= & \vec{P}_{dq_{sp}}-\vec{C}\\
\vec{r}_{2}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+rcos(\theta)\hat{z}-\left(-R\hat{z}\right)\\
\vec{r}_{2}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left[R+rcos(\theta)\right]\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και το μέτρο του (μήκος):
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{2}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+\left[R+rcos(\theta)\right]^{2}}\\
r_{2}= & \sqrt{r^{2}sin^{2}(\theta)\left[\cancelto{1}{cos^{2}(\phi)+sin^{2}(\phi)}\right]+\left[R+rcos(\theta)\right]^{2}}\\
r_{2}= & \sqrt{\left[R+rcos(\theta)\right]^{2}+\left[rsin(\theta)\right]^{2}}
\end{array}\label{eq:r2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και το μοναδιαίο διάνυσμά του:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\hat{r}_{2}=\frac{\vec{r}_{2}}{r_{2}}=\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left[R+rcos(\theta)\right]\hat{z}}{\sqrt{\left[R+rcos(\theta)\right]^{2}+\left[rsin(\theta)\right]^{2}}}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Θέση του Φορτίου-Ειδώλου (
\begin_inset Formula $\vec{P}_{dq'}$
\end_inset

)
\end_layout

\begin_layout Standard
Σύμφωνα με τη μέθοδο των 
\bar under
ειδώλων για απειροστό σημειακό φορτίο παρουσία γειωμένου σφαιρικού αγωγού
\bar default
,
 το φορτίο-είδωλο (
\begin_inset Formula $dq'$
\end_inset

) βρίσκεται σε απόσταση (
\begin_inset Formula $r_{3}$
\end_inset

) από το κέντρο του αγωγού:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{3}=\frac{R^{2}}{r_{2}}\label{eq:r3}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard

\bar under
όπου
\bar default
:
\end_layout

\begin_layout Itemize
\begin_inset Formula $R$
\end_inset

:
 Η ακτίνα του σφαιρικού αγωγού.
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{2}$
\end_inset

:
 Η απόσταση μεταξύ του απειροστού σημειακού φορτίου και του κέντρου του σφαιρικού αγωγού.
\end_layout

\begin_layout Standard
Για πλήρη συμφωνία με το αναλυτικό πλαίσιο της δημοσίευσης 
\series bold
\begin_inset CommandInset citation
LatexCommand cite
key "wang1988"
literal "false"

\end_inset


\series default
,
 είναι απαραίτητο να οριστεί η τοπική πολική γωνία (
\begin_inset Formula $\theta_{3}$
\end_inset

).
 Η γωνία αυτή περιγράφει τον προσανατολισμό του διανύσματος 
\begin_inset Formula $\vec{r}_{2}$
\end_inset

 ως προς τον κεντρικό άξονα συμμετρίας z.
 Αν και οι επιμέρους καρτεσιανές συντεταγμένες εξαρτώνται ρητά από την αζιμουθιακή γωνία μέσω των 
\begin_inset Formula $\cos(\phi)$
\end_inset

 ή 
\begin_inset Formula $\sin(\phi)$
\end_inset

,
 λόγω της αξονικής συμμετρίας του διακένου ακίδας-πλάκας η τοπική πολική γωνία εξαρτάται μόνο από την απόσταση από τον άξονα.
 Υπολογίζοντας το μέτρο της προβολής στο οριζόντιο επίπεδο 
\begin_inset Formula $x\text{-}y$
\end_inset

,
 η αζιμουθιακή παράμετρος 
\begin_inset Formula $\phi$
\end_inset

 απαλείφεται μέσω της τριγωνομετρικής ταυτότητας 
\begin_inset Formula $\cos^{2}(\phi)+\sin^{2}(\phi)=1$
\end_inset

:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
sin(\theta_{3})= & \frac{\left\Vert \left(\vec{r}_{2}\cdot\hat{x}\right)\hat{x}+\left(\vec{r}_{2}\cdot\hat{y}\right)\hat{y}\right\Vert }{r_{2}}=\frac{\sqrt{\left[rsin(\theta)cos(\phi)\right]^{2}+\left[rsin(\theta)sin(\phi)\right]^{2}}}{r_{2}}=\frac{\sqrt{r^{2}sin^{2}(\theta)\left[\cancelto{1}{cos^{2}(\phi)+sin^{2}(\phi)}\right]}}{r_{2}}\\
sin(\theta_{3})= & \frac{rsin(\theta)}{r_{2}}\Rightarrow rsin(\theta)=r_{2}sin(\theta_{3})\\
\theta_{3}= & sin^{-1}\left(\frac{rsin(\theta)}{r_{2}}\right)
\end{array}\label{eq:rod_image_sin_of_theta_3}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
ενώ:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
cos(\theta_{3})=\frac{\vec{r}_{2}\cdot\hat{z}}{r_{2}}=\frac{R+rcos(\theta)}{r_{2}}\label{eq:rod_image_cos_of_theta_3}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Το διάνυσμα θέσης που περιγράφει την ακριβή θέση του απειροστού φορτίου-ειδώλου κατασκευάζεται ως εξής:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{P}_{dq'}= & \vec{C}+r_{3}\hat{r}_{2}=-R\hat{z}+r_{3}\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left[R+rcos(\theta)\right]\hat{z}}{r_{2}}\\
\vec{P}_{dq'}= & \frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\hat{x}+\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\hat{y}+\left\{ \frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R\right\} \hat{z}
\end{array}\label{eq:rod_image_position}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Διάνυσμα Μετατόπισης από το Φορτίο-Είδωλο στο Σημείο Παρατήρησης (
\begin_inset Formula $\vec{r}_{4}$
\end_inset

)
\end_layout

\begin_layout Standard
Τέλος,
 το 
\bar under
διάνυσμα μετατόπισης από το φορτίο-είδωλο στο σημείο παρατήρησης
\bar default
 υπολογίζεται ως:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r}_{4}= & \vec{P}_{obs}-\vec{P}_{dq'}\\
\vec{r}_{4}= & z\hat{z}-\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\hat{x}-\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\hat{y}-\left\{ \frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R\right\} \hat{z}\\
\vec{r}_{4}= & -\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\hat{x}-\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\hat{y}-\left\{ \frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right\} \hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και η γωνία προσανατολισμού του διανύσματος 
\begin_inset Formula $\vec{r}_{4}$
\end_inset

 ως προς τον κεντρικό άξονα συμμετρίας z:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
sin(\theta_{4})= & \frac{\left\Vert \left(\vec{r}_{4}\cdot\hat{x}\right)\hat{x}+\left(\vec{r}_{4}\cdot\hat{y}\right)\hat{y}\right\Vert }{r_{4}}=\frac{\sqrt{\left[\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\right]^{2}+\left[\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\right]^{2}}}{r_{4}}\\
sin(\theta_{4})= & \frac{\sqrt{\left(\frac{r_{3}}{r_{2}}\right)^{2}r^{2}sin^{2}(\theta)\left[\cancelto{1}{cos^{2}(\phi)+sin^{2}(\phi)}\right]}}{r_{4}}=\frac{\frac{r_{3}}{r_{2}}rsin(\theta)}{r_{4}}=\frac{r_{3}\cdot\cancelto{sin(\theta_{3})}{\frac{rsin(\theta)}{r_{2}}}}{r_{4}}\\
\theta_{4}= & sin^{-1}\left(\frac{r_{3}sin(\theta_{3})}{r_{4}}\right)
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Η προβολή του 
\begin_inset Formula $\vec{r}_{4}$
\end_inset

 στον άξονα συμμετρίας δίνει:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
cos(\theta_{4})= & \frac{\vec{r}_{4}\cdot\hat{z}}{r_{4}}\\
cos(\theta_{4})= & \frac{z+R-\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]}{r_{4}}=\frac{z+R-r_{3}\cancelto{cos(\theta_{3})}{\frac{\left[R+rcos(\theta)\right]}{r_{2}}}}{r_{4}}\\
cos(\theta_{4})= & \frac{z+R-r_{3}cos(\theta_{3})}{r_{4}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και το μέτρο του (μήκος):
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{4}= & \sqrt{\left[\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\right]^{2}+\left[\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\right]^{2}+\left(\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right)^{2}}\\
r_{4}= & \sqrt{\left(\frac{r_{3}}{r_{2}}rsin(\theta)\right)^{2}\left[\cancelto{1}{cos^{2}(\phi)+sin^{2}(\phi)}\right]+\left(\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right)^{2}}\\
r_{4}= & \sqrt{\left(\frac{r_{3}}{r_{2}}rsin(\theta)\right)^{2}+\left(\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right)^{2}}
\end{array}\label{eq:rod_image_r4}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και επειδή 
\begin_inset Formula $rsin(\theta)=r_{2}sin(\theta_{3})$
\end_inset

 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:rod_image_sin_of_theta_3"
plural "false"
caps "false"
noprefix "false"
nolink "false"
