caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 για ένα νέφος,
 που δημιουργείται τη στιγμή 
\begin_inset Formula $t_{inc}$
\end_inset
 και ολισθαίνει ως στερεό σώμα κατά 
\begin_inset Formula $z_{d}(t)$
\end_inset
 (συντομογραφία του 
\begin_inset Formula $z_{\text{drift}}(t)$
\end_inset
)
 υπό την κρουστική τάση 
\begin_inset Formula $V(t)$
\end_inset
.
 Το Κεφάλαιο 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 το επεκτείνει σε πολλά νέφη.
\end_layout

\begin_layout Subsubsection*
Συνιστώσες του Πεδίου στη Θέση z και τη Χρονική Στιγμή t
\end_layout

\begin_layout Standard

\series bold
Εφαρμοζόμενο πεδίο.

\series default
 Γραμμικό ως προς την τάση,
 όπου 
\begin_inset Formula $e_{ex}(z)$
\end_inset

 είναι το εφαρμοζόμενο πεδίο για τάση 
\begin_inset Formula $1\,\text{V}$
\end_inset

 στην ακίδα (Μέθοδος Προσομοίωσης Φορτίων,
 Παράρτημα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:csm"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{ex}(z,t)=V(t)\,e_{ex}(z).\label{eq:fw_applied}\tag{\ref{eq:applied_field_linear}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard

\series bold
Άμεση συνιστώσα του χωρικού φορτίου.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{1}}\left[z-r\cos(\theta)-z_{d}(t)\right]dr\,d\theta,\label{eq:fw_esp}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{1}=\sqrt{\left[z-r\cos(\theta)-z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}}.\label{eq:fw_r1}\tag{\ref{eq:drift_r1}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
όπου:
\end_layout

\begin_layout Itemize
\begin_inset Formula $r\cos(\theta)+z_{d}(t)$
\end_inset

 είναι η αξονική θέση του στοιχείου φορτίου και 
\begin_inset Formula $r\sin(\theta)$
\end_inset

 η απόστασή του από τον άξονα·
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{1}$
\end_inset

 είναι η 
\series bold
απόσταση πεδίου
\series default
 του άμεσου πεδίου:
 από το στοιχείο φορτίου έως το σημείο παρατήρησης.
\end_layout

\begin_layout Standard

\series bold
Συνιστώσα των ειδώλων στην ακίδα.

\series default
 Το είδωλο κάθε στοιχείου φορτίου λαμβάνεται στο ακίνητο ημισφαίριο της απόληξης της ακίδας,
 με κέντρο στη θέση 
\begin_inset Formula $z=-R$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{rod}}(z,t)=-\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}R\sin(\theta)}{r^{3}_{4}\,r_{2}}\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]dr\,d\theta,\label{eq:fw_erod}\tag{\ref{eq:drift_E_rod}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+r\cos(\theta)+z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}},\qquad r_{3}=\frac{R^{2}}{r_{2}},\label{eq:fw_r2_r3}\tag{\ref{eq:drift_r2_r3}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]^{2}+\left[\frac{r_{3}}{r_{2}}r\sin(\theta)\right]^{2}}.\label{eq:fw_r4}\tag{\ref{eq:drift_r4}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
όπου:
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{2}$
\end_inset

 είναι η απόσταση από το 
\series bold
κέντρο της απόληξης της ακίδας
\series default
 (
\begin_inset Formula $z=-R$
\end_inset

) έως το στοιχείο φορτίου·
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{3}$
\end_inset

 είναι η απόσταση από το κέντρο της απόληξης έως το 
\series bold
φορτίο-είδωλο
\series default
,
 που βρίσκεται πάνω στην ίδια ευθεία,
 μέσα στο ημισφαίριο·
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{4}$
\end_inset

 είναι η 
\series bold
απόσταση πεδίου
\series default
 της συνιστώσας των ειδώλων στην ακίδα:
 από το φορτίο-είδωλο έως το σημείο παρατήρησης·
\end_layout

\begin_layout Itemize
\begin_inset Formula $R/r_{2}$
\end_inset

 είναι το μέγεθος του φορτίου-ειδώλου σε σχέση με το στοιχείο φορτίου (φέρει φορτίο 
\begin_inset Formula $-\frac{R}{r_{2}}dq$
\end_inset

).
\end_layout

\begin_layout Standard

\series bold
Συνιστώσα των ειδώλων στην πλάκα.

\series default
 Το είδωλο κάθε στοιχείου φορτίου κατοπτρίζεται ως προς την ακίνητη γειωμένη πλάκα στη θέση 
\begin_inset Formula $z=d$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{plane}}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{5}}\left[2d-r\cos(\theta)-z_{d}(t)-z\right]dr\,d\theta,\label{eq:fw_eplane}\tag{\ref{eq:drift_E_plane}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{5}=\sqrt{\left[r\sin(\theta)\right]^{2}+\left[2d-r\cos(\theta)-z_{d}(t)-z\right]^{2}}.\label{eq:fw_r5}\tag{\ref{eq:drift_r5}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
όπου:
\end_layout

\begin_layout Itemize
\begin_inset Formula $2d-r\cos(\theta)-z_{d}(t)$
\end_inset

 είναι η αξονική θέση του 
\series bold
φορτίου-ειδώλου στην πλάκα
\series default
,
 του κατοπτρικού ειδώλου του στοιχείου φορτίου ως προς την πλάκα (φέρει φορτίο 
\begin_inset Formula $-dq$
\end_inset

)·
\end_layout

\begin_layout Itemize
\begin_inset Formula $r_{5}$
\end_inset

 είναι η 
\series bold
απόσταση πεδίου
\series default
 της συνιστώσας των ειδώλων στην πλάκα:
 από το φορτίο-είδωλο στην πλάκα έως το σημείο παρατήρησης.
\end_layout

\begin_layout Standard

\series bold
Συνολικό πεδίο.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=E_{ex}(z,t)+E_{sp}(z,t)+E_{I_{rod}}(z,t)+E_{I_{plane}}(z,t).\label{eq:fw_total}\tag{\ref{eq:total_field}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Για 
\begin_inset Formula $z_{d}=0$
\end_inset

 προκύπτουν οι στατικές εξισώσεις της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:static_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 ενώ για 
\begin_inset Formula $V(t)=\text{σταθερή}$
\end_inset

 προκύπτει η ολίσθηση υπό σταθερή τάση της Ενότητας 4.
\end_layout

\begin_layout Subsubsection*
Ολίσθηση
\end_layout

\begin_layout Standard
Το σημείο αναφοράς του νέφους είναι το σημείο μηδενισμού του δικού του πεδίου πριν από την ολίσθηση,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z_{c,0},t_{inc})\big|_{z_{d}=0}=0,\qquad z_{c}(t)=z_{c,0}+z_{d}(t),\label{eq:fw_zc}\tag{\ref{eq:zc_def}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και το νέφος κινείται με την ταχύτητα των ιόντων σε αυτό το σημείο,
 υπό την επίδραση όλων των πεδίων εκτός από το δικό του:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d}}{dt}=\mu^{+}\left[E_{ex}(z_{c},t)+E_{I_{rod}}(z_{c},t)+E_{I_{plane}}(z_{c},t)\right],\qquad z_{d}(t_{inc})=0.\label{eq:fw_drift}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Επειδή το δεξί μέλος εξαρτάται από το 
\begin_inset Formula $z_{d}$
\end_inset

 μέσω των πεδίων των ειδώλων και από τον χρόνο 
\begin_inset Formula $t$
\end_inset

 μέσω της 
\begin_inset Formula $V(t)$
\end_inset

,
 η συνήθης διαφορική εξίσωση ολοκληρώνεται αριθμητικά στον χρόνο.
\end_layout


\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Section
Το Μοντέλο Διαδοχικών Παλμών 
\begin_inset CommandInset label
LatexCommand label
name "sec:bursts"

\end_inset

\end_layout

\begin_layout Standard
Μέχρι εδώ το μοντέλο παρακολουθεί ένα νέφος,
 το χωρικό φορτίο του πρώτου νηματίου κορώνα.
 Κατά τη διάρκεια μιας κρουστικής τάσης η ακίδα εκπέμπει διαδοχικά πολλά νημάτια (παλμούς,
 bursts),
 και το χωρικό φορτίο αυξάνεται με κάθε παλμό.
 Το κεφάλαιο αυτό επεκτείνει το μοντέλο σε οποιονδήποτε αριθμό παλμών.
 Το 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:burst_geometry"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 δείχνει τα νέφη τη στιγμή που εμφανίζεται ο τρίτος παλμός:
 δύο νέφη από τους προηγούμενους παλμούς έχουν ήδη ολισθήσει και ένα νέο,
 το τρίτο,
 μόλις σχηματίστηκε στην απόληξη,
 και το 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:burst_timeline"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 δείχνει πώς διαδέχονται οι παλμοί ο ένας τον άλλον στον χρόνο.
\end_layout

\begin_layout Subsection
Δύο Χρονικές Κλίμακες
\end_layout

\begin_layout Standard
Ένα νημάτιο μήκους 
\begin_inset Formula $L_{cs}$
\end_inset

 αναπτύσσεται με την ταχύτητα του νηματίου 
\begin_inset Formula $v_{s}$
\end_inset

,
 στον χρόνο 
\begin_inset Formula $\tau_{s}=L_{cs}/v_{s}$
\end_inset

,
 ενώ τα ιόντα ολισθαίνουν με ταχύτητα 
\begin_inset Formula $v_{d}=\mu^{+}E$
\end_inset

.
 Επειδή 
\begin_inset Formula $v_{s}\gg v_{d}$
\end_inset

,
 τα ιόντα σχεδόν δεν κινούνται όσο αναπτύσσεται ένα νημάτιο:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
v_{d}\,\tau_{s}=\frac{\mu^{+}E}{v_{s}}\,L_{cs}\ll L_{cs}.\label{eq:time_scales}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Γι' αυτό ένας παλμός μοντελοποιείται ως ακαριαίος:
 ο κώνος του εμφανίζεται αμέσως,
 με την κορυφή του στην απόληξη της ακίδας,
 και μόνο στη συνέχεια ολισθαίνει.
 Η πραγματική αύξηση του χωρικού φορτίου,
 ένας κώνος που κρατά την κορυφή του στην απόληξη και μεγαλώνει,
 αναπαρίσταται από μια ακολουθία τέτοιων κώνων.
\end_layout

\begin_layout Subsection
Τα Νέφη
\end_layout

\begin_layout Standard
Ο παλμός 
\begin_inset Formula $k=1,2,\dots$
\end_inset
 συμβαίνει τη χρονική στιγμή 
\begin_inset Formula $t_{k}$
\end_inset
 και αφήνει ένα νέφος με το δικό του μήκος 
\begin_inset Formula $L_{k}$
\end_inset
,
 την κοινή γωνία κώνου 
\begin_inset Formula $\theta_{B}$
\end_inset
 και τις κοινές σταθερές σχήματος 
\begin_inset Formula $B$
\end_inset
, 
\begin_inset Formula $C$
\end_inset
.
 Το φορτίο του προκύπτει από τον νόμο του Gauss στην κεφαλή του κώνου του,
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:gauss_charge"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
,
 μείον το φορτίο των παλαιότερων νεφών που βρίσκεται ακόμη μέσα στον νέο κώνο,
 επειδή η ροή από την κεφαλή μετρά όλο το φορτίο μέσα στον κώνο·
 ο συντελεστής κανονικοποίησής του προκύπτει από το φορτίο όπως στην 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:amplitude_A"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
 Και τα δύο εξαρτώνται από το μήκος του νέου νέφους,
 που δεν είναι ακόμη γνωστό,
 γι' αυτό γράφονται για ένα δοκιμαστικό μήκος 
\begin_inset Formula $L$
\end_inset
:
\end_layout


\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{k}(L)=\pi\epsilon_{0}E_{c}L^{2}\tan^{2}\left(\theta_{B}/2\right)-\sum_{j<k}Q_{j}^{in}(L,t_{k}),\qquad A_{k}(L)=\frac{Q_{k}(L)}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int_{0}^{L}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:burst_cloud}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Επειδή ο νόμος του Gauss συνδέει το φορτίο με το μήκος,
 τα 
\begin_inset Formula $Q_{k}$
\end_inset
 και 
\begin_inset Formula $A_{k}$
\end_inset
 δεν είναι επιπλέον άγνωστοι.
 Το πραγματικό μήκος 
\begin_inset Formula $L_{k}$
\end_inset
 προκύπτει από τη συνθήκη κεφαλής της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:growth"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
·
 τότε 
\begin_inset Formula $Q_{k}=Q_{k}(L_{k})$
\end_inset
 και 
\begin_inset Formula $A_{k}=A_{k}(L_{k})$
\end_inset
.
\end_layout


\begin_layout Standard
Το 
\begin_inset Formula $Q_{j}^{in}(L,t)$
\end_inset
 είναι το φορτίο του παλαιότερου νέφους 
\begin_inset Formula $j$
\end_inset
,
 μετατοπισμένου κατά 
\begin_inset Formula $z_{d,j}(t)$
\end_inset
,
 που βρίσκεται μέσα στο νέο νέφος μήκους 
\begin_inset Formula $L$
\end_inset
.
 Είναι το ολοκλήρωμα όγκου της πυκνότητας,
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:charge_volume"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
,
 εφαρμοσμένο στο παλαιότερο νέφος (με το δικό του 
\begin_inset Formula $A_{j}$
\end_inset
) αλλά με διαφορετικό άνω όριο για το 
\begin_inset Formula $r$
\end_inset
:
\end_layout


\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{j}^{in}(L,t)=2\pi A_{j}\int_{0}^{\theta_{B}/2}\int_{0}^{r_{in}(\theta)}\frac{r^{2}\sin\theta}{(r+C)^{B}}\,dr\,d\theta,\quad r_{in}(\theta)=\min\left[L_{j},\;-z_{d,j}\cos\theta+\sqrt{L^{2}-z_{d,j}^{2}\sin^{2}\theta}\right].\label{eq:burst_enclosed}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/enclosed_charge.pdf
	width 100col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Το φορτίο ενός παλαιότερου νέφους 
\begin_inset Formula $j$
\end_inset
 μέσα στο νέο νέφος 
\begin_inset Formula $k$
\end_inset
 (σχηματικά, όχι υπό κλίμακα).
 Οι δύο κώνοι έχουν κοινό άξονα και κοινή γωνία 
\begin_inset Formula $\theta_{B}$
\end_inset
·
 ο παλαιότερος έχει ολισθήσει κατά 
\begin_inset Formula $z_{d,j}$
\end_inset
.
 Σε κάθε διεύθυνση 
\begin_inset Formula $\theta$
\end_inset
 από την κορυφή του 
\begin_inset Formula $O'$
\end_inset
 η ολοκλήρωση φτάνει έως το 
\begin_inset Formula $r_{in}(\theta)$
\end_inset
:
 (α) έως την κεφαλή του νέου νέφους,
 όπου 
\begin_inset Formula $\left|\overline{OP}\right|=L_{k}$
\end_inset
·
 (β) έως το τέλος του παλαιότερου νέφους, 
\begin_inset Formula $L_{j}$
\end_inset
,
 όταν βρίσκεται ολόκληρο μέσα.
\begin_inset CommandInset label
LatexCommand label
name "fig:enclosed_charge"

\end_inset

\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Το άνω όριο προκύπτει από τη γεωμετρία του 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:enclosed_charge"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
 Οι δύο κώνοι έχουν κοινό άξονα και κοινή γωνία 
\begin_inset Formula $\theta_{B}$
\end_inset
,
 και ο παλαιότερος έχει απλώς μετακινηθεί προς τα εμπρός κατά μήκος του άξονα κατά 
\begin_inset Formula $z_{d,j}$
\end_inset
.
 Από την απόληξη 
\begin_inset Formula $O$
\end_inset
,
 κάθε σημείο του βρίσκεται επομένως μέσα στη γωνία ανοίγματος του νέου κώνου,
 οπότε το γωνιακό όριο μένει 
\begin_inset Formula $\theta_{B}/2$
\end_inset
,
 και ένα σημείο ανήκει στο νέο νέφος όταν η απόστασή του από το 
\begin_inset Formula $O$
\end_inset
 είναι το πολύ 
\begin_inset Formula $L$
\end_inset
.
 Για ένα σημείο 
\begin_inset Formula $P$
\end_inset
 σε απόσταση 
\begin_inset Formula $r$
\end_inset
 από την κορυφή 
\begin_inset Formula $O'$
\end_inset
 του παλαιότερου νέφους,
 στη διεύθυνση 
\begin_inset Formula $\theta$
\end_inset
,
 το τρίγωνο 
\begin_inset Formula $OO'P$
\end_inset
 δίνει,
 από τον νόμο των συνημιτόνων,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\left|\overline{OP}\right|^{2}=z_{d,j}^{2}+r^{2}+2\,z_{d,j}\,r\cos\theta\le L^{2}\quad\Longleftrightarrow\quad r\le-z_{d,j}\cos\theta+\sqrt{L^{2}-z_{d,j}^{2}\sin^{2}\theta}.\label{eq:enclosed_geometry}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Σε κάθε διεύθυνση η ολοκλήρωση εκτείνεται επομένως από την κορυφή του παλαιότερου νέφους έως την κεφαλή του νέου,
 ή έως το τέλος του παλαιότερου νέφους αν αυτό έρχεται πρώτο,
 εξ ου και το ελάχιστο στο 
\begin_inset Formula $r_{in}(\theta)$
\end_inset
.
 Το τμήμα του παλαιότερου νέφους πέρα από την κεφαλή (διακεκομμένο στο 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:enclosed_charge"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
α) βρίσκεται έξω από την επιφάνεια Gauss του νέου νέφους και δεν αφαιρείται·
 ένα παλαιότερο νέφος που βρίσκεται ολόκληρο μέσα (
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:enclosed_charge"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
β) αφαιρείται ολόκληρο, 
\begin_inset Formula $Q_{j}^{in}=Q_{j}$
\end_inset
.
 Όσο λιγότερο έχει ολισθήσει ένα παλαιότερο νέφος (
\begin_inset Formula $z_{d,j}\ll L$
\end_inset
),
 τόσο μεγαλύτερο μέρος του αφαιρείται.
\end_layout


\begin_layout Standard
Για τον πρώτο παλμό το άθροισμα είναι κενό.
 Αν ένα παλαιότερο νέφος έχει βγει από τον νέο κώνο,
 δεν αφαιρείται τίποτα γι' αυτό.
 Κάθε νέφος ολισθαίνει έπειτα ως στερεό σώμα κατά 
\begin_inset Formula $z_{d,k}(t)$
\end_inset
,
 με 
\begin_inset Formula $z_{d,k}(t)=0$
\end_inset
 για 
\begin_inset Formula $t\le t_{k}$
\end_inset
.
 Η συνιστώσα του είναι το άθροισμα των τριών συνιστωσών χωρικού φορτίου της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:drift_image_fields"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
,
 με 
\begin_inset Formula $L_{k}$
\end_inset
, 
\begin_inset Formula $A_{k}$
\end_inset
 και 
\begin_inset Formula $z_{d,k}(t)$
\end_inset
:
\end_layout


\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{k}(z,t)=E_{sp,k}(z,t)+E_{I_{rod},k}(z,t)+E_{I_{plane},k}(z,t).\label{eq:cloud_field}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Το Συνολικό Χωρικό Φορτίο και το Αναδρομικό Συνολικό Πεδίο
\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/burst_geometry.pdf
	width 95col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Το μοντέλο των παλμών τη στιγμή 
\begin_inset Formula $t_{3}$
\end_inset

 του τρίτου παλμού.
 Το νέο νέφος (συνεχής γραμμή) έχει την κορυφή του στην απόληξη της ακίδας και το μήκος 
\begin_inset Formula $L_{3}$
\end_inset

 στο οποίο το πεδίο στην κεφαλή του είναι 
\begin_inset Formula $E_{c}$
\end_inset

.
 Τα νέφη του ιστορικού (διακεκομμένες γραμμές) έχουν ολισθήσει κατά 
\begin_inset Formula $z_{d,1}$
\end_inset

 και 
\begin_inset Formula $z_{d,2}$
\end_inset

· το καθένα κινείται με την ταχύτητα 
\begin_inset Formula $\vec{v}_{k}$
\end_inset

 στο δικό του σημείο 
\begin_inset Formula $z_{c,k}$
\end_inset

.
 Δεξιά:
 το τμήμα ενός νέφους πέρα από την πλάκα απορροφάται,
 οπότε το ακτινικό του όριο γίνεται 
\begin_inset Formula $r_{max}$
\end_inset

.
\begin_inset CommandInset label
LatexCommand label
name "fig:burst_geometry"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Το χωρικό φορτίο στο διάκενο είναι το άθροισμα όλων των νεφών που έχουν δημιουργηθεί μέχρι τη στιγμή 
\begin_inset Formula $t$
\end_inset

,
 το καθένα μετατοπισμένο κατά τη δική του ολίσθηση (
\begin_inset Formula $\rho_{k}(\vec{x})$
\end_inset

 είναι η πυκνότητα του νέφους 
\begin_inset Formula $k$
\end_inset

 με την κορυφή του στην απόληξη της ακίδας):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho(\vec{x},t)=\sum_{k:\,t_{k}\le t}\rho_{k}\left(\vec{x}-z_{d,k}(t)\,\hat{z}\right),\qquad Q(t)=\sum_{k:\,t_{k}\le t}Q_{k}.\label{eq:total_density}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τα πεδία είναι γραμμικά ως προς το φορτίο,
 οπότε το συνολικό πεδίο είναι το εφαρμοζόμενο πεδίο συν τη συνιστώσα κάθε νέφους:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=V(t)\,e_{ex}(z)+\sum_{k:\,t_{k}\le t}E_{k}(z,t).\label{eq:total_field_bursts}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Για τον παλμό 
\begin_inset Formula $k$
\end_inset

,
 τα νέφη των προηγούμενων παλμών αποτελούν το 
\series bold
ιστορικό
\series default
 του:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H_{k}(z,t)=\sum_{j<k}E_{j}(z,t),\qquad H_{1}(z,t)=0,\label{eq:history}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
το οποίο μεγαλώνει κατά ένα νέφος σε κάθε παλμό,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H_{k+1}(z,t)=H_{k}(z,t)+E_{k}(z,t).\label{eq:history_recursion}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Μεταξύ των παλμών 
\begin_inset Formula $k$
\end_inset

 και 
\begin_inset Formula $k+1$
\end_inset

 το συνολικό πεδίο είναι επομένως 
\begin_inset Formula $E_{total}=V(t)\,e_{ex}(z)+H_{k}(z,t)+E_{k}(z,t)=V(t)\,e_{ex}(z)+H_{k+1}(z,t)$
\end_inset

:
 κάθε νέος παλμός υπολογίζεται πάνω στο ολισθαίνον ιστορικό των προηγούμενων.
\end_layout

\begin_layout Subsection
Συνθήκη Παλμού
\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/burst_timeline.pdf
	width 95col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Η αναδρομή στον χρόνο (σχηματικά).
 Το πεδίο στην απόληξη αυξάνεται με την 
\begin_inset Formula $V(t)$
\end_inset

 έως ότου περάσει το κατώφλι 
\begin_inset Formula $E_{0}$
\end_inset
 τη στιγμή 
\begin_inset Formula $t_{k}^{*}$
\end_inset
·
 μετά τη χρονική υστέρηση ο παλμός ακολουθεί τη στιγμή 
\begin_inset Formula $t_{k}$
\end_inset
,
 όταν το πεδίο στην απόληξη φτάσει το πεδίο που απαιτεί ο παλμός 
\begin_inset Formula $k$
\end_inset
,
 
\begin_inset Formula $E_{req,k}=E_{0}+k_{lag}\,\dot{E}_{tip}(t_{k}^{*})^{n}$
\end_inset
 (σχεδιάζεται σε ένα επίπεδο για απλότητα·
 είναι υψηλότερο σε ταχύτερη άνοδο).
 Σε κάθε παλμό ένα νέφος προστίθεται στο ιστορικό και το πεδίο στην απόληξη πέφτει· στη συνέχεια ανακάμπτει,
 επειδή η τάση αυξάνεται και τα νέφη απομακρύνονται.
\begin_inset CommandInset label
LatexCommand label
name "fig:burst_timeline"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Ένα νημάτιο μπορεί να ξεκινήσει μόνο όταν το πεδίο στην απόληξη είναι αρκετά υψηλό,
 αλλά δεν ξεκινά ακριβώς εκείνη τη στιγμή:
 πρέπει πρώτα να εμφανιστεί ένα ελεύθερο ηλεκτρόνιο στην περιοχή υψηλού πεδίου και η χιονοστιβάδα του να εξελιχθεί σε νημάτιο.
 Κατά τη διάρκεια αυτής της 
\series bold
χρονικής υστέρησης
\series default
 η τάση συνεχίζει να αυξάνεται,
 οπότε σε γρήγορο μέτωπο το νημάτιο ξεκινά σε υψηλότερο πεδίο απ' ό,τι σε αργό.
 Ο παλμός 
\begin_inset Formula $k$
\end_inset
 έχει επομένως δύο χρονικές στιγμές:
 το πεδίο στην απόληξη φτάνει πρώτα το κατώφλι 
\begin_inset Formula $E_{0}$
\end_inset
,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{gathered}t_{k}^{*}=\min\left\{ t>t_{k-1}\,:\;E_{tip}(t)=V(t)\,e_{ex}(0)+H_{k}(0,t)=E_{0}\right\} ,\qquad E_{0}=V_{0}\,e_{ex}(0),\label{eq:burst_threshold}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
και ο παλμός ακολουθεί όταν το πεδίο στην απόληξη έχει αυξηθεί περαιτέρω,
 κατά ένα ποσό που αυξάνεται με τον ρυθμό ανόδου του τη στιγμή 
\begin_inset Formula $t_{k}^{*}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
t_{k}=\min\left\{ t>t_{k}^{*}\,:\;E_{tip}(t)=E_{0}+k_{lag}\left(\left.\frac{dE_{tip}}{dt}\right|_{t_{k}^{*}}\right)^{n}\right\} \label{eq:burst_condition}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Εδώ η 
\begin_inset Formula $V_{0}$
\end_inset
 είναι η στατική τάση έναυσης,
 κάτω από την οποία δεν μπορεί να ξεκινήσει νημάτιο,
 και 
\begin_inset Formula $E_{0}=V_{0}\,e_{ex}(0)$
\end_inset
 το αντίστοιχο πεδίο στην απόληξη·
 το 
\begin_inset Formula $k_{lag}$
\end_inset
 καθορίζει το μέγεθος της υπέρτασης και το 
\begin_inset Formula $n$
\end_inset
 πόσο γρήγορα αυξάνεται με τον ρυθμό ανόδου.
 Για τον πρώτο παλμό (
\begin_inset Formula $H_{1}=0$
\end_inset
) ο νόμος γίνεται 
\begin_inset Formula $V_{1}=V_{0}+k\,(dV/dt)^{n}$
\end_inset
,
 με 
\begin_inset Formula $k=k_{lag}\,e_{ex}(0)^{\,n-1}$
\end_inset
.
 Ο νόμος,
 το κριτήριο από το οποίο προκύπτει 
\begin_inset CommandInset citation
LatexCommand cite
key "kind1957,darveniza1988"
literal "false"

\end_inset
 και ο τρόπος με τον οποίο υπολογίζεται ο ρυθμός 
\begin_inset Formula $dE_{tip}/dt$
\end_inset
 κατά την προσομοίωση δίνονται στο Παράρτημα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:fw_time_lag"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
·
 το πώς μετρώνται τα 
\begin_inset Formula $V_{0}$
\end_inset
, 
\begin_inset Formula $k$
\end_inset
 και 
\begin_inset Formula $n$
\end_inset
,
 στο Παράρτημα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:app_inputs"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
\end_layout


\begin_layout Subsection
Ανάπτυξη του Νέου Νέφους
\begin_inset CommandInset label
LatexCommand label
name "sec:growth"

\end_inset
\end_layout

\begin_layout Standard
Κατά τον παλμό τα παλαιότερα νέφη μένουν στη θέση τους,
 στο 
\begin_inset Formula $z_{d,j}(t_{k})$
\end_inset
,
 λόγω της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:time_scales"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
 Το νημάτιο συνεχίζει να αναπτύσσεται όσο το πεδίο στην κεφαλή του είναι πάνω από 
\begin_inset Formula $E_{c}$
\end_inset
.
 Το μήκος του 
\begin_inset Formula $L_{k}$
\end_inset
 είναι το μήκος πέρα από το οποίο το πεδίο της κεφαλής μένει κάτω από 
\begin_inset Formula $E_{c}$
\end_inset
,
 η 
\series bold
μεγαλύτερη
\series default
 ρίζα της συνθήκης κεφαλής:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
L_{k}=\max\left\{ L\,:\;F_{k}(L)=V(t_{k})\,e_{ex}(L)+A_{k}(L)\,g_{k}(L)+H_{k}(L,t_{k})-E_{c}=0\right\},\label{eq:burst_length}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
όπου 
\begin_inset Formula $g_{k}(L)$
\end_inset
 είναι το πεδίο στην κεφαλή του νέου,
 μη ολισθημένου κώνου μήκους 
\begin_inset Formula $L$
\end_inset
 για 
\begin_inset Formula $A=1$
\end_inset
 (το πεδίο είναι ανάλογο του 
\begin_inset Formula $A$
\end_inset
),
 και 
\begin_inset Formula $A_{k}(L)$
\end_inset
 ο συντελεστής κανονικοποίησης της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 για αυτό το μήκος.
 Αφού τα 
\begin_inset Formula $Q_{k}$
\end_inset
 και 
\begin_inset Formula $A_{k}$
\end_inset
 προκύπτουν από το 
\begin_inset Formula $L$
\end_inset
,
 η συνθήκη κεφαλής είναι μία εξίσωση με έναν άγνωστο,
 το 
\begin_inset Formula $L$
\end_inset
.
 Λύνεται ως εξής (
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:length_flow"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
):
\end_layout

\begin_layout Enumerate
Για ένα δοκιμαστικό μήκος 
\begin_inset Formula $L$
\end_inset
,
 υπολογίζεται το 
\begin_inset Formula $Q_{k}(L)$
\end_inset
 από τον νόμο του Gauss μείον το παλαιότερο φορτίο μέσα,
 και από αυτό το 
\begin_inset Formula $A_{k}(L)$
\end_inset
,
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
\end_layout

\begin_layout Enumerate
Υπολογίζεται η συνθήκη κεφαλής 
\begin_inset Formula $F_{k}(L)$
\end_inset
,
 με τη συνιστώσα του νέου νέφους 
\begin_inset Formula $A_{k}(L)\,g_{k}(L)$
\end_inset
 και το ακίνητο ιστορικό 
\begin_inset Formula $H_{k}(L,t_{k})$
\end_inset
.
\end_layout

\begin_layout Enumerate
Το 
\begin_inset Formula $L$
\end_inset
 σαρώνεται από την απόληξη προς τα έξω και η τελευταία αλλαγή προσήμου του 
\begin_inset Formula $F_{k}$
\end_inset
 βελτιώνεται με εύρεση ρίζας:
 αυτό είναι το 
\begin_inset Formula $L_{k}$
\end_inset
.
\end_layout

\begin_layout Enumerate
Με γνωστό το 
\begin_inset Formula $L_{k}$
\end_inset
,
 ορίζονται τα 
\begin_inset Formula $Q_{k}=Q_{k}(L_{k})$
\end_inset
, 
\begin_inset Formula $A_{k}=A_{k}(L_{k})$
\end_inset
 και το σημείο αναφοράς 
\begin_inset Formula $z_{c,k,0}$
\end_inset
 της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_zc"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/length_flow.pdf
	width 80col%

\end_inset


