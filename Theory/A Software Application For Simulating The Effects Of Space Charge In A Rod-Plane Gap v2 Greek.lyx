\begin_layout Standard
Η γειωμένη αγώγιμη πλάκα είναι κάθετη στον άξονα 
\begin_inset Formula $\hat{z}$
\end_inset

 και βρίσκεται στη θέση 
\begin_inset Formula $z=d$
\end_inset

.
 Σύμφωνα με τη μέθοδο των ειδώλων,
 η κατανομή των ειδώλων κατοπτρίζεται μόνο κατά τη διεύθυνση που είναι κάθετη στο όριο,
 ενώ οι εγκάρσιες συντεταγμένες 
\begin_inset Formula $x$
\end_inset

 και 
\begin_inset Formula $y$
\end_inset

 διατηρούνται.
 Ορίζουμε ως 
\begin_inset Formula $h$
\end_inset

 την αξονική απόσταση από το στοιχείο του χωρικού φορτίου (
\begin_inset Formula $\vec{P}_{dq_{sp}}$
\end_inset

) έως τη γειωμένη πλάκα:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h=d-\vec{P}_{dq_{sp}}\cdot\hat{z}=d-rcos(\theta)
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Ο κατοπτρισμός της αξονικής θέσης ως προς την πλάκα δίνει τη θέση του φορτίου-ειδώλου:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{P}_{dq'}= & \vec{P}_{dq_{sp}}+2h\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)+2d-2rcos(\theta)\right)\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)\right)\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
ενώ το φορτίο-είδωλο είναι απλώς το αντίθετο του χωρικού φορτίου:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dq'=-dq_{sp}
\]

\end_inset


\end_layout

\begin_layout Quote
αντικαθιστώντας την κατανομή του χωρικού φορτίου 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dq_sp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
dq'=-\rho(r)r^{2}sin(\theta)drd\theta d\phi
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Διάνυσμα Μετατόπισης από το Φορτίο-Είδωλο στο Σημείο Παρατήρησης (
\begin_inset Formula $\vec{r}_{5}$
\end_inset

)
\end_layout

\begin_layout Standard
Το διάνυσμα μετατόπισης από το φορτίο-είδωλο στο σημείο παρατήρησης υπολογίζεται ως:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r}_{5}= & \vec{P}_{obs}-\vec{P}_{dq'}\\
\vec{r}_{5}= & z\hat{z}-rsin(\theta)cos(\phi)\hat{x}-rsin(\theta)sin(\phi)\hat{y}-\left(2d-rcos(\theta)\right)\hat{z}\\
\vec{r}_{5}= & -\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
ενώ το μέτρο του (μήκος):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+\left(2d-rcos(\theta)-z\right)^{2}}\\
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)\left[cos^{2}(\phi)+sin^{2}(\phi)\right]+\left(2d-rcos(\theta)-z\right)^{2}}\\
r_{5}= & \sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-z\right)^{2}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
και το μοναδιαίο διάνυσμά του:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\hat{r}_{5}= & \frac{\vec{r}_{5}}{r_{5}}\\
\hat{r}_{5}= & -\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}}{\sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-z\right)^{2}}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Τελικός Υπολογισμός του Ηλεκτρικού Πεδίου των Ειδώλων στην Πλάκα (
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{ccc}
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{dq'}{r^{2}_{5}}\hat{r}_{5}\\
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)drd\theta d\phi}{r^{2}_{5}}\left[-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}}{r_{5}}\right]\\
d\vec{E}_{I_{plane}}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \cancelto{0}{\vec{I}_{plane,1}}+\vec{I}_{plane,2}\\
\vec{I}_{plane,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]drd\theta d\phi=0\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta d\phi\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\\
\vec{I}_{plane,2}= & \frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\vec{E}_{I_{plane}}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta
\]

\end_inset


\end_layout

\begin_layout Subsection
Το Εφαρμοζόμενο Πεδίο:
 Μέθοδος Προσομοίωσης Φορτίων
\begin_inset CommandInset label
LatexCommand label
name "sec:csm"

\end_inset


\end_layout

\begin_layout Standard
Το εφαρμοζόμενο (γεωμετρικό) πεδίο 
\begin_inset Formula $\vec{E}_{ext}$
\end_inset

 είναι το πεδίο των φορτισμένων ηλεκτροδίων όταν δεν υπάρχει χωρικό φορτίο.
 Ικανοποιεί την εξίσωση Laplace,
 με την ακίδα σε δυναμικό 
\begin_inset Formula $V$
\end_inset

 και την πλάκα σε μηδενικό δυναμικό.
 Για ακίδα με ημισφαιρική απόληξη δεν υπάρχει λύση σε κλειστή μορφή,
 γι' αυτό το πεδίο υπολογίζεται με τη 
\series bold
Μέθοδο Προσομοίωσης Φορτίων
\series default
 (ΜΠΦ,
 Charge Simulation Method,
 CSM) 
\begin_inset CommandInset citation
LatexCommand cite
key "singer1974,malik1989"
literal "false"

\end_inset

,
 η οποία έχει εφαρμοστεί στην ίδια διάταξη ακίδας με ημισφαιρική απόληξη και πλάκας στο 
\begin_inset CommandInset citation
LatexCommand cite
key "yildirim2003"
literal "false"

\end_inset

.
 Όπως και στην υπόλοιπη εργασία,
 η αρχή των αξόνων βρίσκεται στην κορυφή της ακίδας,
 ο άξονας 
\begin_inset Formula $z$
\end_inset

 έχει φορά προς την πλάκα,
 το κέντρο της ημισφαιρικής απόληξης βρίσκεται στη θέση 
\begin_inset Formula $z=-R$
\end_inset

 και η γειωμένη πλάκα στη θέση 
\begin_inset Formula $z=d$
\end_inset

.
\end_layout

\begin_layout Subsubsection
Η Ιδέα της Μεθόδου
\end_layout

\begin_layout Standard
Το επιφανειακό φορτίο της ακίδας αντικαθίσταται από ένα σύνολο 
\series bold
φορτίων προσομοίωσης (πλασματικών φορτίων) τοποθετημένων μέσα στην ακίδα
\series default
,
 όπου δεν μπορούν να διαταράξουν το πεδίο στο διάκενο.
 Οι τιμές τους είναι άγνωστες.
 Επιλέγονται έτσι ώστε το δυναμικό που δημιουργούν να ισούται με 
\begin_inset Formula $V$
\end_inset

 σε επιλεγμένα σημεία της επιφάνειας της ακίδας,
 που ονομάζονται 
\series bold
σημεία ελέγχου
\series default
 (contour points):
 σημεία της επιφάνειας του ηλεκτροδίου όπου επιβάλλεται το γνωστό δυναμικό.
 Όταν τα φορτία είναι γνωστά,
 το πεδίο σε οποιοδήποτε σημείο του διακένου είναι το άθροισμα των πεδίων τους,
 που δίνονται σε κλειστή μορφή.
 Η γειωμένη πλάκα λαμβάνεται υπόψη με τη μέθοδο των ειδώλων:
 κάθε φορτίο προσομοίωσης έχει ένα κατοπτρικό φορτίο αντίθετου προσήμου πέρα από την πλάκα,
 ώστε η πλάκα να είναι ισοδυναμική επιφάνεια μηδενικού δυναμικού.
\end_layout

\begin_layout Standard
Η τοποθέτηση των φορτίων προσομοίωσης και των σημείων ελέγχου,
 που περιγράφεται βήμα προς βήμα παρακάτω,
 φαίνεται στο 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:csm_tip"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
\end_layout

