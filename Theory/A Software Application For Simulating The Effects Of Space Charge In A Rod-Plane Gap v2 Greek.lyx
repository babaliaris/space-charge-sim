\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\left[\cancelto{0}{\vec{I}_{sp,1}}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)-z]\hat{z}d\phi drd\theta\right]\\
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\;\;\;\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)-z]\hat{z}drd\theta\\
\vec{E}_{sp}= & -\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)-z]drd\theta\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Σύνοψη
