\begin_inset Formula $C$
\end_inset
 εξαρτώνται από τη διακλάδωση μέσα στη ζώνη των νηματίων και δίνονται από τον χρήστη.
 Το Παράρτημα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:app_inputs"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 περιγράφει πώς προκύπτει κάθε είσοδος στο εργαστήριο.
 Το μοντέλο υπολογίζει όλα τα υπόλοιπα:
 τις στιγμές και τις τάσεις έναυσης κάθε παλμού,
 τα μήκη και τα φορτία των νηματίων,
 την ολίσθηση και τα πεδία.
\end_layout


\begin_layout Subsubsection
Εφαρμοζόμενη Τάση
\end_layout


\begin_layout Standard
Η τάση είναι η διπλή εκθετική συνάρτηση της Ενότητας 4.3,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t)=V_{p}\,k\left(e^{-\alpha t}-e^{-\beta t}\right).\label{eq:fw_voltage}\tag{\ref{eq:impulse_voltage}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
της οποίας οι σταθερές 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 και 
\begin_inset Formula $k$
\end_inset
 προκύπτουν από τα 
\begin_inset Formula $V_{p}$
\end_inset
, 
\begin_inset Formula $T_{cr}$
\end_inset
 και 
\begin_inset Formula $T_{h}$
\end_inset
 (Παράρτημα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:impulse_fit"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
).
\end_layout


\begin_layout Subsubsection
Τα Νέφη 
\begin_inset CommandInset label
LatexCommand label
name "sec:fw_bursts"

\end_inset

\end_layout

\begin_layout Standard
Κάθε παλμός κορώνα 
\begin_inset Formula $k$
\end_inset
 (Κεφάλαιο 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
) προσθέτει ένα νέφος με το δικό του μήκος 
\begin_inset Formula $L_{k}$
\end_inset
,
 φορτίο 
\begin_inset Formula $Q_{k}$
\end_inset
,
 συντελεστή κανονικοποίησης 
\begin_inset Formula $A_{k}$
\end_inset
 και ολίσθηση 
\begin_inset Formula $z_{d,k}(t)$
\end_inset
,
 και τα κοινά 
\begin_inset Formula $\theta_{B}$
\end_inset
, 
\begin_inset Formula $B$
\end_inset
 και 
\begin_inset Formula $C$
\end_inset
.
 Η πυκνότητά του είναι 
\begin_inset Formula $\rho_{k}(r)=A_{k}/(r+C)^{B}$
\end_inset
 στα πεδία ορισμού της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:domains"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 με 
\begin_inset Formula $L_{cs}\to L_{k}$
\end_inset
·
 για δοκιμαστικό μήκος 
\begin_inset Formula $L$
\end_inset
 (Ενότητα 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:growth"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
):
\end_layout


\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{k}(L)=\pi\epsilon_{0}E_{c}L^{2}\tan^{2}\left(\theta_{B}/2\right)-\sum_{j<k}Q_{j}^{in}(L,t_{k}),\qquad A_{k}(L)=\frac{Q_{k}(L)}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int_{0}^{L}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:fw_cloud}\tag{\ref{eq:burst_cloud}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
με 
\begin_inset Formula $Q_{j}^{in}$
\end_inset
 το φορτίο του παλαιότερου νέφους 
\begin_inset Formula $j$
\end_inset
 μέσα στον νέο κώνο,
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_enclosed"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
\end_layout

\begin_layout Subsubsection
Πεδία
\end_layout

\begin_layout Standard
\series bold
Συνιστώσα ενός νέφους.
\series default
 Η συνιστώσα 
\begin_inset Formula $E_{k}=E_{sp,k}+E_{I_{rod},k}+E_{I_{plane},k}$
\end_inset
 του νέφους 
\begin_inset Formula $k$
\end_inset
 δίνεται από τη σύνοψη της ολίσθησης της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:drift_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
,
 με 
\begin_inset Formula $L_{cs}\to r_{max,k}(\theta,t)$
\end_inset
, 
\begin_inset Formula $A\to A_{k}$
\end_inset
 και 
\begin_inset Formula $z_{d}\to z_{d,k}$
\end_inset
,
 όπου το ακτινικό όριο αφήνει έξω το φορτίο που απορρόφησε η πλάκα:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{max,k}(\theta,t)=\min\left[L_{k},\;\frac{d-z_{d,k}(t)}{\cos(\theta)}\right].\label{eq:fw_rmax}\tag{\ref{eq:absorption_limit}}
\end{equation}

\end_inset


\end_layout


\begin_layout Standard

\series bold
Συνολικό πεδίο.

\series default
 Το εφαρμοζόμενο πεδίο συν κάθε νέφος που έχει δημιουργηθεί,
 με το ιστορικό 
\begin_inset Formula $H_{k}$
\end_inset

 των νεφών πριν από τον παλμό 
\begin_inset Formula $k$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=V(t)\,e_{ex}(z)+\sum_{k:\,t_{k}\le t}E_{k}(z,t),\qquad H_{k}(z,t)=\sum_{j<k}E_{j}(z,t).\label{eq:fw_total_bursts}\tag{\ref{eq:total_field_bursts}, \ref{eq:history}}
\end{equation}

\end_inset


