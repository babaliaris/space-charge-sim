\end_layout

\begin_layout Itemize

\series bold
Διάνυσμα Θέσης του Σημείου Παρατήρησης
\series default
 (
\begin_inset Formula $\vec{P}_{obs}$
\end_inset

):
\end_layout

\begin_layout Quote

\bar under
Σημείο Υπολογισμού του Πεδίου
\bar default
:
 Για τον υπολογισμό της έντασης του ηλεκτρικού πεδίου και της κινηματικής του χωρικού φορτίου σε οποιοδήποτε σημείο του χώρου ορίζεται ένα γενικό σημείο παρατήρησης.
 Στο καθολικό καρτεσιανό σύστημα συντεταγμένων,
 το διάνυσμα θέσης του σημείου παρατήρησης δίνεται από τη σχέση:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{obs}=x\hat{x}+y\hat{y}+z\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Λόγω της αξονικής συμμετρίας του κώνου,
 όλες οι εγκάρσιες συνιστώσες του πεδίου (x και y) αλληλοαναιρούνται πλήρως κατά την ολοκλήρωση.
 Επομένως η ανάλυση μπορεί,
 χωρίς απώλεια γενικότητας,
 να περιοριστεί σε σημείο παρατήρησης πάνω στον κεντρικό άξονα z:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{obs}=z\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Το διάνυσμα του 
\bar under
ηλεκτρικού πεδίου του χωρικού φορτίου
\bar default
 (
\begin_inset Formula $\vec{r}_{1}$
\end_inset

) υπολογίζεται ως:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r_{1}}= & \vec{P}_{obs}-\vec{P}_{dq_{sp}}\\
\vec{r}_{1}= & z\hat{z}-rsin(\theta)cos(\phi)\hat{x}-rsin(\theta)sin(\phi)\hat{y}-rcos(\theta)\hat{z}\\
\vec{r}_{1}= & -\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)-z\right)\hat{z}\right]
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
και το μέτρο του (μήκος):
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{1}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+[rcos(\theta)-z]^{2}}\\
r_{1}= & \sqrt{r^{2}sin^{2}(\theta)\cancelto{1}{\left[cos^{2}(\phi)+sin^{2}(\phi)\right]}+[rcos(\theta)-z]^{2}}\\
r_{1}= & \sqrt{\left[rcos(\theta)-z\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
τέλος,
 το μοναδιαίο διάνυσμα της διεύθυνσης του πεδίου είναι:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\hat{r}_{1}=\frac{\vec{r}_{1}}{r_{1}}=-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)-z]\hat{z}}{\sqrt{\left[rcos(\theta)-z\right]{}^{2}+\left[rsin(\theta)\right]^{2}}}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Τελικός Υπολογισμός του Ηλεκτρικού Πεδίου του Χωρικού Φορτίου (
\begin_inset Formula $\vec{E}_{sp}$
\end_inset

)
\end_layout

\begin_layout Standard
Αρχικά εκφράζουμε το απειροστό στοιχείο του χωρικού φορτίου μέσω της πυκνότητας χωρικού φορτίου 
\series bold

\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_density"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset


\series default
 σε σφαιρικές συντεταγμένες:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
dq_{sp}= & \rho(r)dv\\
dq_{sp}= & \rho(r)r^{2}sin(\theta)drd\theta d\phi
\end{array}\label{eq:dq_sp}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Για να είναι ο όγκος ολοκλήρωσης φυσικά συνεπής,
 πρέπει να οριστούν ρητά τα όρια των χωρικών μεταβλητών που περιγράφουν τον κώνο ιονισμού.
 Τα πεδία ορισμού περιορίζονται ως εξής:
\end_layout

\begin_layout Itemize

\series bold
Ακτινική Απόσταση
\series default
 (
\begin_inset Formula $r\in\left[0,L_{cs}\right]$
\end_inset

):
 
\end_layout

\begin_layout Quote
Ορίζει το ενεργό μήκος της ζώνης εκκένωσης κορώνα,
 από την κορυφή του κώνου (
\begin_inset Formula $\vec{O}$
\end_inset

) έως το εξωτερικό όριο του οχετού (
\begin_inset Formula $L_{cs}$
\end_inset

).
\end_layout

\begin_layout Itemize

\series bold
Πολική Γωνία
\series default
 (
\begin_inset Formula $\theta\in[0,\frac{\theta_{B}}{2}]$
\end_inset

):
\end_layout

\begin_layout Quote
Περιορίζεται αυστηρά στο μισό της γωνίας ανοίγματος του κώνου.
 Επειδή η γεωμετρία είναι πλήρως αξονικά συμμετρική,
 η ολοκλήρωση της πολικής γωνίας στο μισό εύρος αποφεύγει τη διπλή μέτρηση των απειροστών στοιχείων όγκου (dv).
\end_layout

\begin_layout Itemize

\series bold
Αζιμουθιακή Γωνία
\series default
 (
\begin_inset Formula $\phi\in[0,2\pi]$
\end_inset

):
\end_layout

\begin_layout Quote
Επιτρέπει μια πλήρη περιστροφή γύρω από τον κεντρικό άξονα z,
 καλύπτοντας ολόκληρη την κυκλική διατομή του κώνου του χωρικού φορτίου.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\text{Πεδία ορισμού:}\begin{cases}
r\in\left[0\;,\;L_{cs}\right]\\
\theta\in\left[0\;,\;\theta_{B}/2\right]\\
\phi\in[0\;,\;2\pi]
\end{cases}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
στη συνέχεια εφαρμόζουμε τον νόμο του Coulomb:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
d\vec{E}_{sp}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{dq_{sp}}{r^{2}_{1}}\hat{r}_{1}\\
\vec{E}_{sp}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)d\phi drd\theta}{r^{2}_{1}}\hat{r}_{1}\\
\vec{E}_{sp}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{2}_{1}}\left(-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)-z]\hat{z}}{r_{1}}\right)d\phi drd\theta\\
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)-z]\hat{z}\right]d\phi drd\theta\\
\\\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Έστω (
\size footnotesize
διαχωρίζοντας την ολοκλήρωση σε δύο όρους
\size default
):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=-\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\left[\vec{I}_{sp,1}+\vec{I}_{sp,2}\right]\label{eq:space_charge_field_i1_i2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{I}_{sp,1}=\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]d\phi drd\theta
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{I}_{sp,2}=\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)-z]\hat{z}d\phi drd\theta\label{eq:space_charge_field_i2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Αποδεικνύουμε ότι 
\begin_inset Formula $\vec{I}_{sp,1}=0$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]d\phi drd\theta\\
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}rsin(\theta)cos(\phi)d\phi drd\theta\hat{x}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}rsin(\theta)sin(\phi)d\phi drd\theta\hat{y}\\
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}\;rsin(\theta)}{r^{3}_{1}}sin(\theta)drd\theta\cancelto{0}{\int^{2\pi}_{0}cos(\phi)d\phi\hat{x}}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}sin(\theta)drd\theta\cancelto{0}{\int^{2\pi}_{0}sin(\phi)}d\phi\hat{y}\\
\vec{I}_{sp,1}= & 0
\end{array}\label{eq:space_charge_field_i1}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τέλος,
 το 
\series bold
Ηλεκτρικό Πεδίο του Χωρικού Φορτίου
\series default
 προκύπτει αντικαθιστώντας τις 
