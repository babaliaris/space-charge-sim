\end_inset

 και 
\begin_inset Formula $L_{cs}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Έναρξη χωρίς νέφη:
 
\begin_inset Formula $k=1$
\end_inset

,
 
\begin_inset Formula $H_{1}=0$
\end_inset

.
\end_layout

\begin_layout Enumerate
Ολοκλήρωση της ολίσθησης 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_drift"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 των υπαρχόντων νεφών στον χρόνο,
 έως ότου ικανοποιηθεί η συνθήκη ριπής 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_condition"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 ένα νέφος φτάσει την πλάκα (
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:absorption_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 αφαιρείται και η ολοκλήρωση συνεχίζεται),
 ή 
\begin_inset Formula $t=t_{end}$
\end_inset

 (τέλος).
\end_layout

\begin_layout Enumerate
Στη ριπή:
 επίλυση της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_length"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 ως προς 
\begin_inset Formula $L_{k}$
\end_inset

,
 υπολογισμός των 
\begin_inset Formula $Q_{k}$
\end_inset

 και 
\begin_inset Formula $A_{k}$
\end_inset

 από την 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 και του 
\begin_inset Formula $z_{c,k,0}$
\end_inset

 από την 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_zc"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 προσθήκη του νέφους στο ιστορικό με την 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:history_recursion"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 
\begin_inset Formula $k\to k+1$
\end_inset

 και επιστροφή στο βήμα 3.
