\begin_layout Plain Layout
Δεδομένα εισόδου του μοντέλου και η προέλευσή τους.
\begin_inset CommandInset label
LatexCommand label
name "tab:fw_inputs"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


