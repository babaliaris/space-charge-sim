nolink "false"
tuple "list"

\end_inset
),
 και το προβλεπόμενο πρώτο νημάτιο είναι μικρότερο (2.0 cm έναντι 2.7 cm της δημοσίευσης).
\end_layout

\begin_layout Standard
Τα 
\begin_inset Formula $B$
\end_inset
 και 
\begin_inset Formula $C$
\end_inset
 περιγράφουν πώς κατανέμεται το φορτίο μέσα στη ζώνη των νηματίων,
 κάτι που εξαρτάται από τη διακλάδωση και τον ιονισμό της,
 φυσική που δεν περιέχει αυτό το μοντέλο.
 Είναι επομένως είσοδοι,
 που δίνονται από τον χρήστη·
 αυτή η εργασία χρησιμοποιεί τις συνήθεις τιμές της δημοσίευσης.
