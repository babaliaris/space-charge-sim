\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Γνωστά και άγνωστα μεγέθη της προσαρμογής της κρουστικής τάσης.
\begin_inset CommandInset label
LatexCommand label
name "tab:impulse_unknowns"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Οι τρεις συνθήκες που ορίζουν την κυματομορφή είναι:
\end_layout

\begin_layout Itemize

\series bold
Θέση της κορυφής:

\series default
 τη στιγμή 
\begin_inset Formula $T_{cr}$
\end_inset

 η κλίση της 
\begin_inset Formula $v(t)$
\end_inset

 είναι μηδέν,
 
\begin_inset Formula $\dot{v}(T_{cr})=0$
\end_inset

·
\end_layout

\begin_layout Itemize

\series bold
Τιμή κορυφής:

\series default
 η τάση εκείνη τη στιγμή ισούται με 
\begin_inset Formula $V_{p}$
\end_inset

,
 
\begin_inset Formula $v(T_{cr})=1$
\end_inset

·
\end_layout

\begin_layout Itemize

\series bold
Ημίσεια τιμή:

\series default
 τη στιγμή 
\begin_inset Formula $T_{h}$
\end_inset

 η τάση είναι 
\begin_inset Formula $V_{p}/2$
\end_inset

,
 
\begin_inset Formula $v(T_{h})=1/2$
\end_inset

,
 με 
\begin_inset Formula $T_{h}>T_{cr}$
\end_inset

 (στην ουρά).
\end_layout

\begin_layout Standard
Για την πρώτη συνθήκη,
 η παράγωγος της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:impulse_normalized"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 διατηρεί τη σταθερά 
\begin_inset Formula $k$
\end_inset

 ως συντελεστή,
 και μηδενίζοντάς την στην κορυφή προκύπτει
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\dot{v}(T_{cr})=k\left(-\alpha\,e^{-\alpha T_{cr}}+\beta\,e^{-\beta T_{cr}}\right)=0\;\Rightarrow\;-\alpha\,e^{-\alpha T_{cr}}+\beta\,e^{-\beta T_{cr}}=0,\label{eq:impulse_crest_condition}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
επειδή 
\begin_inset Formula $k\neq0$
\end_inset

 (διαφορετικά 
\begin_inset Formula $v(t)=0$
\end_inset

 για κάθε 
\begin_inset Formula $t$
\end_inset

) και τα δύο μέλη μπορούν να διαιρεθούν με 
\begin_inset Formula $k$
\end_inset

.
 Φυσικά,
 το 
\begin_inset Formula $k$
\end_inset

 απλώς «τεντώνει» την καμπύλη κατακόρυφα:
 καθορίζει πόσο ψηλά βρίσκεται η κορυφή,
 όχι πότε εμφανίζεται.
 Ο χρόνος της κορυφής εξαρτάται επομένως μόνο από τα 
\begin_inset Formula $\alpha$
\end_inset

 και 
\begin_inset Formula $\beta$
\end_inset

,
 ενώ το 
\begin_inset Formula $k$
\end_inset

 καθορίζεται από τη δεύτερη συνθήκη.
\end_layout

\begin_layout Standard
Σε μορφή εξισώσεων,
 με αγνώστους τα 
\begin_inset Formula $\alpha$
\end_inset

,
 
\begin_inset Formula $\beta$
\end_inset

 και 
\begin_inset Formula $k$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{cases}
-\alpha\,e^{-\alpha T_{cr}}+\beta\,e^{-\beta T_{cr}}=0\\
k\left(e^{-\alpha T_{cr}}-e^{-\beta T_{cr}}\right)=1\\
k\left(e^{-\alpha T_{h}}-e^{-\beta T_{h}}\right)=\dfrac{1}{2}
\end{cases}\label{eq:impulse_system}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Οι άγνωστοι εμφανίζονται μέσα σε εκθετικές συναρτήσεις,
 οπότε το σύστημα είναι μη γραμμικό και δεν έχει λύση σε κλειστή μορφή.
 Σε διανυσματική μορφή,
 με διάνυσμα αγνώστων 
\begin_inset Formula $\mathbf{x}=\left[\alpha,\;\beta,\;k\right]^{T}$
\end_inset

,
 γράφεται
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathbf{F}(\mathbf{x})=\begin{bmatrix}-\alpha\,e^{-\alpha T_{cr}}+\beta\,e^{-\beta T_{cr}}\\
k\left(e^{-\alpha T_{cr}}-e^{-\beta T_{cr}}\right)-1\\
k\left(e^{-\alpha T_{h}}-e^{-\beta T_{h}}\right)-\frac{1}{2}
\end{bmatrix}=\begin{bmatrix}0\\
0\\
0
\end{bmatrix}.\label{eq:impulse_vector}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Το σύστημα λύνεται αριθμητικά σε Python (double_exponential_parameters στο solver/utilities.py).
\end_layout

\begin_layout Subsubsection*
Το Εφαρμοζόμενο Πεδίο κατά την Κρουστική Τάση
\end_layout

\begin_layout Standard
Το εφαρμοζόμενο πεδίο είναι το πεδίο Laplace των ηλεκτροδίων,
 άρα είναι ανάλογο της εφαρμοζόμενης τάσης.
 Αν 
\begin_inset Formula $e_{ex}(z)$
\end_inset

 είναι το εφαρμοζόμενο πεδίο για τάση 
\begin_inset Formula $1\,\text{V}$
\end_inset

 στην ακίδα,
 τότε κάθε χρονική στιγμή
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{ex}(z,t)=V(t)\,e_{ex}(z).\label{eq:applied_field_linear}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Η Μέθοδος Προσομοίωσης Φορτίων λύνεται επομένως μόνο μία φορά,
 για 
\begin_inset Formula $1\,\text{V}$
\end_inset

,
 και το αποτέλεσμα πολλαπλασιάζεται με 
\begin_inset Formula $V(t)$
\end_inset

 σε κάθε χρονικό βήμα.
 Τα πεδία του χωρικού φορτίου δεν εξαρτώνται άμεσα από την τάση:
 μεταβάλλονται μόνο μέσω της ολίσθησης,
 της οποίας η ταχύτητα εξαρτάται από το 
\begin_inset Formula $E_{ex}(z_{c},t)$
\end_inset

.
\end_layout

\begin_layout Subsection
Διαδοχικές Ριπές Κορώνα
\begin_inset CommandInset label
LatexCommand label
name "sec:bursts"

\end_inset


\end_layout

\begin_layout Standard
Μέχρι εδώ το μοντέλο παρακολουθεί ένα νέφος,
 το χωρικό φορτίο του πρώτου οχετού κορώνα.
 Κατά τη διάρκεια μιας κρουστικής τάσης η ακίδα εκπέμπει διαδοχικά πολλούς οχετούς (ριπές,
 bursts),
 και το χωρικό φορτίο αυξάνεται με κάθε ριπή.
 Η ενότητα αυτή επεκτείνει το μοντέλο σε οποιονδήποτε αριθμό ριπών.
 Το 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:burst_geometry"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 δείχνει τα νέφη τη στιγμή μιας ριπής,
 και το 
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:burst_timeline"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 δείχνει πώς διαδέχονται οι ριπές η μία την άλλη στον χρόνο.
\end_layout

\begin_layout Subsubsection*
Δύο Χρονικές Κλίμακες
\end_layout

\begin_layout Standard
Ένας οχετός μήκους 
\begin_inset Formula $L_{cs}$
\end_inset

 αναπτύσσεται με την ταχύτητα του οχετού 
\begin_inset Formula $v_{s}$
\end_inset

,
 στον χρόνο 
\begin_inset Formula $\tau_{s}=L_{cs}/v_{s}$
\end_inset

,
 ενώ τα ιόντα ολισθαίνουν με ταχύτητα 
\begin_inset Formula $v_{d}=\mu^{+}E$
\end_inset

.
 Επειδή 
\begin_inset Formula $v_{s}\gg v_{d}$
\end_inset

,
 τα ιόντα σχεδόν δεν κινούνται όσο αναπτύσσεται ένας οχετός:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
v_{d}\,\tau_{s}=\frac{\mu^{+}E}{v_{s}}\,L_{cs}\ll L_{cs}.\label{eq:time_scales}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Γι' αυτό μια ριπή μοντελοποιείται ως ακαριαία:
 ο κώνος της εμφανίζεται αμέσως,
 με την κορυφή του στην απόληξη της ακίδας,
 και μόνο στη συνέχεια ολισθαίνει.
 Η πραγματική αύξηση του χωρικού φορτίου,
 ένας κώνος που κρατά την κορυφή του στην απόληξη και μεγαλώνει,
 αναπαρίσταται από μια ακολουθία τέτοιων κώνων.
\end_layout

\begin_layout Subsubsection*
Τα Νέφη
\end_layout

\begin_layout Standard
Η ριπή 
\begin_inset Formula $k=1,2,\dots$
\end_inset

 συμβαίνει τη χρονική στιγμή 
\begin_inset Formula $t_{k}$
\end_inset

 και αφήνει ένα νέφος με δικό του μήκος 
\begin_inset Formula $L_{k}$
\end_inset

,
 την κοινή γωνία κώνου 
\begin_inset Formula $\theta_{B}$
\end_inset

,
 και το φορτίο 
\begin_inset Formula $Q_{k}$
\end_inset

 και το πλάτος 
\begin_inset Formula $A_{k}$
\end_inset

 της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:amplitude_A"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho_{k}(r)=\frac{A_{k}}{(r+C)^{B}},\qquad Q_{k}=\pi\epsilon_{0}E_{c}L^{2}_{k}\tan^{2}\left(\theta_{B}/2\right),\qquad A_{k}=\frac{Q_{k}}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int^{L_{k}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:burst_cloud}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Κάθε νέφος ολισθαίνει ως στερεό σώμα κατά 
\begin_inset Formula $z_{d,k}(t)$
\end_inset

,
 με 
\begin_inset Formula $z_{d,k}(t)=0$
\end_inset

 για 
\begin_inset Formula $t\le t_{k}$
\end_inset

.
 Το πεδίο του είναι το άθροισμα των τριών πεδίων χωρικού φορτίου της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:drift_image_fields"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 υπολογισμένων με 
\begin_inset Formula $L_{k}$
\end_inset

,
 
\begin_inset Formula $A_{k}$
\end_inset

 και 
\begin_inset Formula $z_{d,k}(t)$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{k}(z,t)=E_{sp,k}(z,t)+E_{I_{rod},k}(z,t)+E_{I_{plane},k}(z,t).\label{eq:cloud_field}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Το Συνολικό Χωρικό Φορτίο και το Αναδρομικό Συνολικό Πεδίο
\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/burst_geometry.pdf
	width 95col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Το μοντέλο των ριπών τη στιγμή 
\begin_inset Formula $t_{3}$
\end_inset

 της τρίτης ριπής.
 Το νέο νέφος (συνεχής γραμμή) έχει την κορυφή του στην απόληξη της ακίδας και το μήκος 
\begin_inset Formula $L_{3}$
\end_inset

 στο οποίο το πεδίο στην κεφαλή του είναι 
\begin_inset Formula $E_{c}$
\end_inset

.
 Τα νέφη του ιστορικού (διακεκομμένες γραμμές) έχουν ολισθήσει κατά 
\begin_inset Formula $z_{d,1}$
\end_inset

 και 
\begin_inset Formula $z_{d,2}$
\end_inset

· το καθένα κινείται με την ταχύτητα 
\begin_inset Formula $\vec{v}_{k}$
\end_inset

 στο δικό του σημείο 
\begin_inset Formula $z_{c,k}$
\end_inset

.
 Δεξιά:
 το τμήμα ενός νέφους πέρα από την πλάκα απορροφάται,
 οπότε το ακτινικό του όριο γίνεται 
\begin_inset Formula $r_{max}$
\end_inset

.
\begin_inset CommandInset label
LatexCommand label
name "fig:burst_geometry"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Το χωρικό φορτίο στο διάκενο είναι το άθροισμα όλων των νεφών που έχουν δημιουργηθεί μέχρι τη στιγμή 
\begin_inset Formula $t$
\end_inset

,
 το καθένα μετατοπισμένο κατά τη δική του ολίσθηση (
\begin_inset Formula $\rho_{k}(\vec{x})$
\end_inset

 είναι η πυκνότητα του νέφους 
\begin_inset Formula $k$
\end_inset

 με την κορυφή του στην απόληξη της ακίδας):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho(\vec{x},t)=\sum_{k:\,t_{k}\le t}\rho_{k}\left(\vec{x}-z_{d,k}(t)\,\hat{z}\right),\qquad Q(t)=\sum_{k:\,t_{k}\le t}Q_{k}.\label{eq:total_density}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τα πεδία είναι γραμμικά ως προς το φορτίο,
 οπότε το συνολικό πεδίο είναι το εφαρμοζόμενο πεδίο συν το πεδίο κάθε νέφους:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=V(t)\,e_{ex}(z)+\sum_{k:\,t_{k}\le t}E_{k}(z,t).\label{eq:total_field_bursts}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Για τη ριπή 
\begin_inset Formula $k$
\end_inset

,
 τα νέφη των προηγούμενων ριπών αποτελούν το 
\series bold
ιστορικό
\series default
 της:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H_{k}(z,t)=\sum_{j<k}E_{j}(z,t),\qquad H_{1}(z,t)=0,\label{eq:history}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
το οποίο μεγαλώνει κατά ένα νέφος σε κάθε ριπή,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H_{k+1}(z,t)=H_{k}(z,t)+E_{k}(z,t).\label{eq:history_recursion}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Μεταξύ των ριπών 
\begin_inset Formula $k$
\end_inset

 και 
\begin_inset Formula $k+1$
\end_inset

 το συνολικό πεδίο είναι επομένως 
\begin_inset Formula $E_{total}=V(t)\,e_{ex}(z)+H_{k}(z,t)+E_{k}(z,t)=V(t)\,e_{ex}(z)+H_{k+1}(z,t)$
\end_inset

:
 κάθε νέα ριπή υπολογίζεται πάνω στο ολισθαίνον ιστορικό των προηγούμενων.
\end_layout

\begin_layout Subsubsection*
Συνθήκη Ριπής
\end_layout

\begin_layout Standard
\begin_inset Float figure
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\align center
\begin_inset Graphics
	filename assets/v2/greek/burst_timeline.pdf
	width 95col%

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Η αναδρομή στον χρόνο (σχηματικά).
 Το πεδίο στην απόληξη αυξάνεται με την 
\begin_inset Formula $V(t)$
\end_inset

 έως ότου φτάσει την 
\begin_inset Formula $E_{inc}$
\end_inset

.
 Σε κάθε ριπή ένα νέφος προστίθεται στο ιστορικό και το πεδίο στην απόληξη πέφτει· στη συνέχεια ανακάμπτει,
 επειδή η τάση αυξάνεται και τα νέφη απομακρύνονται.
\begin_inset CommandInset label
LatexCommand label
name "fig:burst_timeline"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Η απόληξη της ακίδας και ο αέρας δεν αλλάζουν,
 οπότε κάθε ριπή χρειάζεται το ίδιο πεδίο στην απόληξη με την πρώτη,
 
\begin_inset Formula $E_{inc}=V_{inc}\,e_{ex}(0)$
\end_inset

.
 Η ριπή 
\begin_inset Formula $k$
\end_inset

 συμβαίνει την πρώτη στιγμή μετά την προηγούμενη ριπή κατά την οποία το συνολικό πεδίο στην απόληξη το φτάνει:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
t_{k}=\min\left\{ t>t_{k-1}\,:\;V(t)\,e_{ex}(0)+H_{k}(0,t)=E_{inc}\right\} ,\qquad E_{inc}=V_{inc}\,e_{ex}(0).\label{eq:burst_condition}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Για 
\begin_inset Formula $k=1$
\end_inset

 το ιστορικό είναι μηδέν και η συνθήκη γίνεται 
\begin_inset Formula $V(t_{1})=V_{inc}$
\end_inset

.
\end_layout

\begin_layout Subsubsection*
Ανάπτυξη του Νέου Νέφους
\end_layout

\begin_layout Standard
Κατά τη ριπή τα παλαιότερα νέφη μένουν στη θέση τους,
 στο 
\begin_inset Formula $z_{d,j}(t_{k})$
\end_inset

,
 λόγω της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:time_scales"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
 Ο οχετός συνεχίζει να αναπτύσσεται όσο το πεδίο στην κεφαλή του είναι πάνω από 
\begin_inset Formula $E_{c}$
\end_inset

.
 Το μήκος του 
\begin_inset Formula $L_{k}$
\end_inset

 είναι επομένως το μήκος πέρα από το οποίο το πεδίο στην κεφαλή μένει κάτω από 
\begin_inset Formula $E_{c}$
\end_inset

,
 δηλαδή η 
\series bold
μεγαλύτερη
\series default
 ρίζα της συνθήκης στην κεφαλή:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
L_{k}=\max\left\{ L\,:\;V(t_{k})\,e_{ex}(L)+E_{k}(L,t_{k})+H_{k}(L,t_{k})=E_{c}\right\} ,\label{eq:burst_length}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
όπου 
\begin_inset Formula $E_{k}(L,t_{k})$
\end_inset

 είναι το πεδίο του νέου,
 μη μετατοπισμένου ακόμη νέφους μήκους 
\begin_inset Formula $L$
\end_inset

 στη δική του κεφαλή· το φορτίο και το πλάτος του εξαρτώνται από το 
\begin_inset Formula $L$
\end_inset

 μέσω της 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
 Είναι μία εξίσωση για τον μοναδικό άγνωστο 
\begin_inset Formula $L_{k}$
\end_inset

,
 που λύνεται με εύρεση ρίζας.
\end_layout

\begin_layout Standard
Χρησιμοποιείται η μεγαλύτερη ρίζα,
 και όχι η πρώτη,
 εξαιτίας του ιστορικού.
 Κοντά στην απόληξη η κεφαλή του νέου οχετού περνά από τη μετατοπισμένη κορυφή ενός παλαιότερου νέφους,
 που είναι το πυκνότερο τμήμα του (
\begin_inset Formula $\rho_{j}$
\end_inset

 είναι μέγιστη στο 
\begin_inset Formula $r=0$
\end_inset

).
 Το πεδίο της δημιουργεί μια σύντομη,
 στενή βύθιση στο πεδίο της κεφαλής,
 και θεωρείται ότι ο οχετός τη διασχίζει.
 Η βύθιση είναι απότομη μόνο επειδή το νέφος διατηρεί τη μορφή του κατά την ολίσθηση· ένα πραγματικό νέφος διαχέεται κοντά στην κορυφή του.
\end_layout

\begin_layout Standard
Για την πρώτη ριπή (
\begin_inset Formula $H_{1}=0$
\end_inset

) αυτή είναι η συνθήκη της γωνίας του κώνου της Ενότητας 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:static_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 με αντεστραμμένους ρόλους:
 εκεί το 
\begin_inset Formula $L_{cs}$
\end_inset

 είναι δεδομένο και η 
\begin_inset Formula $\theta_{B}$
\end_inset

 άγνωστη.
 Η γωνία του κώνου επομένως 
\series bold
βαθμονομείται μία φορά
\series default
,
 σε έναν πρώτο οχετό γνωστού μήκους,
 και διατηρείται για κάθε επόμενη ριπή και κάθε κρουστική τάση.
 Κάθε μήκος,
 και το 
\begin_inset Formula $L_{1}$
\end_inset

,
 προκύπτει τότε από την 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_length"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

.
\end_layout

\begin_layout Subsubsection*
Ολίσθηση Πολλών Νεφών
\end_layout

\begin_layout Standard
Κάθε νέφος κινείται με την ταχύτητα των ιόντων στο δικό του σημείο αναφοράς 
\begin_inset Formula $z_{c,k}$
\end_inset

,
 υπό την επίδραση όλων των πεδίων εκτός από το δικό του άμεσο πεδίο:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp,k}(z_{c,k,0},t_{k})=0,\qquad z_{c,k}(t)=z_{c,k,0}+z_{d,k}(t),\label{eq:burst_zc}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d,k}}{dt}=\mu^{+}\Big[V(t)\,e_{ex}(z_{c,k})+E_{I_{rod},k}(z_{c,k},t)+E_{I_{plane},k}(z_{c,k},t)+\sum_{j\neq k}E_{j}(z_{c,k},t)\Big],\qquad z_{d,k}(t_{k})=0.\label{eq:burst_drift}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τα νέφη είναι συζευγμένα:
 το καθένα ωθείται από τα πεδία των άλλων.
 Οι ολισθήσεις αποτελούν επομένως ένα ενιαίο σύστημα συνήθων διαφορικών εξισώσεων,
 που ολοκληρώνεται ταυτόχρονα και αποκτά μία εξίσωση ακόμη σε κάθε ριπή.
 Τα νέφη μπορεί να επικαλύπτονται· σύμφωνα με την 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:total_density"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 οι πυκνότητές τους απλώς προστίθενται.
\end_layout

\begin_layout Subsubsection*
Απορρόφηση από την Πλάκα
\end_layout

\begin_layout Standard
Ένα στοιχειώδες φορτίο του νέφους 
\begin_inset Formula $k$
\end_inset

 βρίσκεται στη θέση 
\begin_inset Formula $r\cos(\theta)+z_{d,k}(t)$
\end_inset

.
 Φτάνει στη γειωμένη πλάκα και εξουδετερώνεται όταν
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r\cos(\theta)+z_{d,k}(t)\ge d.\label{eq:absorption_element}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Τα ολοκληρώματα των πεδίων εκτείνονται τότε μόνο στο φορτίο που βρίσκεται ακόμη στο διάκενο.
 Το άνω ακτινικό όριο γίνεται
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{max,k}(\theta,t)=\min\left[L_{k},\;\frac{d-z_{d,k}(t)}{\cos(\theta)}\right],\label{eq:absorption_limit}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
οπότε το φορτίο του νέφους μειώνεται:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{k}(t)=2\pi\int^{\theta_{B}/2}_{0}\int^{r_{max,k}(\theta,t)}_{0}\rho_{k}(r)\,r^{2}\sin(\theta)\,dr\,d\theta.\label{eq:absorption_charge}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Το νέφος έχει απορροφηθεί πλήρως,
 και αφαιρείται,
 όταν η κορυφή του φτάσει την πλάκα:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
z_{d,k}(t)\ge d.\label{eq:absorption_cloud}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Με μέσο πεδίο περίπου 
\begin_inset Formula $V/d$
\end_inset

 στο διάκενο,
 ο χρόνος που χρειάζεται ένα ιόν για να το διασχίσει είναι της τάξης
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
t_{cross}\approx\frac{d}{\mu^{+}\,V/d}=\frac{d^{2}}{\mu^{+}V}.\label{eq:crossing_time}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Αν ο 
\begin_inset Formula $t_{cross}$
\end_inset

 είναι πολύ μεγαλύτερος από τη διάρκεια της κρουστικής τάσης,
 κανένα νέφος δεν φτάνει την πλάκα όσο εφαρμόζεται η τάση.
\end_layout

\begin_layout Subsubsection*
Τέλος της Προσομοίωσης
\end_layout

\begin_layout Standard
Η προσομοίωση καλύπτει ένα χρονικό παράθυρο 
\begin_inset Formula $0\le t\le t_{end}$
\end_inset

.
 Εδώ οι ριπές αναζητούνται στο μέτωπο της κρουστικής τάσης,
 
\begin_inset Formula $t_{end}=T_{cr}$
\end_inset

:
\end_layout

\begin_layout Itemize
μετά την κορυφή 
\begin_inset Formula $dV/dt<0$
\end_inset

,
 οπότε το εφαρμοζόμενο πεδίο στην απόληξη μειώνεται και μια νέα ριπή μπορεί να προέλθει μόνο από την απομάκρυνση των νεφών·
\end_layout

\begin_layout Itemize
σε μεγάλα διάκενα οι οχετοί του μετώπου οδηγούν στην έναυση οδηγού οχετού (leader),
 την οποία το μοντέλο δεν περιλαμβάνει.
 Το μοντέλο περιγράφει τις ριπές κορώνα πριν από τον οδηγό οχετό.
\end_layout

