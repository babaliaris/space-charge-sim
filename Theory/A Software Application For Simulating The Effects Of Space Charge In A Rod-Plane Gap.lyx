\begin_layout Subsubsection
Image Charge Position (
\family roman
\series medium
\shape up
\size normal
\emph off
\nospellcheck off
\bar no
\strikeout off
\xout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula $\vec{P}_{dq'}$
\end_inset


\family default
\series default
\shape default
\size default
\emph default
\nospellcheck default
\bar default
\strikeout default
\xout default
\uuline default
\uwave default
\noun default
\color inherit
) & Image Charge (
\begin_inset Formula $dq'$
\end_inset

)
\end_layout

\begin_layout Standard
The grounded conducting plane is oriented normal to the 
\begin_inset Formula $\hat{z}$
\end_inset

 axis at 
\begin_inset Formula $z=d$
\end_inset

.
 According to the method of image charges,
 the image distribution reflects solely along the spatial direction normal to the boundary while preserving its transverse 
\begin_inset Formula $x$
\end_inset

 and 
\begin_inset Formula $y$
\end_inset

 coordinates.
 We define 
\begin_inset Formula $h$
\end_inset

 as the axial separation distance from the discrete space charge element (
\begin_inset Formula $\vec{P}_{dq_{sp}}$
\end_inset

) to the grounded plane:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h=d-\vec{P}_{dq_{sp}}\cdot\hat{z}=d-rcos(\theta)-R
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Reflecting the axial position across the boundary plane yields the image charge location:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{P}_{dq'}= & \vec{P}_{dq_{sp}}+2h\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)+R+2d-2rcos(\theta)-2R\right)\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R\right)\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
while the image charge is just the negated space charge:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dq'=-dq_{sp}
\]

\end_inset


\end_layout

\begin_layout Quote
substituting the space charge distribution 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dq_sp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
dq'=-\rho(r)r^{2}sin(\theta)drd\theta d\phi
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsubsection
Image Charge To Observation Displacement Vector (
\begin_inset Formula $\vec{r}_{5}$
\end_inset

)
\end_layout

\begin_layout Standard
The Image Charge To Observation Displacement Vector can be calculated as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r}_{5}= & \vec{P}_{obs}-\vec{P}_{dq'}\\
\vec{r}_{5}= & z\hat{z}-rsin(\theta)cos(\phi)\hat{x}-rsin(\theta)sin(\phi)\hat{y}-\left(2d-rcos(\theta)-R\right)\hat{z}\\
\vec{r}_{5}= & -\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R-z\right)\hat{z}\right]
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
while its magnitude (length):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+\left(2d-rcos(\theta)-R-z\right)^{2}}\\
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)\left[cos^{2}(\phi)+sin^{2}(\phi)\right]+\left(2d-rcos(\theta)-R-z\right)^{2}}\\
r_{5}= & \sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-R-z\right)^{2}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
and its unit direction:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\hat{r}_{5}= & \frac{\vec{r}_{5}}{r_{5}}\\
\hat{r}_{5}= & -\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R-z\right)\hat{z}}{\sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-R-z\right)^{2}}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Final Calculation Of The Plane Image Electric Field (
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{ccc}
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{dq'}{r^{2}_{5}}\hat{r}_{5}\\
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)drd\theta d\phi}{r^{2}_{5}}\left[-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R-z\right)\hat{z}}{r_{5}}\right]\\
d\vec{E}_{I_{plane}}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-R-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \cancelto{0}{\vec{I}_{plane,1}}+\vec{I}_{plane,2}\\
\vec{I}_{plane,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]drd\theta d\phi=0\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-R-z\right)\hat{z}drd\theta d\phi\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-R-z\right)\hat{z}drd\theta\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\\
\vec{I}_{plane,2}= & \frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-R-z\right)\hat{z}drd\theta
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\vec{E}_{I_{plane}}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-R-z\right)\hat{z}drd\theta
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Derivation of Space Charge Amplitude 
\begin_inset Formula $A$
\end_inset


\end_layout

\begin_layout Standard
The axial space charge electric field 
\begin_inset Formula $\vec{E}_{sp}(z)$
\end_inset

 is given by:
 
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}(z)=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}\sin\theta}{r^{3}_{1}}\left[z-R-r\cos\theta\right]dr\,d\theta\,\hat{z}
\end{equation}

\end_inset

where 
\begin_inset Formula $r_{1}=\sqrt{\left[z-R-r\cos\theta\right]^{2}+\left[r\sin\theta\right]^{2}}$
\end_inset

 and 
\begin_inset Formula $\rho(r)=\frac{A}{(r+C)^{B}}$
\end_inset

.
\end_layout

\begin_layout Subsubsection*
Volumetric Integration for 
\begin_inset Formula $Q_{cs}$
\end_inset


\end_layout

\begin_layout Standard
Integrating 
\begin_inset Formula $\rho(r)$
\end_inset

 over the conical volume 
\begin_inset Formula $dV=r^{2}\sin\theta\,dr\,d\theta\,d\phi$
\end_inset

:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=\int\int\int\rho(r)\;dv=\int^{2\pi}_{0}d\phi\int^{\frac{\theta_{B}}{2}}_{0}\sin\theta\,d\theta\int^{L_{cs}}_{0}\frac{A}{(r+C)^{B}}r{}^{2}\,dr
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Evaluating the angular terms:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=A\cdot2\pi\left[1-\cos\left(\frac{\theta_{B}}{2}\right)\right]\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Gauss's Law at Streamer Boundary
\end_layout

\begin_layout Standard
Applying Gauss's Law over a closed surface 
\begin_inset Formula $S$
\end_inset

 enclosing the streamer volume:
 
\begin_inset Formula 
\begin{equation}
\oint_{S}\vec{E}\cdot d\vec{A}=\frac{Q_{cs}}{\epsilon_{0}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Assuming the flux is concentrated across the circular head area 
\begin_inset Formula $S_{\text{head}}$
\end_inset

 at axial distance 
\begin_inset Formula $L_{cs}$
\end_inset

 where the field magnitude is uniform (
\begin_inset Formula $\|\vec{E}\|=E_{c}$
\end_inset

):
 
\begin_inset Formula 
\begin{equation}
\iint_{S_{\text{head}}}E_{c}\,dA=E_{c}A_{\text{head}}=\frac{Q_{cs}}{\epsilon_{0}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
From cone trigonometry,
 the head radius is 
\begin_inset Formula $r_{\text{head}}=L_{cs}\tan\left(\frac{\theta_{B}}{2}\right)$
\end_inset

,
 giving the head area:
 
\begin_inset Formula 
\begin{equation}
A_{\text{head}}=\pi r^{2}_{\text{head}}=\pi\left[L_{cs}\tan\left(\frac{\theta_{B}}{2}\right)\right]^{2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Substituting 
\begin_inset Formula $A_{\text{head}}$
\end_inset

 back into Gauss's Law and isolating 
\begin_inset Formula $Q_{cs}$
\end_inset

:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=\epsilon_{0}E_{c}A_{\text{head}}=\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Equating and Isolating 
\begin_inset Formula $A$
\end_inset


\end_layout

\begin_layout Standard
Equating both expressions for 
\begin_inset Formula $Q_{cs}$
\end_inset

 yields the explicit result:
 
\begin_inset Formula 
\begin{equation}
A(E_{c},B,C,L_{cs},\theta_{B})=\frac{\overbrace{\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)}^{Q_{cs}}}{2\pi\left(1-\cos\left(\frac{\theta_{B}}{2}\right)\right)\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Summarizing
\end_layout

\begin_layout Quote
Space Charge Density Function & Domains:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho(r)=\frac{A}{\left(r+C\right)^{B}}\;\;\left[\frac{C}{m^{3}}\right]\;\;,\;\;\text{Domains:}\begin{cases}
r\in\left[0\;,\;L_{cs}\right]\\
\theta\in\left[0\;,\;\theta_{B}/2\right]\\
\phi\in[0\;,\;2\pi]
\end{cases}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A(\;E_{c}\;,\;B\;,\;C\;,\;L_{cs}\;,\;\theta_{B}\;)=\frac{\overbrace{\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)}^{Q_{cs}}}{2\pi\left[1-\cos\left(\frac{\theta_{B}}{2}\right)\right]\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
B,C are choosen such that 
\begin_inset Formula $E_{total}=E_{ext}+E_{sp}+E_{I_{rod}}+E_{I_{plane}}=\text{constant}$
\end_inset

 (uniform),
 
\begin_inset Formula $E_{c}:$
\end_inset

 Average electric field in the streamer region ( typically ~5.0 [kV/cm] ).
\end_layout

\begin_layout Subsubsection*
Space Charge (
\begin_inset Formula $\vec{E}_{sp}$
\end_inset

)
\end_layout

\begin_layout Quote
Space charge attenuation distance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{1}=\sqrt{\left[z-R-rcos(\theta)\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Space charge electric field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[z-R-rcos(\theta)]drd\theta\hat{z}\label{eq:final_Esp}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Rod Image (
\begin_inset Formula $\vec{E}_{I_{sp}}$
\end_inset

)
\end_layout

\begin_layout Quote
Distance between space charge & rod center.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+rcos(\theta)\right]^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Distance of the rod image charge from its center:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{3}=\frac{R^{2}}{r_{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Rod image charge attenuation distance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left(z-\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]\right)^{2}+\left(\frac{r_{3}}{r_{2}}rsin(\theta)\right)^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Rod image electric field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{rod}}=-\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}Rsin(\theta)}{r^{3}_{4}r_{2}}\left[z-\frac{r_{3}}{r_{2}}\left(R+rcos(\theta)\right)\right]drd\theta\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Plane Image (
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

)
\end_layout

\begin_layout Quote
Plane image charge attenuation distance:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
r_{5}=\sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-R-z\right)^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Plane image electric field:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{plane}}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-R-z\right)drd\theta\hat{z}
\end{equation}

\end_inset


\end_layout

