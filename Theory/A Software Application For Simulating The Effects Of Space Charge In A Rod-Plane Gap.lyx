\begin_layout Subsubsection
Space Charge Electric Field Vector (
\begin_inset Formula $\vec{r}_{1}$
\end_inset

)
\end_layout

\begin_layout Itemize

\series bold
Space Charge Position Vector
\series default
 (
\begin_inset Formula $\vec{P}_{dq_{sp}}$
\end_inset

):
\end_layout

\begin_layout Quote

\bar under
Source Characterization
\bar default
:
 To model the space charge kinematics,
 an infinitesimally differential charge element 
\series bold
dq
\series default
 within the conical ionization envelope is considered.
 Assuming a spherical coordinate framework (r,
 
\begin_inset Formula $\theta$
\end_inset

,
 
\begin_inset Formula $\phi$
\end_inset

) anchored at the apex of the discharge cone (
\begin_inset Formula $\vec{P}_{apex}$
\end_inset

),
 the position vector 
\begin_inset Formula $\vec{P}_{local}$
\end_inset

 mapping the source charge to the 
\series bold
local reference frame
\series default
 withing the conical envelope (It's center is 
\begin_inset Formula $\vec{P}_{apex}$
\end_inset

),
 can be calculated as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{local}=rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+rcos(\theta)\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
The final space charge position vector can be calculated easily (Remember 
\begin_inset Formula $P_{apex}=R\hat{z}$
\end_inset

) as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{dq_{sp}}=\vec{P}_{apex}+\vec{P}_{local}\Rightarrow\vec{P}_{dq_{sp}}=rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)+R\right)\hat{z}\label{eq:p_dq_sp_position}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize

\series bold
Observation Position Vector
\series default
 (
\begin_inset Formula $\vec{P}_{obs}$
\end_inset

):
\end_layout

\begin_layout Quote

\bar under
Field Evaluation Point
\bar default
:
 To evaluate the resulting electric field intensity and space charge kinematics at any arbitrary location in space,
 a generic observation point is defined.
 Expressed natively in the global Cartesian coordinate system,
 the field observation vector is given by:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{obs}=x\hat{x}+y\hat{y}+z\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Due to the axial symmetry of the conical envelope,
 all transverse field components (x and y) cancel out completely upon integration.
 The analysis can therefore be restricted without loss of generality to an observation point on the central z-axis:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{P}_{obs}=z\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Standard
The 
\bar under
space charge electric field
\bar default
 vector (
\begin_inset Formula $\vec{r}_{1}$
\end_inset

) is calculated as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r_{1}}= & \vec{P}_{obs}-\vec{P}_{dq_{sp}}\\
\vec{r}_{1}= & z\hat{z}-rsin(\theta)cos(\phi)\hat{x}-rsin(\theta)sin(\phi)\hat{y}-\left(rcos(\theta)+R\right)\hat{z}\\
\vec{r}_{1}= & -\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)+R-z\right)\hat{z}\right]
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
and its magnitude (length):
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{1}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+[rcos(\theta)+R-z]^{2}}\\
r_{1}= & \sqrt{r^{2}sin^{2}(\theta)\cancelto{1}{\left[cos^{2}(\phi)+sin^{2}(\phi)\right]}+[rcos(\theta)+R-z]^{2}}\\
r_{1}= & \sqrt{\left[rcos(\theta)+R-z\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
finally,
 the unit direction of the field will be:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\hat{r}_{1}=\frac{\vec{r}_{1}}{r_{1}}=-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)+R-z]\hat{z}}{\sqrt{\left[rcos(\theta)+R-z\right]{}^{2}+\left[rsin(\theta)\right]^{2}}}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Final Calculation Of The Space Charge Electric Field (
\begin_inset Formula $\vec{E}_{sp}$
\end_inset

)
\end_layout

\begin_layout Standard
First,
 we express the infinitesimally differential space charge in terms of the space charge density 
\series bold

\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_density"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset


\series default
 using the spherical coordinate system:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
dq_{sp}= & \rho(r)dv\\
dq_{sp}= & \rho(r)r^{2}sin(\theta)drd\theta d\phi
\end{array}\label{eq:dq_sp}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
To ensure a physically consistent integration volume,
 the boundaries of the spatial variables defining the conical ionization envelope must be explicitly established.
 The domains are restricted as follows:
\end_layout

\begin_layout Itemize

\series bold
Radial Distance
\series default
 (
\begin_inset Formula $r\in\left[0,L_{cs}\right]$
\end_inset

):
 
\end_layout

\begin_layout Quote
Defines the active length of the corona discharge zone,
 extending from the cone apex (
\begin_inset Formula $\vec{P}_{apex}$
\end_inset

) to the outer streamer boundary layer (
\begin_inset Formula $L_{cs}$
\end_inset

).
\end_layout

\begin_layout Itemize

\series bold
Polar Angle
\series default
 (
\begin_inset Formula $\theta\in[0,\frac{\theta_{B}}{2}]$
\end_inset

):
\end_layout

\begin_layout Quote
Restricted strictly to the semi-vertical angle of the cone apex.
 Because the volumetric geometry is fully axisymmetric,
 integrating the polar angle over a half-span prevents redundant geometric overlapping and a double-counting of the differential volume elements (dv).
\end_layout

\begin_layout Itemize

\series bold
Azimuthal Angle
\series default
 (
\begin_inset Formula $\phi\in[0,2\pi]$
\end_inset

):
\end_layout

\begin_layout Quote
Allows a complete angular rotation about the central z-axis,
 mapping out the entire circular cross-section of the space charge envelope.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\text{Domains:}\begin{cases}
r\in\left[0\;,\;L_{cs}\right]\\
\theta\in\left[0\;,\;\theta_{B}/2\right]\\
\phi\in[0\;,\;2\pi]
\end{cases}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Standard
then,
 we apply Coulombs law:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
d\vec{E}_{sp}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{dq_{sp}}{r^{2}_{1}}\hat{r}_{1}\\
\vec{E}_{sp}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)d\phi drd\theta}{r^{2}_{1}}\hat{r}_{1}\\
\vec{E}_{sp}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{2}_{1}}\left(-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)+R-z]\hat{z}}{r_{1}}\right)d\phi drd\theta\\
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+[rcos(\theta)+R-z]\hat{z}\right]d\phi drd\theta\\
\\\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Let (
\size footnotesize
breaking down the integration into two terms
\size default
):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=-\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\left[\vec{I}_{sp,1}+\vec{I}_{sp,2}\right]\label{eq:space_charge_field_i1_i2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{I}_{sp,1}=\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]d\phi drd\theta
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{I}_{sp,2}=\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)+R-z]\hat{z}d\phi drd\theta\label{eq:space_charge_field_i2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Showing that 
\begin_inset Formula $\vec{I}_{sp,1}=0$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]d\phi drd\theta\\
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}rsin(\theta)cos(\phi)d\phi drd\theta\hat{x}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)\left(r+R\right)^{2}sin(\theta)}{r^{3}_{1}}rsin(\theta)sin(\phi)d\phi drd\theta\hat{y}\\
\vec{I}_{sp,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\left(r+R\right)^{2}\;rsin(\theta)}{r^{3}_{1}}sin(\theta)drd\theta\cancelto{0}{\int^{2\pi}_{0}cos(\phi)d\phi\hat{x}}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\left(r+R\right)^{2}sin(\theta)}{r^{3}_{1}}sin(\theta)drd\theta\cancelto{0}{\int^{2\pi}_{0}sin(\phi)}d\phi\hat{y}\\
\vec{I}_{sp,1}= & 0
\end{array}\label{eq:space_charge_field_i1}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Finally,
 the 
\series bold
Space Charge Electric Field
\series default
 is given by substituting 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_field_i1"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 & 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_field_i2"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

 to 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:space_charge_field_i1_i2"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\left[\cancelto{0}{\vec{I}_{sp,1}}+\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)+R-z]\hat{z}d\phi drd\theta\right]\\
\vec{E}_{sp}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\;\;\;\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)+R-z]\hat{z}drd\theta\\
\vec{E}_{sp}= & -\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)+R-z]drd\theta\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Summarizing
\end_layout

\begin_layout Standard

\size small
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=-\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[rcos(\theta)+R-z]drd\theta\hat{z}\;\;,\;\;r_{1}=\sqrt{\left[rcos(\theta)+R-z\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\text{OR}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[z-R-rcos(\theta)]drd\theta\hat{z}\;\;,\;\;r_{1}=\sqrt{\left[z-R-rcos(\theta)\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

