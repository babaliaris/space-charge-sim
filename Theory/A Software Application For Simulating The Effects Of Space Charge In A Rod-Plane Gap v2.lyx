\begin_layout Subsubsection
Parameters
\end_layout

\begin_layout Standard
The rod and the charge model are those of Figure 3 (
\begin_inset CommandInset ref
LatexCommand formatted
reference "tab:repro_fig3_params"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
). The cone angle and the inception field are calibrated once, on the first streamer of Figure 3 (
\begin_inset Formula $27.5\,\text{kV}$
\end_inset
, 
\begin_inset Formula $L_{cs}=2.7\,\text{cm}$
\end_inset
, 
\begin_inset Formula $d=80\,\text{cm}$
\end_inset
), which gives 
\begin_inset Formula $\theta_{B}=93.39^{\circ}$
\end_inset
 and 
\begin_inset Formula $E_{inc}=149.4\,\text{kV/cm}$
\end_inset
. The paper gives no crest voltage, so the crest is set to the 
\begin_inset Formula $50\,\%$
\end_inset
 breakdown voltage of the gap from the formula of Gallet et al. 
\begin_inset CommandInset citation
LatexCommand cite
key "gallet1975"
literal "false"

\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V_{p}=U_{50}=\frac{3400}{1+8/d}\;\text{kV}\qquad(d\text{ in m}),\label{eq:repro_gallet}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
which gives 
\begin_inset Formula $V_{p}=161.9\,\text{kV}$
\end_inset
 for 
\begin_inset Formula $d=40\,\text{cm}$
\end_inset
 and 
\begin_inset Formula $V_{p}=309.1\,\text{kV}$
\end_inset
 for 
\begin_inset Formula $d=80\,\text{cm}$
\end_inset
. The formula was fitted to gaps of about 
\begin_inset Formula $1\,\text{m}$
\end_inset
 and longer, so for these gaps it is an extrapolation. The time to crest takes the values 
\begin_inset Formula $15$
\end_inset
, 
\begin_inset Formula $20$
\end_inset
, 
\begin_inset Formula $30$
\end_inset
, 
\begin_inset Formula $50$
\end_inset
, 
\begin_inset Formula $75$
\end_inset
, 
\begin_inset Formula $100$
\end_inset
, 
\begin_inset Formula $150$
\end_inset
, 
\begin_inset Formula $200$
\end_inset
, 
\begin_inset Formula $300$
\end_inset
, 
\begin_inset Formula $400$
\end_inset
, 
\begin_inset Formula $500$
\end_inset
 and 
\begin_inset Formula $600\,\mu\text{s}$
\end_inset
, and each simulation stops at the second burst.
\end_layout

