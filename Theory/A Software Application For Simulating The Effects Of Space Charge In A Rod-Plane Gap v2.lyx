\begin_layout Subsection
The Impulse Voltage 
\begin_inset Formula $V(t)$
\end_inset

\begin_inset CommandInset label
LatexCommand label
name "sec:impulse_voltage"

\end_inset


\end_layout

\begin_layout Standard
When the gap is stressed by a switching impulse, the applied voltage changes with time. The impulse is modelled as a double exponential,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t)=V_{p}\,k\left(e^{-\alpha t}-e^{-\beta t}\right),\label{eq:impulse_voltage}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
but in high-voltage engineering an impulse is described instead by its crest voltage 
\begin_inset Formula $V_{p}$
\end_inset
, its time to crest 
\begin_inset Formula $T_{cr}$
\end_inset
 (the “time of wavefront” of 
\begin_inset CommandInset citation
LatexCommand cite
key "wang1988"
literal "false"

\end_inset

) and its time to half value 
\begin_inset Formula $T_{h}$
\end_inset
, the instant on the tail where the voltage has fallen to 
\begin_inset Formula $V_{p}/2$
\end_inset
. The constants 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 must therefore be found from these three quantities. Dividing by 
\begin_inset Formula $V_{p}$
\end_inset
, the normalized waveform is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
v(t)=\frac{V(t)}{V_{p}}=k\left(e^{-\alpha t}-e^{-\beta t}\right),\qquad0<\alpha<\beta.\label{eq:impulse_normalized}
\end{equation}
\end_inset


\end_layout

