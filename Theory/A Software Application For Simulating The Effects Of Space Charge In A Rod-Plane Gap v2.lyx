\begin_layout Subsection
Figure 5: The Field During a Switching Impulse
\end_layout

\begin_layout Standard
Figure 5 of [1] shows the field near the rod tip at several instants of a 
\begin_inset Formula $320\,\text{kV}$
\end_inset
 switching impulse with a 
\begin_inset Formula $100\,\mu\text{s}$
\end_inset
 front: (a) the applied field alone and (b) the field including the space charge of the first streamer. The impulse is modelled as a double exponential,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t)=V_{p}\,k\left(e^{-\alpha t}-e^{-\beta t}\right),\label{eq:repro_impulse}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 fitted so that the crest is 
\begin_inset Formula $V_{p}=320\,\text{kV}$
\end_inset
 at 
\begin_inset Formula $100\,\mu\text{s}$
\end_inset
. The paper does not give the tail, so the standard switching-impulse value of 
\begin_inset Formula $2500\,\mu\text{s}$
\end_inset
 to half value was assumed. Because the applied field is linear in the voltage, it is computed once for 
\begin_inset Formula $1\,\text{V}$
\end_inset
 and scaled by 
\begin_inset Formula $V(t)$
\end_inset
. The simulation then proceeds as follows:
\end_layout

\begin_layout Enumerate

\begin_inset Formula $V(t)$
\end_inset
 reaches 
\begin_inset Formula $27.5\,\text{kV}$
\end_inset
 at 
\begin_inset Formula $t_{inc}=1.671\,\mu\text{s}$
\end_inset
. Before this instant there is no space charge, so (a) and (b) are identical.
\end_layout

\begin_layout Enumerate
At 
\begin_inset Formula $t_{inc}$
\end_inset
 the space charge of Figure 3 is created (
\begin_inset Formula $\theta_{B}=93.39^{\circ}$
\end_inset
, 
\begin_inset Formula $Q_{cs}=11.41\,\text{nC}$
\end_inset
).
