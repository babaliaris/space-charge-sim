\begin_layout Subsubsection
Applied Voltage
\end_layout


\begin_layout Standard
The voltage is the double exponential of Section 4.3,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t)=V_{p}\,k\left(e^{-\alpha t}-e^{-\beta t}\right).\label{eq:fw_voltage}\tag{\ref{eq:impulse_voltage}}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
whose constants 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 follow from 
\begin_inset Formula $V_{p}$
\end_inset
, 
\begin_inset Formula $T_{cr}$
\end_inset
 and 
\begin_inset Formula $T_{h}$
\end_inset
 (Appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:impulse_fit"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
).
\end_layout


\begin_layout Subsubsection
The Clouds 
\begin_inset CommandInset label
LatexCommand label
name "sec:fw_bursts"

\end_inset

\end_layout

\begin_layout Standard
Every corona burst 
\begin_inset Formula $k$
\end_inset
 (Chapter 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
) adds a cloud with its own length 
\begin_inset Formula $L_{k}$
\end_inset
, charge 
\begin_inset Formula $Q_{k}$
\end_inset
, normalisation constant 
\begin_inset Formula $A_{k}$
\end_inset
 and drift 
\begin_inset Formula $z_{d,k}(t)$
\end_inset
, and the common 
\begin_inset Formula $\theta_{B}$
\end_inset
, 
\begin_inset Formula $B$
\end_inset
 and 
\begin_inset Formula $C$
\end_inset
. Its density is 
\begin_inset Formula $\rho_{k}(r)=A_{k}/(r+C)^{B}$
\end_inset
 on the domains of 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:domains"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 with 
\begin_inset Formula $L_{cs}\to L_{k}$
\end_inset
; for a trial length 
\begin_inset Formula $L$
\end_inset
 (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:growth"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
):
\end_layout


\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{k}(L)=\pi\epsilon_{0}E_{c}L^{2}\tan^{2}\left(\theta_{B}/2\right)-\sum_{j<k}Q_{j}^{in}(L,t_{k}),\qquad A_{k}(L)=\frac{Q_{k}(L)}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int_{0}^{L}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:fw_cloud}\tag{\ref{eq:burst_cloud}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula $Q_{j}^{in}$
\end_inset
 the charge of the older cloud 
\begin_inset Formula $j$
\end_inset
 inside the new cone, 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:burst_enclosed"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
.
\end_layout

\begin_layout Subsubsection
Fields
\end_layout

\begin_layout Standard
\series bold
Field of a cloud.
\series default
 The field 
\begin_inset Formula $E_{k}=E_{sp,k}+E_{I_{rod},k}+E_{I_{plane},k}$
\end_inset
 of cloud 
\begin_inset Formula $k$
\end_inset
 is given by the drift summary of Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:drift_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
, with 
\begin_inset Formula $L_{cs}\to r_{max,k}(\theta,t)$
\end_inset
, 
\begin_inset Formula $A\to A_{k}$
\end_inset
 and 
\begin_inset Formula $z_{d}\to z_{d,k}$
\end_inset
, where the radial limit leaves out the charge absorbed by the plane:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{max,k}(\theta,t)=\min\left[L_{k},\;\frac{d-z_{d,k}(t)}{\cos(\theta)}\right].\label{eq:fw_rmax}\tag{\ref{eq:absorption_limit}}
\end{equation}
\end_inset


\end_layout


\begin_layout Standard

\series bold
Total field.
\series default
 The applied field plus every cloud created so far, with the history 
\begin_inset Formula $H_{k}$
\end_inset
 of the clouds before burst 
\begin_inset Formula $k$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=V(t)\,e_{ex}(z)+\sum_{k:\,t_{k}\le t}E_{k}(z,t),\qquad H_{k}(z,t)=\sum_{j<k}E_{j}(z,t).\label{eq:fw_total_bursts}\tag{\ref{eq:total_field_bursts}, \ref{eq:history}}
\end{equation}
\end_inset


\end_layout

\begin_layout Subsubsection
Bursts
\end_layout


\begin_layout Standard
\series bold
Burst instant.
\series default
 The tip field first reaches the threshold, and the burst follows after the time lag (Appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:fw_time_lag"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
) 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_time_lag"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{gathered}t_{k}^{*}=\min\left\{ t>t_{k-1}\,:\;E_{tip}(t)=V(t)\,e_{ex}(0)+H_{k}(0,t)=E_{0}\right\} ,\\ E_{0}=V_{0}\,e_{ex}(0),\\ t_{k}=\min\left\{ t>t_{k}^{*}\,:\;E_{tip}(t)=E_{0}+k_{lag}\left(\left.\frac{dE_{tip}}{dt}\right|_{t_{k}^{*}}\right)^{n}\right\} .\end{gathered}\end{gathered}\label{eq:fw_burst}\tag{\ref{eq:burst_threshold}, \ref{eq:burst_condition}}
\end{equation}
\end_inset


\end_layout


\begin_layout Standard
\series bold
Burst length.
\series default
 The largest root of the head condition, with the older clouds frozen at 
\begin_inset Formula $t_{k}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
L_{k}=\max\left\{ L\,:\;F_{k}(L)=V(t_{k})\,e_{ex}(L)+A_{k}(L)\,g_{k}(L)+H_{k}(L,t_{k})-E_{c}=0\right\}.\label{eq:fw_burst_length}\tag{\ref{eq:burst_length}}
\end{equation}
\end_inset


\end_layout


\begin_layout Subsubsection
Drift and Absorption
\end_layout


\begin_layout Standard

\series bold
Drift.
\series default
 Every cloud is driven by every field except its own direct field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d,k}}{dt}=\mu^{+}\Big[V(t)\,e_{ex}(z_{c,k})+E_{I_{rod},k}(z_{c,k},t)+E_{I_{plane},k}(z_{c,k},t)+\sum_{j\neq k}E_{j}(z_{c,k},t)\Big],\qquad z_{c,k}=z_{c,k,0}+z_{d,k}.\label{eq:fw_burst_drift}\tag{\ref{eq:burst_drift}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Absorption and end.
\series default
 A cloud is removed when 
\begin_inset Formula $z_{d,k}(t)\ge d$
\end_inset
, and the simulation stops at 
\begin_inset Formula $t=t_{end}$
\end_inset
.
\end_layout

\begin_layout Subsubsection
Order of the Calculation
\end_layout

\begin_layout Enumerate
Fit 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 to 
\begin_inset Formula $V_{p}$
\end_inset
, 
\begin_inset Formula $T_{cr}$
\end_inset
 and 
\begin_inset Formula $T_{h}$
\end_inset
, and compute 
\begin_inset Formula $e_{ex}(z)$
\end_inset
 once.
\end_layout

\begin_layout Enumerate
Take the inputs: the shape constants 
\begin_inset Formula $B$
\end_inset
, 
\begin_inset Formula $C$
\end_inset
, the cone angle 
\begin_inset Formula $\theta_{B}$
\end_inset
 and the time-lag law 
\begin_inset Formula $V_{0}$
\end_inset
, 
\begin_inset Formula $k$
\end_inset
, 
\begin_inset Formula $n$
\end_inset
 (Appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:app_inputs"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
), and set 
\begin_inset Formula $E_{0}=V_{0}\,e_{ex}(0)$
\end_inset
.
\end_layout


\begin_layout Enumerate
Start with no clouds. Integrate 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst_drift"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 for the existing clouds until 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 is met, a cloud is absorbed, or 
\begin_inset Formula $t=t_{end}$
\end_inset
.
\end_layout

\begin_layout Enumerate
At a burst, solve 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst_length"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 for 
\begin_inset Formula $L_{k}$
\end_inset
, compute 
\begin_inset Formula $Q_{k}$
\end_inset
 from 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 and 
\begin_inset Formula $z_{c,k,0}$
\end_inset
 from 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_zc"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
, add the cloud and return to step 3.
\end_layout


\begin_layout Enumerate
At every time of interest, evaluate 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_total_bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 along 
\begin_inset Formula $z$
\end_inset
.
\end_layout

