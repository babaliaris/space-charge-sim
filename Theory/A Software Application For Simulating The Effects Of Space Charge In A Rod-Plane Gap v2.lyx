\begin_layout Subsubsection
Image Charge Position (
\family roman
\series medium
\shape up
\size normal
\emph off
\nospellcheck off
\bar no
\strikeout off
\xout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula $\vec{P}_{dq'}$
\end_inset


\family default
\series default
\shape default
\size default
\emph default
\nospellcheck default
\bar default
\strikeout default
\xout default
\uuline default
\uwave default
\noun default
\color inherit
) & Image Charge (
\begin_inset Formula $dq'$
\end_inset

)
\end_layout

\begin_layout Standard
The grounded conducting plane is oriented normal to the 
\begin_inset Formula $\hat{z}$
\end_inset

 axis at 
\begin_inset Formula $z=d$
\end_inset

.
 According to the method of image charges,
 the image distribution reflects solely along the spatial direction normal to the boundary while preserving its transverse 
\begin_inset Formula $x$
\end_inset

 and 
\begin_inset Formula $y$
\end_inset

 coordinates.
 We define 
\begin_inset Formula $h$
\end_inset

 as the axial separation distance from the discrete space charge element (
\begin_inset Formula $\vec{P}_{dq_{sp}}$
\end_inset

) to the grounded plane:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h=d-\vec{P}_{dq_{sp}}\cdot\hat{z}=d-rcos(\theta)
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Reflecting the axial position across the boundary plane yields the image charge location:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{P}_{dq'}= & \vec{P}_{dq_{sp}}+2h\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(rcos(\theta)+2d-2rcos(\theta)\right)\hat{z}\\
\vec{P}_{dq'}= & rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)\right)\hat{z}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
while the image charge is just the negated space charge:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dq'=-dq_{sp}
\]

\end_inset


\end_layout

\begin_layout Quote
substituting the space charge distribution 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dq_sp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
dq'=-\rho(r)r^{2}sin(\theta)drd\theta d\phi
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsubsection
Image Charge To Observation Displacement Vector (
\begin_inset Formula $\vec{r}_{5}$
\end_inset

)
\end_layout

\begin_layout Standard
The Image Charge To Observation Displacement Vector can be calculated as:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\vec{r}_{5}= & \vec{P}_{obs}-\vec{P}_{dq'}\\
\vec{r}_{5}= & z\hat{z}-rsin(\theta)cos(\phi)\hat{x}-rsin(\theta)sin(\phi)\hat{y}-\left(2d-rcos(\theta)\right)\hat{z}\\
\vec{r}_{5}= & -\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
while its magnitude (length):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)cos^{2}(\phi)+r^{2}sin^{2}(\theta)sin^{2}(\phi)+\left(2d-rcos(\theta)-z\right)^{2}}\\
r_{5}= & \sqrt{r^{2}sin^{2}(\theta)\left[cos^{2}(\phi)+sin^{2}(\phi)\right]+\left(2d-rcos(\theta)-z\right)^{2}}\\
r_{5}= & \sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-z\right)^{2}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
and its unit direction:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
\begin{array}{cc}
\hat{r}_{5}= & \frac{\vec{r}_{5}}{r_{5}}\\
\hat{r}_{5}= & -\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}}{\sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-z\right)^{2}}}
\end{array}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection
Final Calculation Of The Plane Image Electric Field (
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{ccc}
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{dq'}{r^{2}_{5}}\hat{r}_{5}\\
d\vec{E}_{I_{plane}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)drd\theta d\phi}{r^{2}_{5}}\left[-\frac{rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}}{r_{5}}\right]\\
d\vec{E}_{I_{plane}}= & -\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{-\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}+\left(2d-rcos(\theta)-z\right)\hat{z}\right]drd\theta d\phi\\
\vec{E}_{I_{plane}}= & \cancelto{0}{\vec{I}_{plane,1}}+\vec{I}_{plane,2}\\
\vec{I}_{plane,1}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left[rsin(\theta)cos(\phi)\hat{x}+rsin(\theta)sin(\phi)\hat{y}\right]drd\theta d\phi=0\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\int^{2\pi}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta d\phi\\
\vec{I}_{plane,2}= & \int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\\
\vec{I}_{plane,2}= & \frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\vec{E}_{I_{plane}}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)\hat{z}drd\theta
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Derivation of Space Charge Amplitude 
\begin_inset Formula $A$
\end_inset


\end_layout

\begin_layout Standard
The axial space charge electric field 
\begin_inset Formula $\vec{E}_{sp}(z)$
\end_inset

 is given by:
 
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}(z)=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}\sin\theta}{r^{3}_{1}}\left[z-r\cos\theta\right]dr\,d\theta\,\hat{z}
\end{equation}

\end_inset

where 
\begin_inset Formula $r_{1}=\sqrt{\left[z-r\cos\theta\right]^{2}+\left[r\sin\theta\right]^{2}}$
\end_inset

 and 
\begin_inset Formula $\rho(r)=\frac{A}{(r+C)^{B}}$
\end_inset

.
\end_layout

\begin_layout Subsubsection*
Volumetric Integration for 
\begin_inset Formula $Q_{cs}$
\end_inset


\end_layout

\begin_layout Standard
Integrating 
\begin_inset Formula $\rho(r)$
\end_inset

 over the conical volume 
\begin_inset Formula $dV=r^{2}\sin\theta\,dr\,d\theta\,d\phi$
\end_inset

:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=\int\int\int\rho(r)\;dv=\int^{2\pi}_{0}d\phi\int^{\frac{\theta_{B}}{2}}_{0}\sin\theta\,d\theta\int^{L_{cs}}_{0}\frac{A}{(r+C)^{B}}r{}^{2}\,dr
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Evaluating the angular terms:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=A\cdot2\pi\left[1-\cos\left(\frac{\theta_{B}}{2}\right)\right]\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Gauss's Law at Streamer Boundary
\end_layout

\begin_layout Standard
Applying Gauss's Law over a closed surface 
\begin_inset Formula $S$
\end_inset

 enclosing the streamer volume:
 
\begin_inset Formula 
\begin{equation}
\oint_{S}\vec{E}\cdot d\vec{A}=\frac{Q_{cs}}{\epsilon_{0}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Assuming the flux is concentrated across the circular head area 
\begin_inset Formula $S_{\text{head}}$
\end_inset

 at axial distance 
\begin_inset Formula $L_{cs}$
\end_inset

 where the field magnitude is uniform (
\begin_inset Formula $\|\vec{E}\|=E_{c}$
\end_inset

):
 
\begin_inset Formula 
\begin{equation}
\iint_{S_{\text{head}}}E_{c}\,dA=E_{c}A_{\text{head}}=\frac{Q_{cs}}{\epsilon_{0}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
From cone trigonometry,
 the head radius is 
\begin_inset Formula $r_{\text{head}}=L_{cs}\tan\left(\frac{\theta_{B}}{2}\right)$
\end_inset

,
 giving the head area:
 
\begin_inset Formula 
\begin{equation}
A_{\text{head}}=\pi r^{2}_{\text{head}}=\pi\left[L_{cs}\tan\left(\frac{\theta_{B}}{2}\right)\right]^{2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Substituting 
\begin_inset Formula $A_{\text{head}}$
\end_inset

 back into Gauss's Law and isolating 
\begin_inset Formula $Q_{cs}$
\end_inset

:
 
\begin_inset Formula 
\begin{equation}
Q_{cs}=\epsilon_{0}E_{c}A_{\text{head}}=\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Equating and Isolating 
\begin_inset Formula $A$
\end_inset


\end_layout

\begin_layout Standard
Equating both expressions for 
\begin_inset Formula $Q_{cs}$
\end_inset

 yields the explicit result:
 
\begin_inset Formula 
\begin{equation}
A(E_{c},B,C,L_{cs},\theta_{B})=\frac{\overbrace{\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)}^{Q_{cs}}}{2\pi\left(1-\cos\left(\frac{\theta_{B}}{2}\right)\right)\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Summarizing
\end_layout

\begin_layout Quote
Space Charge Density Function & Domains:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho(r)=\frac{A}{\left(r+C\right)^{B}}\;\;\left[\frac{C}{m^{3}}\right]\;\;,\;\;\text{Domains:}\begin{cases}
r\in\left[0\;,\;L_{cs}\right]\\
\theta\in\left[0\;,\;\theta_{B}/2\right]\\
\phi\in[0\;,\;2\pi]
\end{cases}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A(\;E_{c}\;,\;B\;,\;C\;,\;L_{cs}\;,\;\theta_{B}\;)=\frac{\overbrace{\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\frac{\theta_{B}}{2}\right)}^{Q_{cs}}}{2\pi\left[1-\cos\left(\frac{\theta_{B}}{2}\right)\right]\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
B,C are choosen such that 
\begin_inset Formula $E_{total}=E_{ext}+E_{sp}+E_{I_{rod}}+E_{I_{plane}}=\text{constant}$
\end_inset

 (uniform),
 
\begin_inset Formula $E_{c}:$
\end_inset

 Average electric field in the streamer region ( typically ~5.0 [kV/cm] ).
\end_layout

\begin_layout Subsubsection*
Space Charge (
\begin_inset Formula $\vec{E}_{sp}$
\end_inset

)
\end_layout

\begin_layout Quote
Space charge attenuation distance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{1}=\sqrt{\left[z-rcos(\theta)\right]{}^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Space charge electric field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{1}}[z-rcos(\theta)]drd\theta\hat{z}\label{eq:final_Esp}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Rod Image (
\begin_inset Formula $\vec{E}_{I_{rod}}$
\end_inset

)
\end_layout

\begin_layout Quote
Distance between space charge & rod center.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+rcos(\theta)\right]^{2}+\left[rsin(\theta)\right]^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Distance of the rod image charge from its center:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{3}=\frac{R^{2}}{r_{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Rod image charge attenuation distance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left(z+R-\frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]\right)^{2}+\left(\frac{r_{3}}{r_{2}}rsin(\theta)\right)^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Rod image electric field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{rod}}=-\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}Rsin(\theta)}{r^{3}_{4}r_{2}}\left[z+R-\frac{r_{3}}{r_{2}}\left(R+rcos(\theta)\right)\right]drd\theta\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Subsubsection*
Plane Image (
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

)
\end_layout

\begin_layout Quote
Plane image charge attenuation distance:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
r_{5}=\sqrt{\left[rsin(\theta)\right]^{2}+\left(2d-rcos(\theta)-z\right)^{2}}
\end{equation}

\end_inset


\end_layout

\begin_layout Quote
Plane image electric field:
\end_layout

\begin_layout Quote
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{plane}}=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}sin(\theta)}{r^{3}_{5}}\left(2d-rcos(\theta)-z\right)drd\theta\hat{z}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Section
Mathematical Equivalence with the Wang–Haiting Formulation
\end_layout

\begin_layout Standard
To validate the analytical formulation developed above,
 we show that it is identical to the space-charge model published by Wang and Haiting [1] (Eqs.
 4 and 5 of [1]).
 While the Wang–Haiting equations use the intermediate angles 
\begin_inset Formula $\theta_{3}$
\end_inset

 and 
\begin_inset Formula $\theta_{4}$
\end_inset

,
 our implementation uses coordinate-based algebraic forms that are better suited to numerical integration.
 This section proves,
 term by term,
 that the two are the same,
 and lists the typographical errors of the original paper that the derivation corrects.
\end_layout

\begin_layout Subsection
Common Coordinate System
\end_layout

\begin_layout Standard
Both formulations use the same coordinate system,
 so no transformation between them is needed:
\end_layout

\begin_layout Itemize
the origin 
\begin_inset Formula $\vec{O}$
\end_inset

 is the apex (tip) of the rod electrode,
 which is also the apex of the space-charge cone;
\end_layout

\begin_layout Itemize
the 
\begin_inset Formula $z$
\end_inset

 axis is the axis of symmetry,
 pointing from the rod towards the grounded plane;
\end_layout

\begin_layout Itemize
the centre of the hemispherical rod tip lies at 
\begin_inset Formula $\vec{C}=-R\hat{z}$
\end_inset

 and the plane at 
\begin_inset Formula $z=d$
\end_inset

,
 where 
\begin_inset Formula $d$
\end_inset

 is the apex-to-plane gap distance.
\end_layout

\begin_layout Standard
The axial coordinate 
\begin_inset Formula $Z$
\end_inset

 of [1] is therefore our 
\begin_inset Formula $z$
\end_inset

,
 and 
\begin_inset Formula $\epsilon=\epsilon_{r}\epsilon_{0}$
\end_inset

.
\end_layout

\begin_layout Subsection
Direct Space-Charge Field
\end_layout

\begin_layout Standard
From 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:final_Esp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 the direct space-charge field on the axis is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{sp}(z)=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{1}}\left[z-r\cos(\theta)\right]dr\,d\theta\,\hat{z},\qquad r_{1}=\sqrt{\left[z-r\cos(\theta)\right]^{2}+\left[r\sin(\theta)\right]^{2}}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Taking the minus sign out of the bracket,
 
\begin_inset Formula $z-r\cos(\theta)=-\left[r\cos(\theta)-z\right]$
\end_inset

,
 and noting that the square in 
\begin_inset Formula $r_{1}$
\end_inset

 does not change,
 gives
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}=-\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{1}}\left[r\cos(\theta)-Z\right]dr\,d\theta,\qquad r_{1}=\sqrt{\left[r\cos(\theta)-Z\right]^{2}+\left[r\sin(\theta)\right]^{2}},
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
which is Eq.
 4 of [1].
\end_layout

\begin_layout Quote

\series bold
Note on a typographical error in [1]:

\series default
 the paper prints the second term of 
\begin_inset Formula $r_{1}$
\end_inset

 as 
\begin_inset Formula $\left[r_{3}\sin(\theta)\right]^{2}$
\end_inset

.
 Since 
\begin_inset Formula $r\sin(\theta)$
\end_inset

 is the distance of the charge element from the axis,
 the correct term is 
\begin_inset Formula $\left[r\sin(\theta)\right]^{2}$
\end_inset

,
 as derived above.
\end_layout

\begin_layout Subsection
Rod Image Field
\end_layout

\begin_layout Standard
From 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Erod_theta3_theta4"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

,
 the rod image field is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{rod}}(z)=-\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{R\,r^{2}\rho(r)\sin(\theta)\cos(\theta_{4})}{r^{2}_{4}\,r_{2}}dr\,d\theta\,\hat{z},
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
whose integrand is the same as in Eq.
 5 of [1].
 It remains to show that the auxiliary quantities are the same.
 The first three are identical by construction,
 because 
\begin_inset Formula $\vec{r}_{2}=\vec{P}_{dq_{sp}}-\vec{C}$
\end_inset

 is measured from the centre of the rod tip in both formulations:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+r\cos(\theta)\right]^{2}+\left[r\sin(\theta)\right]^{2}},\qquad r_{3}=\frac{R^{2}}{r_{2}},\qquad\theta_{3}=\sin^{-1}\left(\frac{r\sin(\theta)}{r_{2}}\right).
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For 
\begin_inset Formula $r_{4}$
\end_inset

,
 the image charge lies at 
\begin_inset Formula $\vec{P}_{dq'}=\vec{C}+r_{3}\hat{r}_{2}$
\end_inset

,
 so its axial distance from the observer is 
\begin_inset Formula $z+R-r_{3}\cos(\theta_{3})$
\end_inset

 and its distance from the axis is 
\begin_inset Formula $r_{3}\sin(\theta_{3})$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left[Z+R-r_{3}\cos(\theta_{3})\right]^{2}+\left[r_{3}\sin(\theta_{3})\right]^{2}},
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
which is the 
\begin_inset Formula $r_{4}$
\end_inset

 of [1].
 The term 
\begin_inset Formula $+R$
\end_inset

 is the distance between the origin (apex) and the centre of the rod tip,
 about which the Kelvin image is constructed.
\end_layout

\begin_layout Quote

\series bold
Note on a typographical error in [1]:

\series default
 the paper prints the second term of 
\begin_inset Formula $r_{4}$
\end_inset

 as 
\begin_inset Formula $\left[r_{3}\sin(\theta)\right]^{2}$
\end_inset

.
 The image lies on the line from 
\begin_inset Formula $\vec{C}$
\end_inset

 to the charge element,
 at angle 
\begin_inset Formula $\theta_{3}$
\end_inset

 from the axis,
 so the correct term is 
\begin_inset Formula $\left[r_{3}\sin(\theta_{3})\right]^{2}$
\end_inset

.
\end_layout

\begin_layout Standard
Finally,
 [1] defines 
\begin_inset Formula $\theta_{4}=\sin^{-1}\left(r_{3}\sin(\theta_{3})/r_{4}\right)$
\end_inset

.
 The inverse sine returns 
\begin_inset Formula $\theta_{4}\in\left[0,\pi/2\right]$
\end_inset

,
 so it always gives 
\begin_inset Formula $\cos(\theta_{4})\ge0$
\end_inset

,
 whereas our derivation gives the signed axial projection
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\cos(\theta_{4})=\frac{\vec{r}_{4}\cdot\hat{z}}{r_{4}}=\frac{z+R-r_{3}\cos(\theta_{3})}{r_{4}}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The two agree because this projection is never negative in the gap.
 Every charge element lies outside the rod,
 so 
\begin_inset Formula $r_{2}\ge R$
\end_inset

 and 
\begin_inset Formula $r_{3}=R^{2}/r_{2}\le R$
\end_inset

:
 the image lies inside the hemisphere.
 Hence,
 for every observation point 
\begin_inset Formula $z\ge0$
\end_inset

,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{3}\cos(\theta_{3})\le r_{3}\le R\le z+R\quad\Rightarrow\quad z+R-r_{3}\cos(\theta_{3})\ge0,
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
and the inverse-sine definition of [1] and our signed projection give the same 
\begin_inset Formula $\cos(\theta_{4})$
\end_inset

.
 The coordinate form of the conclusion of the rod image subsection,
 which evaluates 
\begin_inset Formula $z+R-\frac{r_{3}}{r_{2}}\left[R+r\cos(\theta)\right]$
\end_inset

 directly,
 is therefore identical to Eq.
 5 of [1] without evaluating 
\begin_inset Formula $\theta_{3}$
\end_inset

 or 
\begin_inset Formula $\theta_{4}$
\end_inset

 during the integration.
\end_layout

\begin_layout Subsection
Grounded Plane Image Field and Boundary Approximations
\end_layout

\begin_layout Standard
In long rod-plane gaps (
\begin_inset Formula $d\gg R$
\end_inset

) the ionization and streamer propagation occur near the rod tip.
 Wang and Haiting omit the image of the space charge in the grounded plane (
\begin_inset Formula $\vec{E}_{I_{plane}}\approx0$
\end_inset

),
 so their total field is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{\text{total, WH}}=\vec{E}_{ex}+\vec{E}_{sp}+\vec{E}_{I_{rod}}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Our model keeps 
\begin_inset Formula $\vec{E}_{I_{plane}}$
\end_inset

 to satisfy the boundary condition on the plane over the whole gap.
 Near the rod (
\begin_inset Formula $z\ll d$
\end_inset

) the image charges lie about 
\begin_inset Formula $2d$
\end_inset

 away and 
\begin_inset Formula $\vec{E}_{I_{plane}}\to0$
\end_inset

,
 so the two formulations agree where [1] applies.
\end_layout

