 & \quad\cdot\frac{-\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\hat{x}-\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\hat{y}-\left\{ \frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right\} \hat{z}}{r_{4}}\\
d\vec{E}_{I_{rod}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\frac{\frac{R}{r_{2}}\rho(r)r^{2}sin(\theta)}{r^{3}_{4}}\Big(\frac{r_{3}}{r_{2}}rsin(\theta)cos(\phi)\hat{x}\\
 & \quad+\frac{r_{3}}{r_{2}}rsin(\theta)sin(\phi)\hat{y}+\left\{ \frac{r_{3}}{r_{2}}\left[R+rcos(\theta)\right]-R-z\right\} \hat{z}\Big)d\phi drd\theta
