s=\sqrt{\frac{1}{N}\sum_{i=1}^{N}\left(\frac{E_{total}(z_{i})-E_{c}}{E_{c}}\right)^{2}},\qquad0.1\,L\le z_{i}\le L,\label{eq:app_bc_score}
\end{equation}
