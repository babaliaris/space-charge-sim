\vec{E}_{I_{rod}}= & \frac{1}{4\pi\epsilon_{r}\epsilon_{0}}\cancelto{2\pi}{\int^{2\pi}_{0}d\phi}\;\;\;\;\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\frac{R}{r_{2}}\rho(r)r^{2}sin(\theta)}{r^{3}_{4}}\left[r_{3}\frac{R+rcos(\theta)}{r_{2}}-R-z\right]drd\theta\hat{z}\\
