\begin_layout Subsubsection*
Plane Image Field
\end_layout

\begin_layout Standard
The grounded plane at 
\begin_inset Formula $z=d$
\end_inset

 (measured from the apex 
\begin_inset Formula $\vec{O}$
\end_inset

) does not move either.
 The mirror image of a source element lies at 
\begin_inset Formula $2d-\left[r\cos(\theta)+z_{\text{drift}}(t)\right]$
\end_inset

,
 so it moves by 
\begin_inset Formula $-z_{\text{drift}}$
\end_inset

,
 i.e.
 
\series bold
towards
\series default
 the cloud:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{5}(t)=\sqrt{\left[r\sin(\theta)\right]^{2}+\left(2d-r\cos(\theta)-z_{\text{drift}}(t)-z\right)^{2}},\label{eq:drift_r5}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\vec{E}_{I_{plane}}(z,t)=\frac{1}{2\epsilon_{r}\epsilon_{0}}\int^{\frac{\theta_{B}}{2}}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)r^{2}\sin(\theta)}{r^{3}_{5}(t)}\left(2d-r\cos(\theta)-z_{\text{drift}}(t)-z\right)dr\,d\theta\,\hat{z}\label{eq:drift_E_plane}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Substituting 
\begin_inset Formula $z_{\text{eff}}$
\end_inset

 here would give 
\begin_inset Formula $+z_{\text{drift}}$
\end_inset

 inside the bracket,
 moving the image in the wrong direction.
 In long gaps this field is very small,
 but the formulation must still be consistent.
\end_layout

\begin_layout Standard
\begin_inset CommandInset ref
LatexCommand formatted
reference "fig:drift_plane_image"
plural "false"
caps "true"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 shows the plane image. The element moves towards the plane by 
\begin_inset Formula $z_{d}(t)$
\end_inset
 and its mirror image moves towards the plane by the same amount from the other side, so the gap 
\begin_inset Formula $h=d-r\cos\theta-z_{d}(t)$
\end_inset
 shrinks equally on both sides. Replacing 
\begin_inset Formula $z$
\end_inset
 by 
\begin_inset Formula $z-z_{d}(t)$
\end_inset
 would instead move the image away from the plane, as if the plane moved with the cloud.
\end_layout

