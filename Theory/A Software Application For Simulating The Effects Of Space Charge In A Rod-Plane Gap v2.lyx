\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
Inputs of the model and where they come from.
\begin_inset CommandInset label
LatexCommand label
name "tab:fw_inputs"

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
The geometry and the applied waveform describe the test arrangement. The remaining inputs describe the discharge itself and are 
\series bold
not calculated
\series default
 by the model. In particular, the inception voltage 
\begin_inset Formula $V_{inc}$
\end_inset
 depends on the condition of the air (pressure, temperature and humidity), on the random appearance of a free electron near the tip, and on how fast the voltage rises, so it must be taken from measurements. The same holds for the streamer length 
\begin_inset Formula $L_{cs}$
\end_inset
 and the streamer-region field 
\begin_inset Formula $E_{c}$
\end_inset
, which are observed experimentally, and for the constants 
\begin_inset Formula $B$
\end_inset
, 
\begin_inset Formula $C$
\end_inset
 and 
\begin_inset Formula $\mu^{+}$
\end_inset
. The model calculates everything else: 
\begin_inset Formula $\theta_{B}$
\end_inset
, 
\begin_inset Formula $A$
\end_inset
, the drift and the fields.
\end_layout
\begin_layout Subsection
Applied Voltage and Inception
\end_layout

\begin_layout Standard
The voltage is the double exponential of Section 4.3,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t)=V_{p}\,k\left(e^{-\alpha t}-e^{-\beta t}\right).\label{eq:fw_voltage}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
whose constants 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 are the solution of the non-linear system 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:impulse_vector"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
, built from 
\begin_inset Formula $V_{p}$
\end_inset
, 
\begin_inset Formula $T_{cr}$
\end_inset
 and 
\begin_inset Formula $T_{h}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathbf{F}(\mathbf{x})=\begin{bmatrix}-\alpha\,e^{-\alpha T_{cr}}+\beta\,e^{-\beta T_{cr}}\\k\left(e^{-\alpha T_{cr}}-e^{-\beta T_{cr}}\right)-1\\k\left(e^{-\alpha T_{h}}-e^{-\beta T_{h}}\right)-\frac{1}{2}\end{bmatrix}=\begin{bmatrix}0\\0\\0\end{bmatrix},\qquad\mathbf{x}=\begin{bmatrix}\alpha\\\beta\\k\end{bmatrix}.\label{eq:fw_impulse_system}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
The first corona streamer, and with it the space charge, appears at the instant 
\begin_inset Formula $t_{inc}$
\end_inset
 when the voltage reaches the inception voltage:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t_{inc})=V_{inc}.\label{eq:fw_inception}
\end{equation}
\end_inset


\end_layout

\begin_layout Subsection
Space Charge
\end_layout

\begin_layout Standard
The charge fills a cone with its apex at the rod tip and moves as a rigid body by 
\begin_inset Formula $z_{d}(t)$
\end_inset
 (short for 
\begin_inset Formula $z_{\text{drift}}(t)$
\end_inset
), with 
\begin_inset Formula $z_{d}(t)=0$
\end_inset
 for 
\begin_inset Formula $t\le t_{inc}$
\end_inset
. Its density and integration domains are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\rho(r)=\frac{A}{\left(r+C\right)^{B}},\qquad r\in\left[0,L_{cs}\right],\quad\theta\in\left[0,\theta_{B}/2\right],\quad\phi\in\left[0,2\pi\right],\label{eq:fw_density}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
and its amplitude follows from Gauss's law over the head of the cone:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A=\frac{\pi\epsilon_{0}E_{c}L^{2}_{cs}\tan^{2}\left(\theta_{B}/2\right)}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int^{L_{cs}}_{0}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:fw_amplitude}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
The charge, and therefore 
\begin_inset Formula $A$
\end_inset
 and 
\begin_inset Formula $\theta_{B}$
\end_inset
, stays constant after inception: only its position changes. Later bursts add more clouds of the same form (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:fw_bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
).
\end_layout

\begin_layout Subsection
Field Components at Position z and Time t
\end_layout

\begin_layout Standard

\series bold
Applied field.
\series default
 Linear in the voltage, with 
\begin_inset Formula $e_{ex}(z)$
\end_inset
 the applied field for 
\begin_inset Formula $1\,\text{V}$
\end_inset
 on the rod (Charge Simulation Method):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{ex}(z,t)=V(t)\,e_{ex}(z).\label{eq:fw_applied}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Direct space-charge field.
\series default

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{1}}\left[z-r\cos(\theta)-z_{d}(t)\right]dr\,d\theta,\label{eq:fw_esp}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{1}=\sqrt{\left[z-r\cos(\theta)-z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}}.\label{eq:fw_r1}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $r\cos(\theta)+z_{d}(t)$
\end_inset
 is the axial position of the charge element and 
\begin_inset Formula $r\sin(\theta)$
\end_inset
 its distance from the axis;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{1}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the direct field: from the charge element to the observation point.
\end_layout

\begin_layout Standard

\series bold
Rod image field.
\series default
 The image of each charge element is taken in the fixed hemisphere of the rod tip, centred at 
\begin_inset Formula $z=-R$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{rod}}(z,t)=-\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}R\sin(\theta)}{r^{3}_{4}\,r_{2}}\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]dr\,d\theta,\label{eq:fw_erod}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+r\cos(\theta)+z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}},\qquad r_{3}=\frac{R^{2}}{r_{2}},\label{eq:fw_r2_r3}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]^{2}+\left[\frac{r_{3}}{r_{2}}r\sin(\theta)\right]^{2}}.\label{eq:fw_r4}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{2}$
\end_inset
 is the distance from the 
\series bold
centre of the rod tip
\series default
 (
\begin_inset Formula $z=-R$
\end_inset
) to the charge element;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{3}$
\end_inset
 is the distance from the centre of the rod tip to the 
\series bold
image charge
\series default
, which lies on the same line, inside the hemisphere;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{4}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the rod image field: from the image charge to the observation point;
\end_layout

\begin_layout Itemize

\begin_inset Formula $R/r_{2}$
\end_inset
 is the size of the image charge relative to the charge element (it carries 
\begin_inset Formula $-\frac{R}{r_{2}}dq$
\end_inset
).
\end_layout

\begin_layout Standard

\series bold
Plane image field.
\series default
 The image of each charge element is mirrored in the fixed grounded plane at 
\begin_inset Formula $z=d$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{plane}}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{5}}\left[2d-r\cos(\theta)-z_{d}(t)-z\right]dr\,d\theta,\label{eq:fw_eplane}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{5}=\sqrt{\left[r\sin(\theta)\right]^{2}+\left[2d-r\cos(\theta)-z_{d}(t)-z\right]^{2}}.\label{eq:fw_r5}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $2d-r\cos(\theta)-z_{d}(t)$
\end_inset
 is the axial position of the 
\series bold
plane image charge
\series default
, the mirror image of the charge element in the plane (it carries 
\begin_inset Formula $-dq$
\end_inset
);
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{5}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the plane image field: from the plane image charge to the observation point.
\end_layout

\begin_layout Standard

\series bold
Total field.
\series default

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=E_{ex}(z,t)+E_{sp}(z,t)+E_{I_{rod}}(z,t)+E_{I_{plane}}(z,t).\label{eq:fw_total}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Setting 
\begin_inset Formula $z_{d}=0$
\end_inset
 recovers the static equations of Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:static_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

, and 
\begin_inset Formula $V(t)=\text{constant}$
\end_inset
 recovers the drift under a constant voltage of Section 4.
\end_layout

\begin_layout Subsection
Cone Angle
\end_layout

\begin_layout Standard
The cone angle 
\begin_inset Formula $\theta_{B}$
\end_inset
 is fixed at inception, before any drift, by requiring the total field at the head of the streamer to equal 
\begin_inset Formula $E_{c}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(L_{cs},t_{inc})\big|_{z_{d}=0}=E_{c}.\label{eq:fw_theta_b}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Since 
\begin_inset Formula $A$
\end_inset
 depends on 
\begin_inset Formula $\theta_{B}$
\end_inset
 through 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_amplitude"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
, this is one equation for the single unknown 
\begin_inset Formula $\theta_{B}$
\end_inset
, solved by root finding. It is solved once, for a first streamer of known length (the calibration), and the same 
\begin_inset Formula $\theta_{B}$
\end_inset
 is used for every later burst.
\end_layout

\begin_layout Subsection
Drift
\end_layout

\begin_layout Standard
The reference point of the cloud is the zero of its own field before the drift,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z_{c,0},t_{inc})\big|_{z_{d}=0}=0,\qquad z_{c}(t)=z_{c,0}+z_{d}(t),\label{eq:fw_zc}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
and the cloud moves with the ion velocity at that point, driven by every field except its own:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d}}{dt}=\mu^{+}\left[E_{ex}(z_{c},t)+E_{I_{rod}}(z_{c},t)+E_{I_{plane}}(z_{c},t)\right],\qquad z_{d}(t_{inc})=0.\label{eq:fw_drift}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Because the right-hand side depends on 
\begin_inset Formula $z_{d}$
\end_inset
 through the image fields and on 
\begin_inset Formula $t$
\end_inset
 through 
\begin_inset Formula $V(t)$
\end_inset
, this ordinary differential equation is integrated numerically in time.
\end_layout

\begin_layout Subsection
Successive Bursts
\begin_inset CommandInset label
LatexCommand label
name "sec:fw_bursts"

\end_inset

\end_layout

\begin_layout Standard
The equations above describe one cloud. Every corona burst 
\begin_inset Formula $k$
\end_inset
 (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
) adds a cloud with its own length 
\begin_inset Formula $L_{k}$
\end_inset
, charge 
\begin_inset Formula $Q_{k}$
\end_inset
, amplitude 
\begin_inset Formula $A_{k}$
\end_inset
 and drift 
\begin_inset Formula $z_{d,k}(t)$
\end_inset
, and the common 
\begin_inset Formula $\theta_{B}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
Q_{k}=\pi\epsilon_{0}E_{c}L_{k}^{2}\tan^{2}\left(\theta_{B}/2\right),\qquad A_{k}=\frac{Q_{k}}{2\pi\left[1-\cos\left(\theta_{B}/2\right)\right]\int_{0}^{L_{k}}\frac{r^{2}}{(r+C)^{B}}\,dr}.\label{eq:fw_cloud}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
The field 
\begin_inset Formula $E_{k}=E_{sp,k}+E_{I_{rod},k}+E_{I_{plane},k}$
\end_inset
 of cloud 
\begin_inset Formula $k$
\end_inset
 is given by 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_esp"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 to 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_r5"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 with 
\begin_inset Formula $L_{cs}\to r_{max,k}(\theta,t)$
\end_inset
, 
\begin_inset Formula $A\to A_{k}$
\end_inset
 and 
\begin_inset Formula $z_{d}\to z_{d,k}$
\end_inset
, where the radial limit leaves out the charge absorbed by the plane:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{max,k}(\theta,t)=\min\left[L_{k},\;\frac{d-z_{d,k}(t)}{\cos(\theta)}\right].\label{eq:fw_rmax}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Total field.
\series default
 The applied field plus every cloud created so far, with the history 
\begin_inset Formula $H_{k}$
\end_inset
 of the clouds before burst 
\begin_inset Formula $k$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=V(t)\,e_{ex}(z)+\sum_{k:\,t_{k}\le t}E_{k}(z,t),\qquad H_{k}(z,t)=\sum_{j<k}E_{j}(z,t).\label{eq:fw_total_bursts}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Burst instant.
\series default
 The first instant after the previous burst at which the tip field reaches the inception field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
V(t_{k})\,e_{ex}(0)+H_{k}(0,t_{k})=E_{inc},\qquad E_{inc}=V_{inc}\,e_{ex}(0).\label{eq:fw_burst}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Burst length.
\series default
 The largest root of the head condition, with the older clouds frozen at 
\begin_inset Formula $t_{k}$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
L_{k}=\max\left\{ L\,:\;V(t_{k})\,e_{ex}(L)+E_{k}(L,t_{k})+H_{k}(L,t_{k})=E_{c}\right\} .\label{eq:fw_burst_length}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Drift.
\series default
 Every cloud is driven by every field except its own direct field:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d,k}}{dt}=\mu^{+}\Big[V(t)\,e_{ex}(z_{c,k})+E_{I_{rod},k}(z_{c,k},t)+E_{I_{plane},k}(z_{c,k},t)+\sum_{j\neq k}E_{j}(z_{c,k},t)\Big],\qquad z_{c,k}=z_{c,k,0}+z_{d,k}.\label{eq:fw_burst_drift}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Absorption and end.
\series default
 A cloud is removed when 
\begin_inset Formula $z_{d,k}(t)\ge d$
\end_inset
, and the simulation stops at 
\begin_inset Formula $t=t_{end}$
\end_inset
.
\end_layout

\begin_layout Subsection
Order of the Calculation
\end_layout

\begin_layout Enumerate
Fit 
\begin_inset Formula $\alpha$
\end_inset
, 
\begin_inset Formula $\beta$
\end_inset
 and 
\begin_inset Formula $k$
\end_inset
 to 
\begin_inset Formula $V_{p}$
\end_inset
, 
\begin_inset Formula $T_{cr}$
\end_inset
 and 
\begin_inset Formula $T_{h}$
\end_inset
, and compute 
\begin_inset Formula $e_{ex}(z)$
\end_inset
 once.
\end_layout

\begin_layout Enumerate
Calibrate once, on a first streamer of known 
\begin_inset Formula $V_{inc}$
\end_inset
 and 
\begin_inset Formula $L_{cs}$
\end_inset
: solve 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_theta_b"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 for 
\begin_inset Formula $\theta_{B}$
\end_inset
 and set 
\begin_inset Formula $E_{inc}=V_{inc}\,e_{ex}(0)$
\end_inset
.
\end_layout

\begin_layout Enumerate
Start with no clouds. Integrate 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst_drift"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 for the existing clouds until 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 is met, a cloud is absorbed, or 
\begin_inset Formula $t=t_{end}$
\end_inset
.
\end_layout

\begin_layout Enumerate
At a burst, solve 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_burst_length"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 for 
\begin_inset Formula $L_{k}$
\end_inset
, compute 
\begin_inset Formula $Q_{k}$
\end_inset
 and 
\begin_inset Formula $A_{k}$
\end_inset
 from 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_cloud"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 and 
\begin_inset Formula $z_{c,k,0}$
\end_inset
 from 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_zc"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
, add the cloud and return to step 3.
\end_layout

\begin_layout Enumerate
At every time of interest, evaluate 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:fw_total_bursts"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
 along 
\begin_inset Formula $z$
\end_inset
.
\end_layout

