\begin_layout Subsubsection*
Field Components at Position z and Time t
\end_layout

\begin_layout Standard

\series bold
Applied field.
\series default
 Linear in the voltage, with 
\begin_inset Formula $e_{ex}(z)$
\end_inset
 the applied field for 
\begin_inset Formula $1\,\text{V}$
\end_inset
 on the rod (Charge Simulation Method, Appendix 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:csm"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset
):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{ex}(z,t)=V(t)\,e_{ex}(z).\label{eq:fw_applied}\tag{\ref{eq:applied_field_linear}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard

\series bold
Direct space-charge field.
\series default

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{1}}\left[z-r\cos(\theta)-z_{d}(t)\right]dr\,d\theta,\label{eq:fw_esp}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{1}=\sqrt{\left[z-r\cos(\theta)-z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}}.\label{eq:fw_r1}\tag{\ref{eq:drift_r1}}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $r\cos(\theta)+z_{d}(t)$
\end_inset
 is the axial position of the charge element and 
\begin_inset Formula $r\sin(\theta)$
\end_inset
 its distance from the axis;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{1}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the direct field: from the charge element to the observation point.
\end_layout

\begin_layout Standard

\series bold
Rod image field.
\series default
 The image of each charge element is taken in the fixed hemisphere of the rod tip, centred at 
\begin_inset Formula $z=-R$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{rod}}(z,t)=-\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}R\sin(\theta)}{r^{3}_{4}\,r_{2}}\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]dr\,d\theta,\label{eq:fw_erod}\tag{\ref{eq:drift_E_rod}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{2}=\sqrt{\left[R+r\cos(\theta)+z_{d}(t)\right]^{2}+\left[r\sin(\theta)\right]^{2}},\qquad r_{3}=\frac{R^{2}}{r_{2}},\label{eq:fw_r2_r3}\tag{\ref{eq:drift_r2_r3}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{4}=\sqrt{\left[z+R-\frac{r_{3}}{r_{2}}\left(R+r\cos(\theta)+z_{d}(t)\right)\right]^{2}+\left[\frac{r_{3}}{r_{2}}r\sin(\theta)\right]^{2}}.\label{eq:fw_r4}\tag{\ref{eq:drift_r4}}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{2}$
\end_inset
 is the distance from the 
\series bold
centre of the rod tip
\series default
 (
\begin_inset Formula $z=-R$
\end_inset
) to the charge element;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{3}$
\end_inset
 is the distance from the centre of the rod tip to the 
\series bold
image charge
\series default
, which lies on the same line, inside the hemisphere;
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{4}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the rod image field: from the image charge to the observation point;
\end_layout

\begin_layout Itemize

\begin_inset Formula $R/r_{2}$
\end_inset
 is the size of the image charge relative to the charge element (it carries 
\begin_inset Formula $-\frac{R}{r_{2}}dq$
\end_inset
).
\end_layout

\begin_layout Standard

\series bold
Plane image field.
\series default
 The image of each charge element is mirrored in the fixed grounded plane at 
\begin_inset Formula $z=d$
\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{I_{plane}}(z,t)=\frac{1}{2\epsilon}\int^{\theta_{B}/2}_{0}\int^{L_{cs}}_{0}\frac{\rho(r)\,r^{2}\sin(\theta)}{r^{3}_{5}}\left[2d-r\cos(\theta)-z_{d}(t)-z\right]dr\,d\theta,\label{eq:fw_eplane}\tag{\ref{eq:drift_E_plane}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
r_{5}=\sqrt{\left[r\sin(\theta)\right]^{2}+\left[2d-r\cos(\theta)-z_{d}(t)-z\right]^{2}}.\label{eq:fw_r5}\tag{\ref{eq:drift_r5}}
\end{equation}
\end_inset


\end_layout
\begin_layout Standard
where:
\end_layout

\begin_layout Itemize

\begin_inset Formula $2d-r\cos(\theta)-z_{d}(t)$
\end_inset
 is the axial position of the 
\series bold
plane image charge
\series default
, the mirror image of the charge element in the plane (it carries 
\begin_inset Formula $-dq$
\end_inset
);
\end_layout

\begin_layout Itemize

\begin_inset Formula $r_{5}$
\end_inset
 is the 
\series bold
field distance
\series default
 of the plane image field: from the plane image charge to the observation point.
\end_layout

\begin_layout Standard

\series bold
Total field.
\series default

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{total}(z,t)=E_{ex}(z,t)+E_{sp}(z,t)+E_{I_{rod}}(z,t)+E_{I_{plane}}(z,t).\label{eq:fw_total}\tag{\ref{eq:total_field}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Setting 
\begin_inset Formula $z_{d}=0$
\end_inset
 recovers the static equations of Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:static_summary"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

, and 
\begin_inset Formula $V(t)=\text{constant}$
\end_inset
 recovers the drift under a constant voltage of Section 4.
\end_layout

\begin_layout Subsubsection*
Drift
\end_layout

\begin_layout Standard
The reference point of the cloud is the zero of its own field before the drift,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E_{sp}(z_{c,0},t_{inc})\big|_{z_{d}=0}=0,\qquad z_{c}(t)=z_{c,0}+z_{d}(t),\label{eq:fw_zc}\tag{\ref{eq:zc_def}}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
and the cloud moves with the ion velocity at that point, driven by every field except its own:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{dz_{d}}{dt}=\mu^{+}\left[E_{ex}(z_{c},t)+E_{I_{rod}}(z_{c},t)+E_{I_{plane}}(z_{c},t)\right],\qquad z_{d}(t_{inc})=0.\label{eq:fw_drift}
\end{equation}
\end_inset


\end_layout

\begin_layout Standard
Because the right-hand side depends on 
\begin_inset Formula $z_{d}$
\end_inset
 through the image fields and on 
\begin_inset Formula $t$
\end_inset
 through 
\begin_inset Formula $V(t)$
\end_inset
, this ordinary differential equation is integrated numerically in time.
\end_layout


