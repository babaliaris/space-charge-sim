\begin_layout Subsubsection*

\size scriptsize
Εξωτερική
\size default
 
\size scriptsize
Γκαουσιανή Σφαίρα (
\begin_inset Formula $r=r_{out}\geq R$
\end_inset

):
\end_layout

\begin_layout Standard
\paragraph_spacing onehalf

\size tiny
Η μέθοδος του Gauss προϋποθέτει να 
\series bold
\bar under
γνωρίζουμε εκ των προτέρων
\series default
\bar default
 την 
\series bold
διεύθηνση
\series default
 του Πεδίου και επίσης το μέτρο του να είναι σταθερό,
 δηλαδή 
\begin_inset Formula $\left\Vert \vec{D}\right\Vert ,\left\Vert \vec{E}\right\Vert \in\mathbb{R}\rightarrow\text{σταθερά}$
\end_inset

.
 Στις απλές γεωμετρίες (επίπεδο,
 κύλινδροι,
 σφαίρες) η διεύθυνση του πεδίου 
\series bold
είναι πάντα
\series default
 προς την 
\series bold
\bar under
ακτινική διεύθηνση
\series default
\bar default
,
 έτσι όπως δίνεται μαθηματικά από τις κυλινδρικές ή σφαιρικές συντεταγμένες.
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}\cdot\vec{ds}=Q_{enclosed}
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{D}=\left\Vert \vec{D}\right\Vert \hat{r}_{0}=ε\left\Vert \vec{E}\right\Vert \hat{r}_{0}\Rightarrow\vec{E}=\frac{\left\Vert \vec{D}\right\Vert }{ε}\hat{r}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{ds}=r^{2}sin(\theta)d\theta d\phi\hat{r}_{0}\rightarrow\text{Σφαιρικές Συντεταγμένες, επιφανειακό διάνυσμα}
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
Το 
\begin_inset Formula $Q_{enclosed}$
\end_inset

 είναι το 
\begin_inset Quotes eld
\end_inset

συνολικό αθροιστικό φορτίο που περικλείει η Γκαουσιανή επιφάνεια στην οποία δουλεύουμε
\begin_inset Quotes erd
\end_inset

.
 Εφόσον εδώ δουλεύουμε στην 
\series bold
εξωτερική Γκαουσιανή σφαίρα
\series default
 η οποία περικλείει όλο το φορτίο 
\series bold
+Q
\series default
 της επιφάνειας της σφαίρας ακτίνας 
\series bold
R
\series default
,
 τότε 
\begin_inset Formula $\rightarrow$
\end_inset

 
\begin_inset Formula $Q_{enclosed}=+Q$
\end_inset

.
 Επομένως:
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}\cdot\vec{ds}=Q_{enclosed}\Rightarrow\int_{0}^{2\pi}\int_{0}^{\pi}\left\Vert \vec{D}_{out}\right\Vert \hat{r}_{0}\cdot r^{2}sin(\theta)d\theta d\phi\hat{r}_{0}=Q\xRightarrow[\left\Vert \vec{D}\right\Vert ,r^{2}\in\mathbb{R}]{\hat{r}_{0}\cdot\hat{r}_{0}=1}\left\Vert \vec{D}_{out}\right\Vert r^{2}\int_{0}^{2\pi}d\phi\int_{0}^{\pi}sin(\theta)d\theta=2\pi\left\Vert \vec{D}_{out}\right\Vert r^{2}\cancelto{2}{\left[-cos(\pi)+cos(0)\right]}=Q
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\left\Vert \vec{D}_{out}\right\Vert =\frac{Q}{4\pi r^{2}}\;,\;\begin{cases}
\vec{D}_{out}=\frac{Q}{4\pi r^{2}}\hat{r}_{0} & \left[\frac{C}{m^{2}}\right]\;\;,r\geq R\\
\vec{E}_{out}=\frac{Q}{4\piεr^{2}}\hat{r}_{0} & \left[\frac{V}{m}\right]\;\;\;,r\geq R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
Όπως είδαμε αφού 
\begin_inset Formula $\hat{r}_{0}\cdot\hat{r}_{0}=\cancelto{1}{\left\Vert \hat{r}_{0}\right\Vert \left\Vert \hat{r}_{0}\right\Vert }\cancelto{1}{cos(0)}=1$
\end_inset

,
 η πληροφορία της διεύθηνσης χάνετε,
 και ο Gauss υπολογίζει μόνο το μέτρο!
\end_layout

