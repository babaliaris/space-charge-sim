lim_{\rho\rightarrow a^{+}}\left\Vert φ(\rho)\right\Vert =lim_{\rho\rightarrow a^{+}}\frac{aP_{s}}{ε}ln\left|\frac{P_{\infty}}{\rho}\right|=\frac{aP_{s}}{ε}ln\left|\frac{P_{\infty}}{a}\right|
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula $lim_{\rho\rightarrow a^{-}}\left\Vert φ(\rho)\right\Vert =lim_{\rho\rightarrow a^{+}}\left\Vert φ(\rho)\right\Vert =\frac{aP_{s}}{ε}ln\left|\frac{P_{\infty}}{a}\right|$
\end_inset

,
