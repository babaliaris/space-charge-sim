\begin_layout Subsection
Παράδειγμα Γραμμικής Κατανομής Και Τυχαίου Δοκιμαστικού Φορτίου
\end_layout

\begin_layout Standard
\begin_inset Graphics
	filename Assets/3.elect_and_potential_line_distribution.jpg
	scale 22

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Διάνυσμα Απόστασης:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=\vec{P}-\vec{Q}=(x\hat{x}_{o}+y\hat{y}_{o}+z\hat{z}_{o})-(0\hat{x}_{o}+0\hat{y}_{o}+z'\hat{z}_{o})\Rightarrow\vec{r}=x\hat{x}_{o}+y\hat{y}_{o}+(z-z')\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\left\Vert \vec{r}\right\Vert =\sqrt{x^{2}+y^{2}+(z-z')^{2}}\quad\left[m\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Πυκνότητα Φορτίου:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
P_{L}=\frac{dq}{dL}\Rightarrow dq=P_{L}dL\Rightarrow dq=P_{L}dz',z'\in[L_{1},L_{1}+L]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{0}^{Q}dq=P_{L}\int_{L_{1}}^{L_{1}+L}dz'=P_{L}(L_{1}+L-L_{1})=LP_{L}\Rightarrow P_{L}=\frac{Q}{L}\quad\left[\frac{C}{m}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Δυναμικό:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
dφ=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert }\Rightarrow\int_{0}^{φ}dφ=\int_{L_{1}}^{L_{1}+L}\frac{P_{L}dz'}{4\piε\left(x^{2}+y^{2}+(z-z')^{2}\right)^{1/2}}\Rightarrowφ=\frac{P_{L}}{4\piε}\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{1/2}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
u=z-z'\Rightarrow dz'=-du
\]

\end_inset


\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
R^{2}=x^{2}+y^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
\begin{cases}
u(L_{1})=z-L_{1}\\
u(L_{1}+L)=z-L_{1}-L
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{L}}{4\piε}\int_{z-L_{1}}^{z-L_{1}-L}\frac{-du}{\sqrt{R^{2}+u^{2}}}=\frac{P_{L}}{4\piε}\left[-ln\left|u+\sqrt{u^{2}+R^{2}}\right|\right]_{z-L_{1}}^{z-L_{1}-L}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{L}}{4\piε}\left[-ln\left|(z-L_{1}-L)+\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}\right|+ln\left|(z-L_{1})+\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}\right|\right]
\]

\end_inset


\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
φ=\frac{P_{L}}{4\piε}ln\left|\frac{(z-L_{1})+\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}}{(z-L_{1}-L)+\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}}\right|\quad\left[V\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Ηλεκτροστατικό Πεδίο:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
d\vec{E}=\frac{|dq|}{4\piε\left\Vert \vec{r}\right\Vert ^{3}}\vec{r}\Rightarrow\int_{0}^{\vec{E}}d\vec{E}=\int_{L_{1}}^{L_{1}+L}\frac{P_{L}dz'}{4\piε\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\left(x\hat{x}_{o}+y\hat{y}_{o}+(z-z')\hat{z}_{o}\right)
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{L}}{4\piε}\left[x\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\hat{x}_{o}+y\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\hat{y}_{o}+\int_{L_{1}}^{L_{1}+L}\frac{(z-z')dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\hat{z}_{0}\right]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{L}}{4\piε}\left[\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\left(x\hat{x}_{o}+y\hat{y}_{o}\right)+\int_{L_{1}}^{L_{1}+L}\frac{(z-z')dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\hat{z}_{0}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Λύση Πρώτου Ολοκληρώματος:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u=z-z'\Rightarrow dz'=-du
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
R^{2}=x^{2}+y^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\begin{cases}
u(L_{1})=z-L_{1}\\
u(L_{1}+L)=z-L_{1}-L
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
-\int_{z-L_{1}}^{z-L_{1}-L}\frac{du}{\left(R^{2}+u^{2}\right)^{3/2}}=-\left[\frac{u}{R^{2}\sqrt{u^{2}+R^{2}}}\right]_{z-L_{1}}^{z-L_{1}-L}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}=\frac{L+L_{1}-z}{\left(x^{2}+y^{2}\right)\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}}+\frac{z-L_{1}}{\left(x^{2}+y^{2}\right)\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Λύση Δεύτερου Ολοκληρώματος:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u=z-z'\Rightarrow dz'=-du
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
R^{2}=x^{2}+y^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\begin{cases}
u(L_{1})=z-L_{1}\\
u(L_{1}+L)=z-L_{1}-L
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{L_{1}}^{L_{1}+L}\frac{(z-z')dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
-\int_{z-L_{1}}^{z-L_{1}-L}\frac{udu}{\left(R^{2}+u^{2}\right)^{3/2}}=-\left[\frac{-1}{\sqrt{u^{2}+R^{2}}}\right]_{z-L_{1}}^{z-L_{1}-L}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{L_{1}}^{L_{1}+L}\frac{(z-z')dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}=\frac{1}{\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}}-\frac{1}{\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Τελικό Αποτέλεσμα Ηλεκτροστατικού Πεδίο:
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{E}=\frac{P_{L}}{4\piε}\left[\int_{L_{1}}^{L_{1}+L}\frac{dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\left(x\hat{x}_{o}+y\hat{y}_{o}\right)+\int_{L_{1}}^{L_{1}+L}\frac{(z-z')dz'}{\left(x^{2}+y^{2}+(z-z')^{2}\right)^{3/2}}\hat{z}_{0}\right]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula $\vec{E}=\frac{P_{L}}{4\pi\varepsilon}\left[\left(\frac{L+L_{1}-z}{\left(x^{2}+y^{2}\right)\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}}+\frac{z-L_{1}}{\left(x^{2}+y^{2}\right)\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}}\right)\left(x\hat{x}_{o}+y\hat{y}_{o}\right)+\left(\frac{1}{\sqrt{(z-L_{1}-L)^{2}+x^{2}+y^{2}}}-\frac{1}{\sqrt{(z-L_{1})^{2}+x^{2}+y^{2}}}\right)\hat{z}_{0}\right]$
\end_inset


