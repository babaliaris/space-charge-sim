\end_inset


\end_layout

\begin_layout Subsection
Παράδειγμα Κυλινδρικής Χωρικής Κατανομής
\end_layout

\begin_layout Standard
\begin_inset Graphics
	filename Assets/6.cilinder_space_distribution.jpg
	scale 22

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
Φορτίο 
\series bold
+Q
\series default
 είναι ομοιόμορφα διανεμημένο σε χωρική κυλινδρική κατανομή 
\begin_inset Formula $x^{2}+y^{2}=a^{2}\;,\;z=z'\in[0,L]$
\end_inset

.
 Να βρεθεί το Ηλεκτροστατικό Πεδίο και το Δυναμικό στα σημεία 
\series bold
P(0,0,z)
\series default
 
\begin_inset Formula $\forall z\in\mathbb{R}$
\end_inset

.
\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Διανύσματος Απόστασης:
\end_layout

\begin_layout Standard

\size scriptsize
Αφού 
\series bold
+Q
\series default
,
 το διάνυσμα θα πρέπει να δείχνει από το σημείο A προς το P.
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=\vec{P}-\vec{A}=\left(0\hat{x}_{0}+0\hat{y}_{0}+z\hat{z}_{0}\right)-\left(x\hat{x}_{0}+y\hat{y}_{0}+z'\hat{z}_{0}\right)=-x\hat{x}_{0}+-y\hat{y}_{0}+\left(z-z'\right)\hat{z}_{0}\Rightarrow\vec{r}=-\rho\hat{\rho}_{0}+\left(z-z'\right)\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Πυκνότητας Φορτίου (Κυλινδικές Συντεταγμένες):
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{dq}{dv}=P_{v}\Rightarrow dq=P_{v}\rho d\rho d\phi dz'
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
Q=P_{v}\int_{0}^{L}\int_{0}^{2\pi}\int_{0}^{a}\rho d\rho d\phi dz'=P_{v}\int_{0}^{L}dz'\int_{0}^{2\pi}d\phi\int_{0}^{a}\rho d\rho=2\pi LP_{v}\left[\frac{\rho^{2}}{2}\right]_{0}^{a}=2\pi LP_{v}\frac{a^{2}}{2}\Rightarrow P_{v}=\frac{Q}{\pi a^{2}L}\quad\left[\frac{C}{m^{3}}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Δυναμικού:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
dφ=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert }\Rightarrowφ=\int_{0}^{L}\int_{0}^{2\pi}\int_{0}^{a}\frac{P_{v}\rho d\rho d\phi dz'}{4\piε\sqrt{\rho^{2}+\left(z-z'\right)^{2}}}=\frac{P_{v}}{4\piε}\int_{0}^{2\pi}d\phi\int_{0}^{L}\int_{0}^{a}\frac{\rho d\rho dz'}{\sqrt{\rho^{2}+\left(z-z'\right)^{2}}}=\frac{P_{v}}{4\piε}2\pi\int_{0}^{L}\int_{0}^{a}\frac{\rho d\rho dz'}{\sqrt{\rho^{2}+\left(z-z'\right)^{2}}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{4\piε}2\pi\int_{0}^{L}\left[\sqrt{\rho^{2}+\left(z-z'\right)^{2}}\right]_{0}^{a}dz'=\frac{P_{v}}{4\piε}2\pi\int_{0}^{L}\sqrt{a^{2}+\left(z-z'\right)^{2}}-|z-z'|dz'=\frac{P_{v}}{2ε}\left\{ \int_{0}^{L}\sqrt{a^{2}+\left(z-z'\right)^{2}}dz'-\int_{0}^{L}|z-z'|dz'\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\text{Let}\;u=z-z'\;,\;\frac{du}{dz'}=-1\Rightarrow dz'=-du
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u(0)=z\;,\;u(L)=z-L
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{2ε}\left\{ \int_{z}^{z-L}\sqrt{u^{2}+a^{2}}\left(-du\right)-\int_{z}^{z-L}|u|\left(-du\right)\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{2ε}\left\{ -\left[\frac{u}{2}\sqrt{u^{2}+a^{2}}+\frac{a^{2}}{2}ln\left|u+\sqrt{u^{2}+a^{2}}\right|\right]_{z}^{z-L}+\int_{z}^{z-L}|u|du\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{2ε}\left\{ -\frac{z-L}{2}\sqrt{\left(z-L\right)^{2}+a^{2}}-\frac{a^{2}}{2}ln\left|z-L+\sqrt{\left(z-L\right)^{2}+a^{2}}\right|+\frac{z}{2}\sqrt{z^{2}+a^{2}}+\frac{a^{2}}{2}ln\left|z+\sqrt{z^{2}+a^{2}}\right|+\int_{z}^{z-L}|u|du\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{2ε}\left\{ \frac{L-z}{2}\sqrt{\left(z-L\right)^{2}+a^{2}}+\frac{z}{2}\sqrt{z^{2}+a^{2}}+\frac{a^{2}}{2}ln\left|\frac{z+\sqrt{z^{2}+a^{2}}}{z-L+\sqrt{\left(z-L\right)^{2}+a^{2}}}\right|+\int_{z}^{z-L}|u|du\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\int_{z}^{z-L}|u|du=\left[\frac{u|u|}{2}\right]_{z}^{z-L}=\frac{\left(z-L\right)|z-L|}{2}-\frac{z|z|}{2}=\frac{\left(z-L\right)|z-L|-z|z|}{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{v}}{2ε}\left\{ \frac{L-z}{2}\sqrt{\left(z-L\right)^{2}+a^{2}}+\frac{z}{2}\sqrt{z^{2}+a^{2}}+\frac{a^{2}}{2}ln\left|\frac{z+\sqrt{z^{2}+a^{2}}}{z-L+\sqrt{\left(z-L\right)^{2}+a^{2}}}\right|+\frac{\left(z-L\right)|z-L|-z|z|}{2}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Παράδειγμα Σφαιρικής Επιφανειακής Κατανομής
\end_layout

\begin_layout Standard
\begin_inset Graphics
	filename Assets/7.spherical_surface_distribution.jpg
	scale 20

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
Έστω φορτίο 
\series bold
+Q
\series default
 ομοιόμορφα κατανεμημένο στην επιφάνεια σφαίρας ακτίνας 
\begin_inset Formula $R\in\mathbb{R}\rightarrow$
\end_inset

 σταθερή (δηλαδή σε σφαιρικό φλοιό 
\begin_inset Formula $x^{2}+y^{2}+z^{2}=R^{2}$
\end_inset

,
 
\begin_inset Formula $x,y,z\in[-R,R]$
\end_inset

).
 Να υπολογιστεί το ηλεκτρικό δυναμικό και το ηλεκτρικό πεδίο σε σημείο του άξονα z,
 δηλαδή στα σημεία της μορφής 
\series bold
P(0,0,z)
\series default
 
