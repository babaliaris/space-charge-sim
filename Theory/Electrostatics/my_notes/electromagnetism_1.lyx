\begin_inset Formula $\rightarrow$
\end_inset

 
\series bold
2,

\series default
 ενώ τα 
\begin_inset Formula $\hat{x}_{0}$
\end_inset

 και 
\begin_inset Formula $\hat{y}_{0}$
\end_inset

 θα τα λέμε 
\series bold
παράπλευρες συνιστώσες.
 Ορίζουμε:
\end_layout

\begin_layout Itemize
\begin_inset Formula $s=\pi\rho^{2},\;\text{επιφάνεια βάσης κυλίνδρου}$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $A=lim_{h\rightarrow0}\left(2\pi\rho h\right)=0,\;\text{παράπλευρη επιφάνεια κυλίνδρου}$
\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
Παίρνοντας τον 
\series bold
νόμο του Gauss
\series default
 για κάθε συνιστώσα των 
\begin_inset Formula $\vec{D}_{1},\vec{D}_{2}$
\end_inset

,
 έχουμε
\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}\cdot\vec{ds}=Q_{enclosed}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}_{1}\cdot\hat{n}_{0}\cdot\vec{ds}\cdot\left(-\hat{n}_{0}\right)+\varoiint_{s}\vec{D}_{2}\cdot\hat{n}_{0}\cdot\vec{ds}\cdot\hat{n}_{0}+\varoiint_{s}\vec{D}_{side}\cdot\vec{dA}=sP_{s}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Για την παράπλευρη επιφάνεια ισχύει:
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}_{side}\cdot\vec{dA}=\varoiint_{A}\vec{D}_{1}\cdot\hat{x}_{0}\cdot\vec{dA}\cdot\hat{x}_{0}+\varoiint_{A}\vec{D}_{1}\cdot\hat{y}_{0}\cdot\vec{dA}\cdot\hat{y}_{0}+\varoiint_{A}\vec{D}_{2}\cdot\hat{x}_{0}\cdot\vec{dA}\cdot\hat{x}_{0}+\varoiint_{A}\vec{D}_{2}\cdot\hat{y}_{0}\cdot\vec{dA}\cdot\hat{y}_{0}=0\;\;\text{αφού}\;A\rightarrow0
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Επομένως:
