\begin_layout Subsection
Παράδειγμα Κυκλικής Επιφανειακής Κατανομής
\end_layout

\begin_layout Standard
\begin_inset Graphics
	filename Assets/5.circle_surface_distribution.jpg
	scale 24

\end_inset


\end_layout

\begin_layout Standard

\size tiny
Φορτίο 
\series bold
+Q
\series default
 είναι ομοιόμορφα διανεμημένο στην επιφάνεια του κύκλου 
\begin_inset Formula $x^{2}+y^{2}=a^{2},z=0$
\end_inset

.
 Υπολόγισε το Ηλεκτροστατικό Πεδίο και το Δυναμικό στα σημεία P(0,0,z).
\end_layout

\begin_layout Subsubsection*

\size tiny
Διάνυσμα Απόστασης:
\end_layout

\begin_layout Standard

\size tiny
Αφού το φορτίο είναι θετικό 
\series bold
+Q
\series default
,
 θα πρέπει να 
\begin_inset Quotes eld
\end_inset

σπρώχνει
\begin_inset Quotes erd
\end_inset

 το δοκιμαστικό φορτίο 
\series bold
+q
\series default
 σε οποιοδήποτε τυχαίο σημείο 
\series bold
P(0,0,z)
\series default
.
 Άρα το διάνυσμα πρέπει να 
\begin_inset Quotes eld
\end_inset

δείχνει
\begin_inset Quotes erd
\end_inset

 από τυχαίο 
\series bold
dq
\series default
 (Σημείο 
\series bold
Α
\series default
) προς το σημείο P(0,0,z).
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{r}=\vec{P}-\vec{A}=0\hat{x}_{0}+0\hat{y}_{0}+z\hat{z}_{0}-\rho\hat{\rho}_{0}\Rightarrow\vec{r}=-\rho\hat{\rho}_{0}+z\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\left\Vert \vec{r}\right\Vert =\sqrt{\rho^{2}+z^{2}}\;,\;\hat{\rho}_{0}\bot\hat{z}_{0}\quad[m]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Πυκνότητα Φορτίου (Επιφανειακό):
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
P_{s}=\frac{dq}{ds}\Rightarrow dq=P_{s}ds\Rightarrow dq=P_{s}\rho d\rho d\phi
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\int_{0}^{Q}dq=P_{s}\int_{0}^{2\pi}\int_{0}^{a}\rho d\rho d\phi\Rightarrow Q=P_{s}\int_{0}^{2\pi}d\phi\int_{0}^{a}\rho d\rho=2\pi P_{s}\left[\frac{\rho^{2}}{2}\right]_{0}^{a}=2\pi P_{s}\frac{a^{2}}{2}\Rightarrow P_{s}=\frac{Q}{\pi a^{2}}\quad\left[\frac{C}{m^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Δυναμικό:
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
dφ=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert }\Rightarrowφ=\int_{0}^{2\pi}\int_{0}^{a}\frac{P_{s}\rho d\rho d\phi}{4\piε\sqrt{\rho^{2}+z^{2}}}=\frac{P_{s}}{4\piε}\int_{0}^{2\pi}d\phi\int_{0}^{a}\frac{\rho d\rho}{\sqrt{\rho^{2}+z^{2}}}=2\pi\frac{P_{s}}{4\piε}\left[\sqrt{\rho^{2}+z^{2}}\right]_{0}^{a}\Rightarrowφ=\frac{P_{s}}{2ε}\left[\sqrt{\rho^{2}+z^{2}}-|z|\right]\quad\left[V\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Ηλεκτροστατικό Πεδίο:
\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{dE}=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert ^{3}}\vec{r}\Rightarrow\vec{E}=\int_{0}^{2\pi}\int_{0}^{a}\frac{P_{s}\rho d\rho d\phi}{4\piε\left[\rho^{2}+z^{2}\right]^{3/2}}\left(-\rho\hat{\rho}_{0}+z\hat{z}_{0}\right)=\frac{P_{s}}{4\piε}\left\{ -\int_{0}^{2\pi}\int_{0}^{a}\frac{\rho^{2}d\rho d\phi}{\left[\rho^{2}+z^{2}\right]^{3/2}}\hat{\rho}_{0}+z\int_{0}^{2\pi}\int_{0}^{a}\frac{\rho d\rho d\phi}{\left[\rho^{2}+z^{2}\right]^{3/2}}\hat{z}_{0}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}}{4\piε}\left\{ -\int_{0}^{2\pi}\int_{0}^{a}\frac{\rho^{2}d\rho d\phi}{\left[\rho^{2}+z^{2}\right]^{3/2}}\left(cos(\phi)\hat{x}_{0}+sin(\phi)\hat{y}_{0}\right)+2\pi z\int_{0}^{a}\frac{\rho d\rho}{\left[\rho^{2}+z^{2}\right]^{3/2}}\hat{z}_{0}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}}{4\piε}\left\{ -\int_{0}^{a}\frac{\rho^{2}d\rho}{\left[\rho^{2}+z^{2}\right]^{3/2}}\cancelto{0}{\int_{0}^{2\pi}\left(cos(\phi)\hat{x}_{0}+sin(\phi)\hat{y}_{0}\right)d\phi}+2\pi z\left[\frac{-1}{\sqrt{\rho^{2}+z^{2}}}\right]_{0}^{a}\hat{z}_{0}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{zP_{s}}{2ε}\left[-\frac{1}{\sqrt{a^{2}+z^{2}}}+\frac{1}{|z|}\right]\hat{z}_{0}\quad\left[\frac{V}{m}\right]
\]

\end_inset


\end_layout

