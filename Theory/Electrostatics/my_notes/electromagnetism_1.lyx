\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\text{Spherical Coordinates:}\;\hat{r}_{0}=sin(\theta)cos(\phi)\hat{x}_{0}+sin(\theta)sin(\phi)\hat{y}_{0}+cos(\theta)\hat{z}_{0}\;,\;\theta\in[0,\pi]\;,\;\phi\in[0,2\pi]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=0\hat{x}_{0}+0\hat{y}_{0}+z\hat{z}_{0}-r\hat{r}_{0}\xRightarrow{r=R\in\mathbb{R}}\vec{r}=-R\hat{r}_{0}+z\hat{z}_{0}\;,\;\left\Vert \vec{r}\right\Vert \neq\sqrt{R^{2}+z^{2}}\;,\;\text{αφού}\;\hat{r}_{0}\not\perp\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=-R(sin(\theta)cos(\phi)\hat{x}_{0}+sin(\theta)sin(\phi)\hat{y}_{0}+cos(\theta)\hat{z}_{0})+z\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=-Rsin(\theta)cos(\phi)\hat{x}_{0}-Rsin(\theta)sin(\phi)\hat{y}_{0}+(z-Rcos(\theta))\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\left\Vert \vec{r}\right\Vert =\sqrt{R^{2}sin^{2}(\theta)cos^{2}(\phi)+R^{2}sin^{2}(\theta)sin^{2}(\phi)+(z-Rcos(\theta))^{2}}=\sqrt{R^{2}sin^{2}(\theta)\cancelto{1}{\left[cos^{2}(\phi)+sin^{2}(\phi)\right]}+z^{2}-2zRcos(\theta)+R^{2}cos^{2}(\theta)}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\left\Vert \vec{r}\right\Vert =\sqrt{R^{2}\cancelto{1}{\left[cos^{2}(\theta)+sin^{2}(\theta)\right]}+z^{2}-2zRcos(\theta)}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=-Rsin(\theta)cos(\phi)\hat{x}_{0}-Rsin(\theta)sin(\phi)\hat{y}_{0}+(z-Rcos(\theta))\hat{z}_{0}\;,\;\left\Vert \vec{r}\right\Vert =\sqrt{R^{2}-2zRcos(\theta)+z^{2}}\quad\left[m\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Πυκνότητα Φορτίου (Επιφανειακή - Σφαιρικές Συντεταγμένες):
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{dq}{ds}=P_{s}\Rightarrow dq=P_{s}ds\Rightarrow dq=P_{s}r^{2}sin(\theta)d\theta d\phi\xRightarrow{r=R\in\mathbb{R}}dq=P_{s}R^{2}sin(\theta)d\theta d\phi
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
Q=\int_{0}^{2\pi}\int_{0}^{\pi}P_{s}R^{2}sin(\theta)d\theta d\phi=P_{s}R^{2}\int_{0}^{2\pi}d\phi\int_{0}^{\pi}sin(\theta)d\theta=2\pi P_{s}R^{2}\cancelto{2}{\left[-cos(\pi)+cos(0)\right]}\Rightarrow P_{s}=\frac{Q}{4\pi R^{2}}\quad\left[\frac{C}{m^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Δυναμικού:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
dφ=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert }=\frac{P_{s}R^{2}sin(\theta)d\theta d\phi}{4\piε\sqrt{R^{2}-2zRcos(\theta)+z^{2}}}\Rightarrowφ=\int_{0}^{2\pi}\int_{0}^{\pi}\frac{P_{s}R^{2}sin(\theta)d\theta d\phi}{4\piε\sqrt{R^{2}-2zRcos(\theta)+z^{2}}}=\frac{P_{s}R^{2}}{2ε}\int_{0}^{\pi}\frac{sin(\theta)d\theta}{\sqrt{R^{2}-2zRcos(\theta)+z^{2}}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\text{Let\;}u(\theta)=R^{2}-2zRcos(\theta)+z^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{du(\theta)}{d\theta}=2zRsin(\theta)\Rightarrow d\theta=\frac{du}{2zRsin(\theta)}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u(0)=R^{2}-2zR+z^{2}\Rightarrow u(0)=\left(R-z\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u(\pi)=R^{2}+2zR+z^{2}\Rightarrow u(\pi)=\left(R+z\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{s}R^{2}}{2ε}\int_{u(0)}^{u(\pi)}\frac{sin(\theta)}{\sqrt{u}}\cdot\frac{du}{2zRsin(\theta)}=\frac{P_{s}R^{2}}{4zRε}\int_{u(0)}^{u(\pi)}\frac{du}{\sqrt{u}}=\frac{P_{s}R^{2}}{4zRε}\int_{u(0)}^{u(\pi)}u^{-1/2}du=\frac{P_{s}R^{2}}{4zRε}\left[\frac{u^{-1/2+1}}{-1/2+1}\right]_{u(0)}^{u(\pi)}=\frac{P_{s}R}{2zε}\left[\sqrt{u}\right]_{u(0)}^{u(\pi)}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ=\frac{P_{s}R}{2zε}\left[\sqrt{u(\pi)}-\sqrt{u(0)}\right]=\frac{P_{s}R}{2zε}\left[\sqrt{\left(R+z\right)^{2}}-\sqrt{\left(R-z\right)^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
φ=\frac{P_{s}R}{2zε}\left[|R+z|-|R-z|\right]\quad\left[V\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
φ=\begin{cases}
\frac{P_{s}R}{2zε}\left[R+z-\left(R-z\right)\right] & ,\;\begin{cases}
R+z>0\Rightarrow z>-R\\
R-z>0\Rightarrow z<R
\end{cases}\Rightarrow|z|<R\\
\frac{P_{s}R}{2zε}\left[-R-z-\left(R-z\right)\right] & ,\;z<-R\\
\frac{P_{s}R}{2zε}\left[R+z-\left(z-R\right)\right] & ,\;z>R
\end{cases}\Rightarrow\varphi=\begin{cases}
\frac{\frac{Q}{4\pi R^{2}}R}{2z\varepsilon}2z & ,|z|<R\\
\frac{\frac{Q}{4\pi R^{2}}R}{2z\varepsilon}\cdot(-2R) & ,\;z<-R\\
\frac{\frac{Q}{4\pi R^{2}}R}{2z\varepsilon}2R & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
φ(z)=\begin{cases}
\frac{Q}{4\piεR} & ,|z|<R\\
-\frac{Q}{4\piεz} & ,\;z<-R\\
\frac{Q}{4\piεz} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Ηλεκτρικού Πεδίου (Εύκολος Δρόμος):
\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\begin{cases}
-\nablaφ=-\frac{\partialφ}{\partial z}\hat{z}_{0}=-\frac{\partial}{\partial z}\frac{Q}{4\piεR}=0 & ,\;|z|<R\\
-\nablaφ=-\frac{\partialφ}{\partial z}\hat{z}_{0}=-\frac{\partial}{\partial z}\frac{Q}{4\piεz}\left(-\hat{z}_{0}\right)=-\frac{Q}{4\piεz^{2}}\hat{z}_{0} & ,\;z<-R\\
-\nablaφ=-\frac{\partialφ}{\partial z}\hat{z}_{0}=-\frac{\partial}{\partial z}\frac{Q}{4\piεz}\hat{z}_{0}=\frac{Q}{4\piεz^{2}}\hat{z}_{0} & ,\;z>R
\end{cases}\Rightarrow\vec{E}(z)=\begin{cases}
0 & ,\;|z|<R\\
-\frac{Q}{4\pi\varepsilon z^{2}}\hat{z}_{0} & ,\;z<-R\\
\frac{Q}{4\pi\varepsilon z^{2}}\hat{z}_{0} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Υπολογισμός Ηλεκτρικού Πεδίου (Δύσκολος Δρόμος):
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{dE}=\frac{|dq|}{4\piε\left\Vert \vec{r}\right\Vert ^{3}}\vec{r}=\frac{|P_{s}R^{2}sin(\theta)d\theta d\phi|}{4\piε\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\left(-Rsin(\theta)cos(\phi)\hat{x}_{0}-Rsin(\theta)sin(\phi)\hat{y}_{0}+(z-Rcos(\theta))\hat{z}_{0}\right)
\]

