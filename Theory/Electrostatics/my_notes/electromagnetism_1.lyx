\begin_layout Subsection
Gradient
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla=(\frac{\partial}{\partial x},\frac{\partial}{\partial y},\frac{\partial}{\partial z})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla f=\frac{\partial f}{\partial x}\hat{i}+\frac{\partial f}{\partial y}\hat{j}+\frac{\partial f}{\partial z}\hat{k}
\]

\end_inset


\end_layout

\begin_layout Subsection
Divergence
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla\cdot\vec{A}=\frac{\partial A_{x}}{\partial x}+\frac{\partial A_{y}}{\partial y}+\frac{\partial A_{z}}{\partial z}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla\cdot\vec{A}\in\mathbb{R}
\]

\end_inset


\end_layout

\begin_layout Subsection
Curl
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla\times\vec{A}=\begin{array}{|ccc|}
\hat{i} & \hat{j} & \hat{k}\\
\frac{\partial}{\partial x} & \frac{\partial}{\partial y} & \frac{\partial}{\partial z}\\
A_{x} & A_{y} & A_{z}
\end{array}
\]

\end_inset


\end_layout

\begin_layout Subsection
Key Identities in Vector Calculus
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla\cdot(\nabla\times\vec{A})=0
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla\times(\nabla f)=0
\]

\end_inset


\end_layout

\begin_layout Subsection
Laplacian
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nabla^{2}f=\nabla\cdot\nabla f=\frac{\partial^{2}f}{\partial x^{2}}+\frac{\partial^{2}f}{\partial y^{2}}+\frac{\partial^{2}f}{\partial z^{2}}
\]

\end_inset


\end_layout

\begin_layout Subsection
Gradient Theorem (Fundamental Theorem for Line Integrals)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\int_{C}\nabla f\cdot d\vec{l}=f(end)-f(start)
\]

\end_inset


\end_layout

\begin_layout Subsection
Divergence Theorem (Gauss’s Theorem)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\int_{V}(\nabla\cdot\vec{A})dV=\oint_{\partial V}\vec{A}\cdot d\vec{A}
\]

\end_inset


\end_layout

\begin_layout Subsection
Stokes’ Theorem
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\int_{S}(\nabla\times\vec{A})\cdot d\vec{A}=\oint_{\partial S}\vec{A}\cdot d\vec{l}
\]

\end_inset


\end_layout

\begin_layout Subsection
Polar Coordinates 
\begin_inset Formula $(\rho,\phi)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{l}=d\rho\hat{\rho}+\rho d\phi\hat{\phi}
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Polar to Cartesian
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x=\rho cos(\phi),y=\rho sin(\phi)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Cartesian to Polar
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho=\sqrt{x^{2}+y^{2}},\phi=tan^{-1}(\frac{y}{x})
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Differential Surface
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}=\rho d\rho d\phi
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Cylindrical Coordinates 
\begin_inset Formula $(\rho,\phi,z)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{l}=d\rho\hat{\rho}+\rho d\phi\hat{\phi}+dz\hat{z}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\rho$
\end_inset

:
 radial distance from the z-axis (like radius in polar),
 
\begin_inset Formula $\phi$
\end_inset

:
 azimuthal angle (angle in x-y plane),
 z:
 same as Cartesian z.
\end_layout

\begin_layout Subsubsection
Cylindrical to Cartesian
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x=\rho cos(\phi)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
y=\rho sin(\phi)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
z=z
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Cartesian to Cylindrical
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho=\sqrt{x^{2}+y^{2}},\phi=tan^{-1}(\frac{y}{x}),z=z
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Unit Vectors
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{\rho}=cos(\phi)\hat{i}+sin(\phi)\hat{j}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{\phi}=-sin(\phi)\hat{i}+cos(\phi)\hat{j}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{z}=\hat{k}
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Differential Surface Elements
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{\rho}=\rho d\phi dz\hat{\rho}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{\phi}=d\rho dz\hat{\phi}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{z}=\rho d\rho d\phi\hat{z}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dV=\rho d\rho d\phi dz
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage pagebreak
\end_inset


\end_layout

\begin_layout Subsection
Spherical Coordinates 
\begin_inset Formula $(r,\theta,\phi)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{l}=dr\hat{r}+rd\theta\hat{\theta}+rsin(\theta)d\phi\hat{\phi}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $r$
\end_inset

:
 radial distance from the origin,
 
\begin_inset Formula $0\leq\theta\leq\pi$
\end_inset

:
 polar angle (angle from +z axis),
 
\begin_inset Formula $0\leq\phi\leq2\pi$
\end_inset

:
 azimuthal angle (angle in x-y plane).
\end_layout

\begin_layout Subsubsection
Spherical to Cartesian
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x=rsin(\theta)cos(\phi)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
y=rsin(\theta)sin(\phi)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
z=rcos(\theta)
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Cartesian to Spherical
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
r=\sqrt{x^{2}+y^{2}+z^{2}},\theta=cos^{-1}(\frac{z}{r}),\phi=tan^{-1}(\frac{y}{z})
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Unit Vectors
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{r}=sin(\theta)cos(\phi)\hat{i}+sin(\theta)sin(\phi)\hat{j}+cos(\theta)\hat{k}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{\theta}=cos(\theta)cos(\phi)\hat{i}+cos(\theta)sin(\phi)\hat{j}-sin(\theta)\hat{k}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\hat{\phi}=-sin(\phi)\hat{i}+cos(\phi)\hat{j}
\]

\end_inset


\end_layout

\begin_layout Subsubsection
Differential Surface Elements
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{r}=r^{2}sin(\theta)d\theta d\phi\hat{r}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{\theta}=rsin(\theta)drd\phi\hat{\theta}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\vec{S}_{\phi}=rdrd\theta\hat{\phi}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dV=r^{2}sin(\theta)drd\theta d\phi
\]

\end_inset


\end_layout

