\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\text{Spherical Coordinates:}\;x'\hat{x}_{0}+y'\hat{y}_{0}+z'\hat{z}_{0}=r\hat{r}_{0}\;,\;\hat{r}_{0}\not\perp\hat{z}_{0}
\]

