\size scriptsize
Για 
\begin_inset Formula $r=r_{out}\geq R$
\end_inset

 (Πορτοκαλί Γκαουσιανή Σφαίρα ακτίνας r)
\end_layout

\begin_layout Standard

\size tiny
Σε αυτήν την περίπτωση,
 η Γκαουσιανή (πορτοκαλί) σφαίρα εσωκλείει όλο το φορτίο 
\series bold
+Q
\series default
,
 επομένως:
\end_layout

\begin_layout Subsubsection*

\size tiny
Ηλεκτροστατικό Πεδίο:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}_{out}\cdot\vec{ds}=Q_{enclosed}\Rightarrow\int_{0}^{2\pi}\int_{0}^{\pi}|\vec{D}_{out}|\hat{r}_{0}\cdot r^{2}sin(\theta)d\theta d\phi\hat{r}_{0}=Q\Rightarrow|\vec{D}_{out}|\cdot r^{2}\int_{0}^{2\pi}d\phi\int_{0}^{\pi}sin(\theta)d\theta=|\vec{D}_{out}|\cdot r^{2}\cdot2\pi\cdot2\Rightarrow|\vec{D}_{out}|=\frac{Q}{4\pi r^{2}}\quad\left[\frac{C}{m^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\begin{cases}
\vec{D}_{out}=\frac{Q}{4\pi r^{2}}\hat{r}_{0}\;\left[\frac{C}{m^{2}}\right] & ,\;r\geq R\\
\vec{E}_{out}=\frac{Q}{4\piεr^{2}}\hat{r}_{0}\;\left[\frac{V}{m}\right] & ,\;r\geq R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Ηλεκτροστατικό Δυναμικό:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ_{out}=\int_{p}^{p_{\infty}}\vec{E}_{out}\cdot\vec{dl}=\int_{r}^{\infty}\frac{Q}{4\piεr^{2}}\hat{r}_{0}\cdot dr\hat{r}_{0}=\frac{Q}{4\piε}\int_{r}^{\infty}\frac{1}{r^{2}}dr=\frac{Q}{4\piε}\left[-\frac{1}{r}\right]_{r}^{\infty}=\frac{Q}{4\piεr}\quad\left[V\right],\;r\geq R
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Για 
\begin_inset Formula $r=r_{in}<R$
\end_inset

 (Μπλε-Γαλάζια Γκαουσιανή Σφαίρα ακτίνας r)
\end_layout

\begin_layout Standard

\size tiny
Σε αυτήν την περίπτωση,
 η Γκαουσιανή (Μπλε-Γαλάζια) σφαίρα εσωκλείει συγκεκριμένο φορτίο ανάλογα με την ακτίνα 
\begin_inset Formula $r=r_{in}$
\end_inset

.
 Δηλαδή το φορτίο που εσωκλείει εξαρτάτε από την ακτίνα r της γκαουσιανής σφαίρας.
 Υπολογίζουμε το φορτίο ως εξής:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{dq}{dv}=P_{v}\Rightarrow dq=P_{v}dv\Rightarrow dq=P_{v}r^{2}sin(\theta)drd\theta d\phi\Rightarrow\int_{0}^{Q(r)}dq=\int_{0}^{2\pi}\int_{0}^{\pi}\int_{0}^{r}P_{v}r^{2}sin(\theta)drd\theta d\phi
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
Q(r)=P_{v}\int_{0}^{2\pi}d\phi\int_{0}^{\pi}sin(\theta)d\theta\int_{0}^{r}r^{2}dr=P_{v}\cdot2\pi\cdot2\cdot\frac{r^{3}}{3}\Rightarrow Q(r)=\frac{4}{3}\pi P_{v}r^{3}\quad\left[C\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Το συνολικό φορτίο +Q υπολογίζεται για 
\begin_inset Formula $r=R$
\end_inset

 και λύνουμε ως προς 
\begin_inset Formula $P_{v}$
\end_inset

:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
Q=Q(R)=\frac{4}{3}\pi P_{v}R^{3}\Rightarrow P_{v}=\frac{3Q}{4\pi R^{3}}\quad\left[\frac{C}{m^{3}}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Εφόσον το 
\begin_inset Formula $P_{v}\text{σταθερό}\;\forall r$
\end_inset

,
 μπορούμε να το αντικαταστήσουμε στην σχέση 
\begin_inset Formula $Q(r)$
\end_inset

:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
Q(r)=\frac{4}{3}\pi P_{v}r^{3}=\frac{4}{3}\pi\frac{3Q}{4\pi R^{3}}r^{3}\Rightarrow Q(r)=\frac{Q}{R^{3}}r^{3}\quad\left[C\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Ηλεκτροστατικό Πεδίο:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\varoiint_{s}\vec{D}_{in}\cdot\vec{ds}=Q_{enclosed}\Rightarrow|\vec{D}_{in}|=\frac{Q_{enclosed}}{4\pi r^{2}}=\frac{\frac{Q}{R^{3}}r^{3}}{4\pi r^{2}}\Rightarrow|\vec{D}_{in}|=\frac{Q}{4\pi R^{3}}r\quad\left[\frac{C}{m^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\begin{cases}
\vec{D}_{in}=\frac{Q}{4\pi R^{3}}r\hat{r}_{0}\;\left[\frac{C}{m^{2}}\right] & ,\;r<R\\
\vec{E}_{in}=\frac{Q}{4\piεR^{3}}r\hat{r}_{0}\;\left[\frac{V}{m}\right] & ,\;r<R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size tiny
Ηλεκτροστατικό Δυναμικό:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ_{in}=\int_{p}^{p_{\infty}}\vec{E}\cdot\vec{dl}=\int_{r}^{R}\vec{E}_{in}\cdot dr\hat{r}_{0}+\int_{R}^{\infty}\vec{E}_{out}\cdot dr\hat{r}_{0}=\int_{r}^{R}\frac{Q}{4\piεR^{3}}r\hat{r}_{0}\cdot dr\hat{r}_{0}+\int_{R}^{\infty}\frac{Q}{4\piεr^{2}}\hat{r}_{0}\cdot dr\hat{r}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ_{in}=\frac{Q}{4\piεR^{3}}\int_{r}^{R}rdr+\frac{Q}{4\piε}\int_{R}^{\infty}\frac{1}{r^{2}}dr=\frac{Q}{4\piεR^{3}}\left[\frac{r^{2}}{2}\right]_{r}^{R}+\frac{Q}{4\piε}\left[-\frac{1}{r}\right]_{R}^{\infty}\Rightarrowφ_{in}=\frac{Q}{4\piεR^{3}}\left[\frac{R^{2}}{2}-\frac{r^{2}}{2}\right]+\frac{Q}{4\piεR}\quad\left[V\right]\;r<R
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset VSpace defskip
\end_inset


\end_layout

\begin_layout Subsubsection*
Όλα Μαζί Ως Διακλαδωτές Συναρτήσεις:
\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\[
\vec{D}(r)=\begin{cases}
\frac{Q}{4\pi R^{3}}r\hat{r}_{0} & ,\;0\leq r<R\\
\frac{Q}{4\pi r^{2}}\hat{r}_{0} & ,\;r\geq R
\end{cases}\quad\left[\frac{C}{m^{2}}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\[
\vec{E}(r)=\begin{cases}
\frac{Q}{4\piεR^{3}}r\hat{r}_{0} & ,\;0\leq r<R\\
\frac{Q}{4\piεr^{2}}\hat{r}_{0} & ,\;r\geq R
\end{cases}\quad\left[\frac{V}{m}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double
\begin_inset Formula 
\[
φ(r)=\begin{cases}
\frac{Q}{4\piεR^{3}}\left[\frac{R^{2}}{2}-\frac{r^{2}}{2}\right]+\frac{Q}{4\piεR} & ,\;0\leq r<R\\
\frac{Q}{4\piεr} & ,\;r\geq R
\end{cases}\quad\left[V\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
Συμπέρασμα:
\end_layout

\begin_layout Standard
Όταν έχουμε χωρική κατανομή,
 το Ηλεκτροστατικό Δυναμικό 
\series bold
εξώ αλλά και μέσα
\series default
 στην σφαίρα κατανομής είναι 
\bar under
συνάρτηση του χώρου
\bar default
!
