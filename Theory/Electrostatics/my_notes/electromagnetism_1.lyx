\size scriptsize
Δυναμικό Για
\size default
 
\size scriptsize

\begin_inset Formula $r=r_{out}\geq R$
\end_inset

:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
φ\triangleq\int_{p}^{p_{\infty}}\vec{E}\cdot\vec{dl},\;\vec{dl}=dr\hat{r}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
