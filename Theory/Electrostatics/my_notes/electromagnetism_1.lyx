\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{4\piε}\left\{ -R\int_{0}^{\pi}\frac{sin^{2}(\theta)d\theta}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\cancelto{0}{\int_{0}^{2\pi}\left(cos(\phi)\hat{x}_{0}+sin(\phi)\right)\hat{y}_{0}d\phi}+\int_{0}^{2\pi}\int_{0}^{\pi}\frac{sin(\theta)(z-Rcos(\theta))\cdot d\theta d\phi}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\hat{z}_{0}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{4\piε}\int_{0}^{2\pi}\int_{0}^{\pi}\frac{sin(\theta)(z-Rcos(\theta))\cdot d\theta d\phi}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\hat{z}_{0}=\frac{P_{s}R^{2}}{4\piε}\cancelto{2\pi}{\int_{0}^{2\pi}d\phi}\int_{0}^{\pi}\frac{sin(\theta)(z-Rcos(\theta))\cdot d\theta}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{2ε}\int_{0}^{\pi}\frac{zsin(\theta)-Rcos(\theta)sin(\theta)}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}d\theta\hat{z}_{0}=\frac{P_{s}R^{2}}{2ε}\left\{ z\int_{0}^{\pi}\frac{sin(\theta)d\theta}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}-R\int_{0}^{\pi}\frac{cos(\theta)sin(\theta)\cdot d\theta}{\left[R^{2}-2zRcos(\theta)+z^{2}\right]^{3/2}}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\text{Let\;}u(\theta)=R^{2}-2zRcos(\theta)+z^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
cos(\theta)=\frac{R^{2}+z^{2}-u}{2zR}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{du(\theta)}{d\theta}=2zRsin(\theta)\Rightarrow d\theta=\frac{du}{2zRsin(\theta)}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u(0)=R^{2}-2zR+z^{2}\Rightarrow u(0)=\left(R-z\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
u(\pi)=R^{2}+2zR+z^{2}\Rightarrow u(\pi)=\left(R+z\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{2ε}\left\{ z\int_{u(0)}^{u(\pi)}\frac{sin(\theta)\frac{du}{2zRsin(\theta)}}{u^{3/2}}-R\int_{u(0)}^{u(\pi)}\frac{\frac{R^{2}+z^{2}-u}{2zR}\cdot sin(\theta)\cdot\frac{du}{2zRsin(\theta)}}{u^{3/2}}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{2ε}\left\{ \frac{1}{2R}\int_{u(0)}^{u(\pi)}\frac{1}{u^{3/2}}du-\frac{1}{4z^{2}R}\int_{u(0)}^{u(\pi)}\frac{R^{2}+z^{2}-u}{u^{3/2}}du\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R^{2}}{2ε}\cdot\frac{1}{2R}\left\{ \left[\frac{u^{-3/2+1}}{-3/2+1}\right]_{u(0)}^{u(\pi)}-\frac{1}{2z^{2}}\left[\frac{\left(R^{2}+z^{2}\right)u^{-3/2+1}}{-3/2+1}-\frac{u^{1/2}}{1/2}\right]_{u(0)}^{u(\pi)}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\frac{P_{s}R}{4ε}\left\{ -2\left[\frac{1}{\sqrt{u}}\right]_{u(0)}^{u(\pi)}-\frac{1}{2z^{2}}\left[-2\left(R^{2}+z^{2}\right)\frac{1}{\sqrt{u}}-2\sqrt{u}\right]_{u(0)}^{u(\pi)}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=-\frac{P_{s}R}{2ε}\left\{ \left[\frac{1}{\sqrt{u}}\right]_{u(0)}^{u(\pi)}-\frac{1}{2z^{2}}\left[\left(R^{2}+z^{2}\right)\frac{1}{\sqrt{u}}+\sqrt{u}\right]_{u(0)}^{u(\pi)}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=-\frac{P_{s}R}{2ε}\left\{ \left[\frac{1}{\sqrt{\left(R+z\right)^{2}}}-\frac{1}{\sqrt{\left(R-z\right)^{2}}}\right]-\frac{1}{2z^{2}}\left[\left(R^{2}+z^{2}\right)\frac{1}{\sqrt{\left(R+z\right)^{2}}}+\sqrt{\left(R+z\right)^{2}}-\left(R^{2}+z^{2}\right)\frac{1}{\sqrt{\left(R-z\right)^{2}}}-\sqrt{\left(R-z\right)^{2}}\right]\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=-\frac{P_{s}R}{2ε}\left\{ \frac{1}{\left|R+z\right|}-\frac{1}{\left|R-z\right|}-\frac{R^{2}+z^{2}}{2z^{2}\left|R+z\right|}-\frac{\left|R+z\right|}{2z^{2}}+\frac{R^{2}+z^{2}}{2z^{2}\left|R-z\right|}+\frac{\left|R-z\right|}{2z^{2}}\right\} \hat{z}_{0}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\begin{cases}
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{R+z}-\frac{1}{R-z}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}-\frac{R+z}{2z^{2}}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{R-z}{2z^{2}}\right\} \hat{z}_{0} & ,\;|z|<R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{-R-z}-\frac{1}{R-z}-\frac{R^{2}+z^{2}}{2z^{2}\left(-R-z\right)}-\frac{-R-z}{2z^{2}}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{R-z}{2z^{2}}\right\} \hat{z}_{0} & ,\;z<-R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{R+z}-\frac{1}{z-R}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}-\frac{R+z}{2z^{2}}+\frac{R^{2}+z^{2}}{2z^{2}\left(z-R\right)}+\frac{z-R}{2z^{2}}\right\} \hat{z}_{0} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\begin{cases}
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{R+z}-\frac{1}{R-z}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{R-z-R-z}{2z^{2}}\right\} \hat{z}_{0} & ,\;|z|<R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{-R-z}-\frac{1}{R-z}-\frac{R^{2}+z^{2}}{2z^{2}\left(-R-z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{R-z+R+z}{2z^{2}}\right\} \hat{z}_{0} & ,\;z<-R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{1}{R+z}-\frac{1}{z-R}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(z-R\right)}+\frac{z-R-R-z}{2z^{2}}\right\} \hat{z}_{0} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\begin{cases}
-\frac{P_{s}R}{2ε}\left\{ \frac{2z^{2}}{2z^{2}\left(R+z\right)}-\frac{2z^{2}}{2z^{2}\left(R-z\right)}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}-\frac{1}{z}\right\} \hat{z}_{0} & ,\;|z|<R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{2z^{2}}{2z^{2}\left(-R-z\right)}-\frac{2z^{2}}{2z^{2}\left(R-z\right)}-\frac{R^{2}+z^{2}}{2z^{2}\left(-R-z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{2R}{2z^{2}}\right\} \hat{z}_{0} & ,\;z<-R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{2z^{2}}{2z^{2}\left(R+z\right)}-\frac{2z^{2}}{2z^{2}\left(z-R\right)}-\frac{R^{2}+z^{2}}{2z^{2}\left(R+z\right)}+\frac{R^{2}+z^{2}}{2z^{2}\left(z-R\right)}-\frac{2R}{2z^{2}}\right\} \hat{z}_{0} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
\[
\vec{E}=\begin{cases}
-\frac{P_{s}R}{2ε}\left\{ \frac{2z^{2}-R^{2}-z^{2}}{2z^{2}\left(R+z\right)}+\frac{-2z^{2}+R^{2}+z^{2}}{2z^{2}\left(R-z\right)}-\frac{1}{z}\right\} \hat{z}_{0} & ,\;|z|<R\\
-\frac{P_{s}R}{2ε}\left\{ -\frac{2z^{2}-R^{2}-z^{2}}{2z^{2}\left(R+z\right)}+\frac{-2z^{2}+R^{2}+z^{2}}{2z^{2}\left(R-z\right)}+\frac{R}{z^{2}}\right\} \hat{z}_{0} & ,\;z<-R\\
-\frac{P_{s}R}{2ε}\left\{ \frac{2z^{2}-R^{2}-z^{2}}{2z^{2}\left(R+z\right)}+\frac{-2z^{2}+R^{2}+z^{2}}{2z^{2}\left(z-R\right)}-\frac{R}{z^{2}}\right\} \hat{z}_{0} & ,\;z>R
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size scriptsize
\begin_inset Formula 
