\begin_layout Standard

\size scriptsize
Θετικό φορτίο 
\series bold
+Q
\series default
 είναι ομοιόμορφα κατανεμημένο στην περίμετρο του κύκλου 
\begin_inset Formula $x^{2}+y^{2}=a^{2}\Rightarrow a=\sqrt{x^{2}+y^{2}}$
\end_inset

.
 Υπολόγισε το Δυναμικό και το Ηλεκτρικό πεδίο σε ένα τυχαίο σημείο 
\series bold
P
\series default
(0,0,z).
\end_layout

\begin_layout Subsubsection*

\size scriptsize
Διάνυσμα Απόστασης (Καρτεσιανή Μορφή):
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=\vec{P}-\vec{Q}=\left(0\hat{x}_{o}+0\hat{y}_{o}+z\hat{z}_{o}\right)-\left(x\hat{x}_{o}+y\hat{y}_{o}+0\hat{z}_{o}\right)\Rightarrow\vec{r}=-x\hat{x}_{o}-y\hat{y}_{o}+z\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Διάνυσμα Απόστασης (Κυλινδρική Μορφή):
\end_layout

\begin_layout Standard

\series bold
\size tiny
\bar under
Θυμήσου:

\series default
\bar default
 Σε κυλινδρικές συντεταγμένες εκφράζουμε το 
\series bold
επίπεδο x,y
\series default
 σε πολικές συντεταγμένες (δηλαδή πολικό διάνυσμα 
\begin_inset Formula $\vec{\rho}$
\end_inset

) και την 
\series bold
z
\series default
 διάσταση την αφήνουμε σε καρτεσιανή μορφή.
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{\rho}=x\hat{x}_{o}+y\hat{y}_{o}=\left\Vert \vec{\rho}\right\Vert \hat{\rho}_{o},\left\Vert \vec{\rho}\right\Vert =\sqrt{x^{2}+y^{2}}=a\in\mathbb{R}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\hat{\rho}_{o}=\frac{\vec{\rho}}{\left\Vert \vec{\rho}\right\Vert }=\frac{x}{\sqrt{x^{2}+y^{2}}}\hat{x}_{o}+\frac{y}{\sqrt{x^{2}+y^{2}}}\hat{y}_{o}=\frac{\sqrt{x^{2}+y^{2}}cos(\phi)}{\sqrt{x^{2}+y^{2}}}\hat{x}_{o}+\frac{\sqrt{x^{2}+y^{2}}sin(\phi)}{\sqrt{x^{2}+y^{2}}}\hat{y}_{o}
\]

\end_inset


\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\hat{\rho}_{o}=cos(\phi)\hat{x}_{o}+sin(\phi)\hat{y}_{o}
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
\size scriptsize
και επομένως
\series default
:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\vec{r}=-(x\hat{x}_{o}+y\hat{y}_{o})+z\hat{z}_{o}=-\sqrt{x^{2}+y^{2}}\hat{\rho}_{o}+z\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Standard

\size footnotesize
\begin_inset Formula 
\[
\vec{r}=-a\hat{\rho}_{o}+z\hat{z}_{o},\left\Vert \vec{r}\right\Vert =\sqrt{a^{2}+z^{2}},\hat{\rho}_{o}\bot\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Πυκνότητα Φορτίου (
\begin_inset Formula $\vec{dl}$
\end_inset

 σε κυλινδρικές συντεταγμένες):
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
\frac{dq}{\left\Vert \vec{dl}\right\Vert }=P_{l}\Rightarrow dq=P_{l}\left\Vert \vec{dl}\right\Vert =P_{l}\left\Vert d\rho\hat{\rho}_{o}+\rho d\phi\hat{\phi}_{o}+dz\hat{z}_{o}\right\Vert \Rightarrow dq=P_{l}\sqrt{\left(d\rho\right)^{2}+\left(\rho d\phi\right)^{2}+\left(dz\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard

\size tiny
εφόσον το φορτίο είναι ομοιόμορφα κατανεμημένο
\begin_inset Formula $\rightarrow P_{L}\in\mathbb{R}$
\end_inset

 πάνω στην περίπετρο του κύκλου (Δηλαδή μεταβάλετε μόνο το 
\begin_inset Formula $d\phi$
\end_inset

,
 ενώ 
\begin_inset Formula $d\rho=dz=0$
\end_inset

),
 τότε:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
dq=P_{l}\sqrt{0+\left(\rho d\phi\right)^{2}+0}\xRightarrow{\rho=a\in\mathbb{R}}dq=aP_{l}d\phi\Rightarrow Q=aP_{l}\int_{0}^{2\pi}d\phi\Rightarrow P_{l}=\frac{Q}{2a\pi}\in\mathbb{R}\quad\left[\frac{C}{m}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Δυναμικό:
\end_layout

\begin_layout Standard

\size scriptsize
\begin_inset Formula 
\[
dφ=\frac{dq}{4\piε\left\Vert \vec{r}\right\Vert }\Rightarrowφ=\int_{0}^{2\pi}\frac{aP_{l}d\phi}{4\piε\sqrt{a^{2}+z^{2}}}=\frac{aP_{l}}{4\piε\sqrt{a^{2}+z^{2}}}\int_{0}^{2\pi}d\phi=\frac{2\pi aP_{l}}{4\piε\sqrt{a^{2}+z^{2}}}\Rightarrowφ=\frac{aP_{l}}{2ε\sqrt{a^{2}+z^{2}}}\quad\left[V\right]
\]

\end_inset


\begin_inset Formula 
\[
\vec{dE}=\frac{|dq|}{4\piε\left\Vert \vec{r}\right\Vert ^{3}}\vec{r}\Rightarrow\vec{E}=\int_{0}^{2\pi}\frac{aP_{l}d\phi}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left(-a\hat{\rho}_{o}+z\hat{z}_{o}\right)\Rightarrow\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\int_{0}^{2\pi}-a\hat{\rho}_{o}d\phi+\int_{0}^{2\pi}z\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Ηλεκτροστατικό Πεδίο:
\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{dE}=\frac{|dq|}{4\piε\left\Vert \vec{r}\right\Vert ^{3}}\vec{r}\Rightarrow\vec{E}=\int_{0}^{2\pi}\frac{aP_{l}d\phi}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left(-a\hat{\rho}_{o}+z\hat{z}_{o}\right)\Rightarrow\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left[\int_{0}^{2\pi}-a\hat{\rho}_{o}d\phi+\int_{0}^{2\pi}z\hat{z}_{o}d\phi\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left[-a\int_{0}^{2\pi}\left(cos(\phi)\hat{x}_{o}+sin(\phi)\hat{y}_{o}\right)d\phi+\int_{0}^{2\pi}z\hat{z}_{o}d\phi\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left[-a\int_{0}^{2\pi}cos(\phi)d\phi\hat{x}_{o}-a\int_{0}^{2\pi}sin(\phi)d\phi\hat{y}_{o}+z\int_{0}^{2\pi}d\phi\hat{z}_{o}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left\{ \left[-asin(\phi)\right]_{0}^{2\pi}\hat{x}_{o}+[acos(\phi)]_{0}^{2\pi}\hat{y}_{o}+2\pi z\hat{z}_{o}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left\{ \left[-asin(2\pi)+asin(0)\right]\hat{x}_{o}+\left[acos(2\pi)-acos(0)\right]\hat{y}_{o}+2\pi z\hat{z}_{o}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left\{ \left[0+0\right]\hat{x}_{o}+\left[a-a\right]\hat{y}_{o}+2\pi z\hat{z}_{o}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}\left\{ 0\hat{x}_{o}+0\hat{y}_{o}+2\pi z\hat{z}_{o}\right\} 
\]

\end_inset


\end_layout

\begin_layout Standard
\paragraph_spacing double

\size footnotesize
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{4\piε\left(a^{2}+z^{2}\right)^{3/2}}2\pi z\hat{z}_{o}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*

\size scriptsize
Ηλεκτροστατικό Πεδίο (Τελικό Αποτέλεσμα):
\end_layout

\begin_layout Standard

\size small
\begin_inset Formula 
\[
\vec{E}=\frac{aP_{l}}{2ε\left(a^{2}+z^{2}\right)^{3/2}}z\hat{z}_{o}\quad\left[\frac{V}{m}\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
Τελικό Αποτέλεσμα (Σχόλια):
\end_layout

\begin_layout Standard
Βλέπουμε ότι το ηλεκτροστατικό πεδίο εξαρτάτε μόνο από την διεύθυνση στο 
\begin_inset Formula $\hat{z}_{o}$
\end_inset

.
 
\series bold
\bar under
Ο λόγος είναι
\series default
\bar default
:
 Η συμμετρία του κύκλου με άξονα συμμετρίας τον 
\series bold
Z
\series default
,
 οδηγεί σε απαλειφή των συμμετρικών δυνάμεων στα διάφορα φορτία 
\series bold
dq
\series default
 τα οποία είναι ομοιόμορφα κατανεμημένα στην περίμετρο του κύκλου 
\begin_inset Formula $x^{2}+y^{2}=a^{2}$
\end_inset

,
 επομένως και οι δυναμικές γραμμές του ηλεκτροστατικού πεδίου στο επίπεδο 
\series bold
x,y
\series default
 απαλείφονται.
