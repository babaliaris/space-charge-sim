\[
P_{s}=\frac{Q}{4\pi R^{2}},\;Q>0\Rightarrow P_{s}>0\;,\;sin(\theta)>0,\;\theta\in[0,\pi]
\]

\end_inset


\end_layout

\begin_layout Standard

